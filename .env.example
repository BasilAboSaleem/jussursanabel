## App
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# عنوان الخادم داخل تطبيق Android (Capacitor): محاكي = http://10.0.2.2:PORT، جهاز حقيقي = http://IP_الشبكة:PORT، إنتاج = https://نطاقك
CAPACITOR_SERVER_URL=http://10.0.2.2:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
FORCE_SECURE_COOKIES=false
CDN_BASE_URL=
REDIS_URL=
REDIS_MAXMEMORY_POLICY=noeviction
EMAIL_WORKER_CONCURRENCY=5
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=300000
ALERT_5XX_RATE_THRESHOLD=0.02
ALERT_P95_MS_THRESHOLD=2000
ALERT_MIN_SAMPLES=50
OBSERVABILITY_CHECK_INTERVAL_MS=60000
OBSERVABILITY_ALERTS_ENABLED=true
OBSERVABILITY_WINDOW_MS=300000
LOG_RETENTION_DAYS=14d
LOG_MAX_SIZE=20m
LOG_ZIP_ARCHIVE=true
LOAD_TEST_MODE=false
LOAD_GATE_P95_MS=1200
LOAD_GATE_ERROR_RATE=0.01
LOAD_GATE_STRESS_CONNECTIONS=15
ENABLE_RATE_LIMIT_SELFTEST=false
LOG_LEVEL=info
HOMEPAGE_CASES_LIMIT=8
HOMEPAGE_TESTIMONIALS_LIMIT=12
STORIES_PAGE_LIMIT=60
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEEPALIVE_MS=30000
REDIS_RETRY_BASE_MS=200
REDIS_RETRY_MAX_MS=5000
RATE_LIMIT_REDIS=true
EMAIL_QUEUE_ATTEMPTS=3
EMAIL_QUEUE_BACKOFF_MS=2000
EMAIL_QUEUE_KEEP_COMPLETE=1000
EMAIL_QUEUE_KEEP_FAILED=2000
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
SOCKET_VERBOSE_LOGS=false
SOCKET_REDIS_ADAPTER=true
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=70000
APP_BODY_LIMIT=5mb
# فحص نسخ القصة من الأمثلة: true=مفعّل (افتراضي) | false=معطّل مؤقتاً
# ENABLE_STORY_COPY_CHECK=true
SESSION_SAME_SITE=lax
CSRF_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=25
PAYMENT_RATE_LIMIT_MAX=35
API_RATE_LIMIT_MAX=2000
DISABLE_LOGIN=false
STRICT_ENV_VALIDATION=false

## Database
MONGODB_URI=

## Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_MINUTES=60
SESSION_SECRET=

## Cloudinary (REQUIRED for reliable story videos on mobile)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

## Email (required in production for password reset and receipts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SECURE=false
EMAIL_TLS_REJECT_UNAUTHORIZED=false

## Metrics (production: require IP allowlist and/or basic auth)
METRICS_DISABLED=false
METRICS_ALLOWED_IPS=127.0.0.1
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=

## Stripe
# live | test — أو عيّن STRIPE_SECRET_KEY مباشرة
STRIPE_MODE=live
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd
STRIPE_WEBHOOK_SECRET=
STRIPE_CLI_WEBHOOK_SECRET=

