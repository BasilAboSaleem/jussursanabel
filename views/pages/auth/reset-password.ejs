<%- include('../../partials/header-top') %>

<main class="nm-auth-screen nm-auth-screen--single" aria-label="<%= __('reset_password_title') %>">
    <div class="nm-auth-screen__atmosphere nm-about-hero__atmosphere" aria-hidden="true">
        <span class="nm-about-hero__orb nm-about-hero__orb--1"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--2"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--3"></span>
        <span class="nm-about-hero__grain" style="--x:20%; --d:0s;"></span>
        <span class="nm-about-hero__grain" style="--x:55%; --d:1s;"></span>
        <span class="nm-about-hero__grain" style="--x:84%; --d:0.4s;"></span>
    </div>

    <div class="nm-auth-screen__watermark" aria-hidden="true"><%= __('hero_title') %></div>

    <div class="nm-auth-screen__inner nm-auth-screen__inner--single">
        <section class="nm-auth-screen__panel">
            <div class="nm-auth-card">
                <div class="nm-auth-card__head nm-auth-card__head--mobile">
                    <p class="nm-auth-mobile-brand"><%= __('hero_title') %> · <%= __('hero_tagline') %></p>
                </div>

                <div class="nm-auth-card__head">
                    <h2><%= __('reset_password_title') %></h2>
                    <p><%= __('reset_password_desc') %></p>
                </div>

                <% if (error && error.length > 0) { %>
                    <div class="nm-auth-alert nm-auth-alert--error" role="alert">
                        <i class="fas fa-circle-exclamation"></i> <%= error %>
                    </div>
                <% } %>

                <form action="/auth/reset-password/<%= token %>" method="POST" class="premium-form nm-auth-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">
                        <label class="form-label-luxury" for="reset-password"><%= __('reset_password_new') %></label>
                        <div class="nm-auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="reset-password" name="password" required minlength="6" class="nm-auth-input" placeholder="••••••••" autocomplete="new-password">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label-luxury" for="reset-confirm"><%= __('reset_password_confirm') %></label>
                        <div class="nm-auth-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="reset-confirm" name="confirmPassword" required minlength="6" class="nm-auth-input" placeholder="••••••••" autocomplete="new-password">
                        </div>
                    </div>

                    <button type="submit" class="btn-lux btn-lux-primary nm-auth-submit">
                        <%= __('reset_password_submit') %>
                        <i class="fas fa-check"></i>
                    </button>
                </form>

                <div class="nm-auth-card__foot">
                    <a href="/auth/login"><i class="fas fa-arrow-right"></i> <%= __('forgot_password_back_login') %></a>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="<%= asset('/assets/js/main.js') %>"></script>
</body>
</html>
