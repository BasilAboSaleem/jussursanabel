<%- include('../../partials/header-top') %>

<main class="nm-auth-screen nm-auth-screen--single nm-auth-screen--status" aria-label="<%= __('pending_verification_title') %>">
    <div class="nm-auth-screen__atmosphere nm-about-hero__atmosphere" aria-hidden="true">
        <span class="nm-about-hero__orb nm-about-hero__orb--1"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--2"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--3"></span>
        <span class="nm-about-hero__grain" style="--x:22%; --d:0s;"></span>
        <span class="nm-about-hero__grain" style="--x:58%; --d:1.3s;"></span>
    </div>

    <div class="nm-auth-screen__watermark" aria-hidden="true"><%= __('hero_title') %></div>

    <div class="nm-auth-screen__inner nm-auth-screen__inner--single">
        <section class="nm-auth-screen__panel">
            <div class="nm-auth-card nm-auth-status-card">
                <div class="nm-auth-status-card__icon" aria-hidden="true">
                    <i class="fas fa-user-clock"></i>
                </div>

                <h1 class="nm-auth-status-card__title"><%= __('pending_verification_title') %></h1>
                <p class="nm-auth-status-card__desc"><%= __('pending_verification_desc') %></p>

                <ol class="nm-auth-status-steps">
                    <li class="nm-auth-status-steps__item is-done">
                        <span class="nm-auth-status-steps__num">1</span>
                        <span class="nm-auth-status-steps__text"><%= __('pending_verification_step1') %></span>
                        <i class="fas fa-check"></i>
                    </li>
                    <li class="nm-auth-status-steps__item is-active">
                        <span class="nm-auth-status-steps__num">2</span>
                        <span class="nm-auth-status-steps__text"><%= __('pending_verification_step2') %></span>
                    </li>
                    <li class="nm-auth-status-steps__item">
                        <span class="nm-auth-status-steps__num">3</span>
                        <span class="nm-auth-status-steps__text"><%= __('pending_verification_step3') %></span>
                    </li>
                </ol>

                <div class="nm-auth-status-card__help">
                    <p><%= __('pending_verification_help') %></p>
                    <div class="nm-auth-status-card__actions">
                        <a href="/support/chat" class="btn-lux btn-lux-primary">
                            <i class="fas fa-headset"></i> <%= __('pending_verification_support') %>
                        </a>
                        <a href="/" class="btn-lux btn-lux-outline">
                            <%= __('pending_verification_home') %>
                        </a>
                    </div>
                    <p class="nm-auth-status-card__hint">
                        <i class="fas fa-arrow-down"></i> <%= __('pending_verification_chat_hint') %>
                    </p>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="<%= asset('/assets/js/main.js') %>"></script>
</body>
</html>
