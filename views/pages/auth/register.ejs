<%- include('../../partials/header-top') %>

<main class="nm-auth-screen nm-auth-screen--register" aria-label="<%= __('register_title') %>">
    <div class="nm-auth-screen__atmosphere nm-about-hero__atmosphere" aria-hidden="true">
        <span class="nm-about-hero__orb nm-about-hero__orb--1"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--2"></span>
        <span class="nm-about-hero__orb nm-about-hero__orb--3"></span>
        <span class="nm-about-hero__grain" style="--x:14%; --d:0s;"></span>
        <span class="nm-about-hero__grain" style="--x:48%; --d:1.4s;"></span>
        <span class="nm-about-hero__grain" style="--x:76%; --d:0.6s;"></span>
    </div>

    <div class="nm-auth-screen__watermark" aria-hidden="true"><%= __('hero_title') %></div>

    <div class="nm-auth-screen__inner nm-auth-screen__inner--register">
        <%- include('../../partials/nm-auth-brand-aside', { emblemPrefix: 'nmRegister' }) %>

        <section class="nm-auth-screen__panel">
            <div class="nm-register-card">
                <div class="nm-register-progress" aria-hidden="true">
                    <div id="progress-bar" class="nm-register-progress__bar"></div>
                </div>

                <div class="nm-auth-card__head nm-auth-card__head--mobile">
                    <p class="nm-auth-mobile-brand"><%= __('hero_title') %> · <%= __('register_subtitle') %></p>
                </div>

                <div class="nm-register-body" id="register-scroll">
                    <form action="/auth/register" method="POST" id="registration-form" class="premium-form nm-register-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="role" id="selected-role" value="donor">

                        <!-- STEP 1 -->
                        <div id="step-1" class="onboarding-step active">
                            <div class="nm-register-step-head">
                                <span class="nm-register-step-badge"><%= __('register_step_1_of_3') %></span>
                                <h2><%= __('register_step1_title') %></h2>
                                <p id="typewriter-text"><%= __('register_step1_intro') %></p>
                            </div>

                            <div class="nm-register-role-grid">
                                <div class="nm-register-role-card active" onclick="selectRole('donor')" id="card-donor" role="button" tabindex="0">
                                    <div class="nm-register-role-card__icon"><i class="fas fa-hand-holding-heart"></i></div>
                                    <h4><%= __('register_role_donor_title') %></h4>
                                    <p><%= __('register_role_donor_desc') %></p>
                                </div>
                                <div class="nm-register-role-card" onclick="selectRole('beneficiary')" id="card-beneficiary" role="button" tabindex="0">
                                    <div class="nm-register-role-card__icon"><i class="fas fa-house-user"></i></div>
                                    <h4><%= __('register_role_beneficiary_title') %></h4>
                                    <p><%= __('register_role_beneficiary_desc') %></p>
                                </div>
                            </div>

                            <button type="button" onclick="nextStep(2)" class="btn-lux btn-lux-primary nm-register-continue">
                                <%= __('register_continue') %>
                                <i class="fas fa-arrow-left"></i>
                            </button>
                        </div>

                        <!-- STEP 2 -->
                        <div id="step-2" class="onboarding-step" style="display: none;">
                            <div class="nm-register-step-head">
                                <button type="button" onclick="nextStep(1)" class="nm-register-back">
                                    <i class="fas fa-chevron-right"></i> <%= __('register_back') %>
                                </button>
                                <span class="nm-register-step-badge"><%= __('register_step_2_of_3') %></span>
                                <h2><%= __('register_step2_title') %></h2>
                                <p><%= __('register_step2_desc') %></p>
                            </div>

                            <div class="form-group">
                                <label class="form-label-luxury" for="reg-name"><%= __('register_full_name_label') %></label>
                                <input type="text" name="name" id="reg-name" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_full_name_placeholder') %>" required>
                                <div class="nm-register-field-error" id="error-name"></div>
                            </div>

                            <div class="form-group">
                                <label class="form-label-luxury" for="reg-email"><%= __('register_email_label') %></label>
                                <input type="email" name="email" id="reg-email" class="nm-auth-input nm-auth-input--plain" placeholder="yourname@example.com" required>
                                <div class="nm-register-field-error" id="error-email"></div>
                            </div>

                            <div class="form-group" id="phone-group">
                                <label class="form-label-luxury" for="reg-phone"><%= __('register_phone_label') %></label>
                                <input type="text" name="phone" id="reg-phone" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_phone_placeholder') %>">
                                <div class="nm-register-field-error" id="error-phone"></div>
                            </div>

                            <div id="donor-only-fields" style="display: none;">
                                <div class="form-group">
                                    <label class="form-label-luxury" for="reg-whatsapp"><%= __('register_whatsapp') %></label>
                                    <input type="text" name="whatsapp" id="reg-whatsapp" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_phone_placeholder') %>">
                                    <div class="nm-register-field-error" id="error-whatsapp"></div>
                                </div>
                            </div>

                            <div id="beneficiary-fields" style="display: none;">
                                <div class="form-group">
                                    <label class="form-label-luxury" for="reg-idNumber"><%= __('register_id_label') %></label>
                                    <input type="text" name="idNumber" id="reg-idNumber" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_id_placeholder') %>" inputmode="numeric" maxlength="9">
                                    <div class="nm-register-field-error" id="error-idNumber"></div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label-luxury" for="reg-address"><%= __('common_address') %></label>
                                    <input type="text" name="address" id="reg-address" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_address_placeholder') %>">
                                    <div class="nm-register-field-error" id="error-address"></div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label-luxury" for="reg-altPhone"><%= __('register_alt_phone') %></label>
                                    <input type="text" name="altPhone" id="reg-altPhone" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_phone_placeholder') %>">
                                    <div class="nm-register-field-error" id="error-altPhone"></div>
                                </div>

                                <div class="nm-register-bank-box">
                                    <h4>
                                        <i class="fas fa-university"></i> <%= __('register_bank_section_title') %>
                                        <small><%= __('register_financial_bank_only_hint') %></small>
                                    </h4>

                                    <div class="form-group">
                                        <label class="form-label-luxury" for="reg-accountHolder"><%= __('register_account_holder') %></label>
                                        <input type="text" name="paymentDetails[accountHolder]" id="reg-accountHolder" class="nm-auth-input nm-auth-input--plain" placeholder="<%= __('register_account_holder_placeholder') %>">
                                        <div class="nm-register-field-error" id="error-accountHolder"></div>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label-luxury" for="reg-iban"><%= __('register_bank_palestine_iban') %> <span style="color: #fca5a5;">*</span></label>
                                        <input type="text" name="paymentDetails[iban]" id="reg-iban" class="nm-auth-input nm-auth-input--plain" placeholder="PS00 PALA 0000 0000 0000 0000 00000">
                                        <div class="nm-register-field-error" id="error-iban"></div>
                                    </div>
                                    <div class="nm-register-field-error" id="error-financial" style="text-align: center;"></div>
                                </div>
                            </div>

                            <button type="button" onclick="nextStep(3)" class="btn-lux btn-lux-primary nm-register-continue">
                                <%= __('register_continue_security') %>
                                <i class="fas fa-shield-alt"></i>
                            </button>
                        </div>

                        <!-- STEP 3 -->
                        <div id="step-3" class="onboarding-step" style="display: none;">
                            <div class="nm-register-step-head">
                                <button type="button" onclick="nextStep(2)" class="nm-register-back">
                                    <i class="fas fa-chevron-right"></i> <%= __('register_back') %>
                                </button>
                                <span class="nm-register-step-badge"><%= __('register_step_3_of_3') %></span>
                                <h2><%= __('register_step3_title') %></h2>
                                <p><%= __('register_step3_desc') %></p>
                            </div>

                            <div class="form-group">
                                <label class="form-label-luxury" for="reg-password"><%= __('register_password_label') %></label>
                                <input type="password" name="password" id="reg-password" class="nm-auth-input nm-auth-input--plain" placeholder="••••••••" required>
                                <div class="nm-register-field-error" id="error-password"></div>
                            </div>

                            <div class="form-group">
                                <label class="form-label-luxury" for="reg-confirmPassword"><%= __('register_confirm_password_label') %></label>
                                <input type="password" name="confirmPassword" id="reg-confirmPassword" class="nm-auth-input nm-auth-input--plain" placeholder="••••••••" required>
                                <div class="nm-register-field-error" id="error-confirmPassword"></div>
                            </div>

                            <div id="beneficiary-contract-section" class="nm-register-contract" style="display: none;">
                                <h3><%= __('register_beneficiary_contract_title') %></h3>
                                <div class="nm-register-contract__scroll" dir="<%= locals.langDir || 'rtl' %>">
                                    <p><%= __('register_beneficiary_contract_body') %></p>
                                </div>
                                <label class="nm-register-contract__check" dir="<%= locals.langDir || 'rtl' %>">
                                    <input type="checkbox" name="beneficiaryTermsAccepted" id="beneficiary-terms-checkbox" value="accepted">
                                    <span><%= __('register_beneficiary_contract_checkbox') %></span>
                                </label>
                                <div class="nm-register-field-error" id="error-beneficiary-terms"></div>
                            </div>

                            <button type="submit" class="btn-lux btn-lux-primary nm-register-submit">
                                <%= __('register_submit') %>
                                <i class="fas fa-check-circle"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="nm-register-foot">
                    <%= __('register_have_account') %>
                    <a href="/auth/login"><%= __('login') %></a>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    const PS_IBAN_LENGTH = 29;
    const PS_IBAN_REGEX = /^PS\d{2}[A-Z]{4}[A-Z0-9]{21}$/;
    const I18N = {
        donorTypewriter: '<%= __('register_role_donor_typewriter') %>',
        beneficiaryTypewriter: '<%= __('register_role_beneficiary_typewriter') %>',
        introTypewriter: '<%= __('register_step1_intro') %>',
        incompleteTitle: '<%= __('register_validation_incomplete_title') %>',
        incompleteText: '<%= __('register_validation_incomplete_text') %>',
        errorsTitle: '<%= __('register_validation_errors_title') %>',
        errorsText: '<%= __('register_validation_errors_text') %>',
        fixText: '<%= __('register_validation_fix_text') %>',
        ok: '<%= __('register_ok') %>',
        financialTitle: '<%= __('register_financial_incomplete_title') %>',
        approvalTitle: '<%= __('register_approval_required_title') %>'
    };

    function normalizeIbanValue(iban) {
        return (iban || '').replace(/\s+/g, '').toUpperCase();
    }

    function ibanMod97Check(iban) {
        const rearranged = iban.slice(4) + iban.slice(0, 4);
        let remainder = 0;

        for (let i = 0; i < rearranged.length; i++) {
            const code = rearranged.charCodeAt(i);
            const chunk = code >= 65 && code <= 90 ? String(code - 55) : rearranged[i];
            for (let j = 0; j < chunk.length; j++) {
                remainder = (remainder * 10 + parseInt(chunk[j], 10)) % 97;
            }
        }

        return remainder === 1;
    }

    function validatePalestinianIbanClient(iban) {
        const normalized = normalizeIbanValue(iban);

        if (!normalized) {
            return { valid: false, message: '<%= __('register_bank_iban_required') %>' };
        }
        if (normalized.length !== PS_IBAN_LENGTH || !PS_IBAN_REGEX.test(normalized)) {
            return { valid: false, message: '<%= __('register_iban_invalid_format') %>' };
        }
        if (!ibanMod97Check(normalized)) {
            return { valid: false, message: '<%= __('register_iban_invalid_checksum') %>' };
        }
        return { valid: true, iban: normalized };
    }

    function validatePalestinianIdClient(id) {
        const digitsOnly = (id || '').replace(/\D/g, '');

        if (!digitsOnly) {
            return { valid: false, message: '<%= __('flash_id_required') %>' };
        }
        if (digitsOnly.length > 9) {
            return { valid: false, message: '<%= __('register_id_length_error') %>' };
        }

        const normalized = digitsOnly.padStart(9, '0');
        let sum = 0;

        for (let i = 0; i < 9; i++) {
            const digit = parseInt(normalized[8 - i], 10);
            const weight = i % 2 === 0 ? 1 : 2;
            let product = digit * weight;
            if (product >= 10) {
                product = Math.floor(product / 10) + (product % 10);
            }
            sum += product;
        }

        if (sum % 10 !== 0) {
            return { valid: false, message: '<%= __('register_id_invalid_checksum') %>' };
        }

        return { valid: true, idNumber: normalized };
    }

    function scrollRegisterTop() {
        const el = document.getElementById('register-scroll');
        if (el) el.scrollTop = 0;
    }

    function nextStep(step) {
        if (step === 3) {
            const name = document.getElementById('reg-name').value.trim();
            const email = document.getElementById('reg-email').value.trim();
            if (!name || !email) {
                Swal.fire({ icon: 'error', title: I18N.incompleteTitle, text: I18N.incompleteText });
                return;
            }
            if (document.querySelectorAll('#step-2 .invalid').length > 0) {
                Swal.fire({ icon: 'error', title: I18N.errorsTitle, text: I18N.errorsText });
                return;
            }
        }
        const next = Number(step);
        document.querySelectorAll('.onboarding-step').forEach(s => s.style.display = 'none');
        document.getElementById('step-' + next).style.display = 'block';
        const progress = (next / 3) * 100;
        document.getElementById('progress-bar').style.width = progress + '%';
        scrollRegisterTop();
    }

    function selectRole(role, opts) {
        opts = opts || {};
        document.getElementById('selected-role').value = role;
        document.getElementById('card-donor').classList.remove('active');
        document.getElementById('card-beneficiary').classList.remove('active');
        document.getElementById('card-' + role).classList.add('active');
        if (!opts.skipTypewriter) {
            const text = role === 'donor' ? I18N.donorTypewriter : I18N.beneficiaryTypewriter;
            startTypewriter(text);
        }

        const bFields = document.getElementById('beneficiary-fields');
        const dFields = document.getElementById('donor-only-fields');
        const phoneGrp = document.getElementById('phone-group');
        const idInput = document.getElementById('reg-idNumber');
        const phoneInput = document.getElementById('reg-phone');
        const addrInput = document.getElementById('reg-address');
        const contractSec = document.getElementById('beneficiary-contract-section');
        const termsCb = document.getElementById('beneficiary-terms-checkbox');
        const termsErr = document.getElementById('error-beneficiary-terms');

        if (role === 'beneficiary') {
            bFields.style.display = 'block';
            dFields.style.display = 'none';
            phoneGrp.style.display = 'block';
            phoneInput.setAttribute('required', 'true');
            idInput.setAttribute('required', 'true');
            if (addrInput) addrInput.setAttribute('required', 'true');
            if (contractSec) contractSec.style.display = 'block';
        } else {
            bFields.style.display = 'none';
            dFields.style.display = 'block';
            phoneGrp.style.display = 'none';
            phoneInput.removeAttribute('required');
            idInput.removeAttribute('required');
            if (addrInput) addrInput.removeAttribute('required');
            if (contractSec) contractSec.style.display = 'none';
            if (termsCb) termsCb.checked = false;
            if (termsErr) termsErr.innerText = '';
        }
    }

    let i = 0;
    let timer;
    function startTypewriter(text) {
        const speed = 40;
        const target = document.getElementById('typewriter-text');
        if (!target) return;
        target.innerHTML = '';
        i = 0;
        if (timer) clearInterval(timer);
        timer = setInterval(() => {
            if (i < text.length) {
                target.innerHTML += text.charAt(i);
                i++;
            } else {
                clearInterval(timer);
            }
        }, speed);
    }

    window.onload = () => {
        selectRole('donor', { skipTypewriter: true });
        startTypewriter(I18N.introTypewriter);
        setupValidation();
    };

    function setupValidation() {
        const msgIdTaken = `<%= __('flash_id_registered') %>`;
        const fields = [
            { id: 'reg-email', field: 'email', msg: '<%= __('register_email_taken') %>' },
            { id: 'reg-phone', field: 'phone', msg: '<%= __('register_phone_taken') %>' },
            { id: 'reg-idNumber', field: 'idNumber', msg: msgIdTaken },
            { id: 'reg-whatsapp', field: 'whatsapp', msg: '<%= __('register_whatsapp_taken') %>' },
            { id: 'reg-iban', field: 'iban', msg: `<%= __('flash_iban_taken') %>` }
        ];

        fields.forEach(f => {
            const el = document.getElementById(f.id);
            if (!el) return;
            el.addEventListener('blur', async () => {
                const val = el.value.trim();
                if (!val) return;

                if (f.field === 'idNumber') {
                    const idCheck = validatePalestinianIdClient(val);
                    if (!idCheck.valid) {
                        showError(f.id, idCheck.message);
                        return;
                    }

                    try {
                        const res = await fetch(`/auth/check-exists?field=idNumber&value=${encodeURIComponent(idCheck.idNumber)}`);
                        const data = await res.json();
                        if (data.invalid) {
                            showError(f.id, data.message);
                        } else if (data.exists) {
                            showError(f.id, f.msg);
                        } else {
                            clearError(f.id);
                        }
                    } catch (e) { console.error(e); }
                    return;
                }

                if (f.field === 'iban') {
                    const ibanCheck = validatePalestinianIbanClient(val);
                    if (!ibanCheck.valid) {
                        showError(f.id, ibanCheck.message);
                        return;
                    }

                    try {
                        const res = await fetch(`/auth/check-exists?field=iban&value=${encodeURIComponent(ibanCheck.iban)}`);
                        const data = await res.json();
                        if (data.invalid) {
                            showError(f.id, data.message);
                        } else if (data.exists) {
                            showError(f.id, f.msg);
                        } else {
                            clearError(f.id);
                        }
                    } catch (e) { console.error(e); }
                    return;
                }

                try {
                    const res = await fetch(`/auth/check-exists?field=${f.field}&value=${val}`);
                    const data = await res.json();
                    if (data.exists) {
                        showError(f.id, f.msg);
                    } else {
                        clearError(f.id);
                    }
                } catch (e) { console.error(e); }
            });
        });

        const passEl = document.getElementById('reg-password');
        const confirmEl = document.getElementById('reg-confirmPassword');
        const passRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{7,}$/;

        passEl.addEventListener('input', () => {
            if (!passRegex.test(passEl.value)) {
                showError('reg-password', '<%= __('register_password_rules') %>');
            } else {
                clearError('reg-password');
            }
        });

        confirmEl.addEventListener('input', () => {
            if (confirmEl.value !== passEl.value) {
                showError('reg-confirmPassword', '<%= __('register_password_mismatch') %>');
            } else {
                clearError('reg-confirmPassword');
            }
        });

        const accountHolderEl = document.getElementById('reg-accountHolder');
        const nameEl = document.getElementById('reg-name');
        if (accountHolderEl && nameEl) {
            const validateAccountHolder = () => {
                const holder = accountHolderEl.value.trim();
                const fullName = nameEl.value.trim();
                if (!holder || !fullName) return;
                if (holder.replace(/\s+/g, ' ').toLowerCase() !== fullName.replace(/\s+/g, ' ').toLowerCase()) {
                    showError('reg-accountHolder', '<%= __('register_account_holder_mismatch') %>');
                } else {
                    clearError('reg-accountHolder');
                }
            };
            accountHolderEl.addEventListener('blur', validateAccountHolder);
            nameEl.addEventListener('blur', validateAccountHolder);
        }

        const termsCb = document.getElementById('beneficiary-terms-checkbox');
        if (termsCb) {
            termsCb.addEventListener('change', () => {
                if (termsCb.checked) {
                    const err = document.getElementById('error-beneficiary-terms');
                    if (err) err.innerText = '';
                }
            });
        }
    }

    function showError(id, msg) {
        const el = document.getElementById(id);
        const errEl = document.getElementById('error-' + id.replace('reg-', ''));
        el.classList.add('invalid');
        errEl.innerText = msg;
    }

    function clearError(id) {
        const el = document.getElementById(id);
        const errEl = document.getElementById('error-' + id.replace('reg-', ''));
        el.classList.remove('invalid');
        errEl.innerText = '';
    }

    document.getElementById('registration-form').onsubmit = function(e) {
        const role = document.getElementById('selected-role').value;
        const phone = document.getElementById('reg-phone').value.trim();
        const altPhone = document.getElementById('reg-altPhone').value.trim();
        const whatsapp = document.getElementById('reg-whatsapp').value.trim();
        const idNumber = document.getElementById('reg-idNumber').value.trim();
        const address = document.getElementById('reg-address') ? document.getElementById('reg-address').value.trim() : '';
        let valid = true;

        if (role === 'beneficiary') {
            if (!phone || phone.length !== 10) {
                showError('reg-phone', '<%= __('register_phone_length_error') %>');
                valid = false;
            }
            const idCheck = validatePalestinianIdClient(idNumber);
            if (!idCheck.valid) {
                showError('reg-idNumber', idCheck.message);
                valid = false;
            }
            if (!address) {
                showError('reg-address', '<%= __('register_address_required') %>');
                valid = false;
            }
            if (altPhone && altPhone.length !== 10) {
                showError('reg-altPhone', '<%= __('register_phone_length_error') %>');
                valid = false;
            }
        } else {
            if (whatsapp && whatsapp.length !== 10) {
                showError('reg-whatsapp', '<%= __('register_phone_length_error') %>');
                valid = false;
            }
        }

        const invalids = document.querySelectorAll('.invalid');
        if (invalids.length > 0 || !valid) {
            e.preventDefault();
            Swal.fire({
                icon: 'error',
                title: I18N.errorsTitle,
                text: I18N.fixText,
                confirmButtonText: I18N.ok
            });
            nextStep(2);
            return false;
        }

        if (role === 'beneficiary') {
            const iban = document.getElementById('reg-iban').value.trim();
            const accountHolder = document.getElementById('reg-accountHolder').value.trim();
            const fullName = document.getElementById('reg-name').value.trim();
            let financialValid = true;

            const ibanCheck = validatePalestinianIbanClient(iban);
            if (!ibanCheck.valid) {
                showError('reg-iban', ibanCheck.message);
                financialValid = false;
            }

            if (!accountHolder) {
                showError('reg-accountHolder', '<%= __('register_account_holder_required') %>');
                financialValid = false;
            } else if (fullName && accountHolder.replace(/\s+/g, ' ').toLowerCase() !== fullName.replace(/\s+/g, ' ').toLowerCase()) {
                showError('reg-accountHolder', '<%= __('register_account_holder_mismatch') %>');
                financialValid = false;
            }

            if (!financialValid) {
                e.preventDefault();
                document.getElementById('error-financial').innerText = '<%= __('register_bank_iban_required') %>';
                Swal.fire({
                    icon: 'warning',
                    title: I18N.financialTitle,
                    text: '<%= __('register_financial_bank_only_hint') %>',
                    confirmButtonText: I18N.ok
                });
                nextStep(2);
                return false;
            } else {
                document.getElementById('error-financial').innerText = '';
            }

            const termsCb = document.getElementById('beneficiary-terms-checkbox');
            const termsErr = document.getElementById('error-beneficiary-terms');
            if (!termsCb || !termsCb.checked) {
                e.preventDefault();
                if (termsErr) termsErr.innerText = '<%= __('flash_beneficiary_contract_required') %>';
                Swal.fire({
                    icon: 'warning',
                    title: I18N.approvalTitle,
                    text: '<%= __('flash_beneficiary_contract_required') %>',
                    confirmButtonText: I18N.ok
                });
                nextStep(3);
                return false;
            }
            if (termsErr) termsErr.innerText = '';
        }

        return true;
    };
</script>

<script src="<%= asset('/assets/js/main.js') %>"></script>
</body>
</html>
