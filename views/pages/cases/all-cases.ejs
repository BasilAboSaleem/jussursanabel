<%- include('../../partials/header-top') %>

<main style="background: #ffffff; min-height: 100vh; overflow: hidden;">
    <section class="nm-page-hero" aria-label="<%= siteText('cases') %>">
        <div class="nm-page-hero__glow" aria-hidden="true"></div>
        <div class="nm-page-hero__watermark" aria-hidden="true"><%= siteText('hero_title') %></div>
        <div class="container nm-page-hero__inner">
            <p class="nm-page-hero__eyebrow"><%= siteText('brand_affiliation_short') %></p>
            <h1 class="nm-page-hero__title"><%= siteText('cases_hero_title') %></h1>
            <p class="nm-page-hero__desc"><%= siteText('cases_hero_desc') %></p>
        </div>
        <svg class="nm-page-hero__horizon" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,48 C280,10 520,70 760,36 C1000,4 1220,58 1440,28 L1440,80 L0,80 Z" fill="#f8fafc"/>
        </svg>
    </section>

    <!-- Opportunities list -->
    <section class="cases-list-section" id="cases-list" style="background: #f8fafc; padding: 20px 0 100px;">
        <div class="container">
            <div class="cases-controls reveal-on-scroll">
                <div class="cases-type-filters" role="navigation" aria-label="<%= siteText('cases') %>">
                    <a href="<%= buildCasesUrl({ type: 'all', page: '' }) %>" class="filter-btn-lux <%= (selectedType || 'all') === 'all' ? 'active' : '' %>" data-filter="all">
                        <i class="fas fa-border-all"></i> <%= __('cases_filter_all') %>
                    </a>
                    <a href="<%= buildCasesUrl({ type: 'orphan', page: '' }) %>" class="filter-btn-lux <%= selectedType === 'orphan' ? 'active' : '' %>" data-filter="orphan">
                        <i class="fas fa-child-reaching"></i> <%= __('cases_type_orphan') %>
                    </a>
                    <a href="<%= buildCasesUrl({ type: 'family', page: '' }) %>" class="filter-btn-lux <%= selectedType === 'family' ? 'active' : '' %>" data-filter="family">
                        <i class="fas fa-users-gear"></i> <%= __('cases_type_family') %>
                    </a>
                </div>

                <div class="cases-toolbar">
                    <div class="cases-count">
                        <i class="fas fa-layer-group"></i>
                        <span>
                            <%= pagination?.total || 0 %>
                            <%= __('cases_available_count') %>
                        </span>
                    </div>

                    <% if ((pagination?.total || 0) > 12) { %>
                        <div class="cases-per-page">
                            <span><%= __('cases_per_page') %></span>
                            <a href="<%= buildCasesUrl({ limit: 12, page: '' }) %>" class="per-page-chip <%= (pagination?.limit || defaultLimit || 24) === 12 ? 'active' : '' %>">12</a>
                            <a href="<%= buildCasesUrl({ limit: 24, page: '' }) %>" class="per-page-chip <%= (pagination?.limit || defaultLimit || 24) === 24 ? 'active' : '' %>">24</a>
                            <a href="<%= buildCasesUrl({ limit: 36, page: '' }) %>" class="per-page-chip <%= (pagination?.limit || defaultLimit || 24) === 36 ? 'active' : '' %>">36</a>
                            <a href="<%= buildCasesUrl({ limit: 48, page: '' }) %>" class="per-page-chip <%= (pagination?.limit || defaultLimit || 24) === 48 ? 'active' : '' %>">48</a>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="grid-3" id="casesGrid" style="gap: 40px;">
            <% if (typeof cases !== 'undefined' && cases.length > 0) { %>
                <% cases.forEach((item, index) => { %>
                    <div class="luxury-card case-card h-100 reveal-on-scroll" data-type="<%= item.type %>" style="transition-delay: <%= index * 0.1 %>s">
                        <!-- Image Container with improved aesthetics -->
                        <div class="card-image-wrapper">
                            <img src="<%= item.image %>" alt="<%= item.title %>" class="case-image" loading="lazy" decoding="async" width="480" height="360">
                            <!-- Soft Overlay for depth -->
                            <div class="image-overlay"></div>
                            <!-- Badge -->
                            <div class="badge <%= item.type === 'orphan' ? 'badge-gold' : 'badge-teal' %> case-badge">
                                <i class="fas <%= item.type === 'orphan' ? 'fa-child' : 'fa-users' %>"></i>
                                <%= item.type === 'orphan' ? __('cases_type_orphan') : __('cases_type_family') %>
                            </div>

                            <% if (item.isFieldVerified) { %>
                                <div class="verified-badge" title="<%= __('cases_verified_tooltip') %>">
                                    <i class="fas fa-check-circle"></i> <%= __('cases_verified_text') %>
                                </div>
                            <% } %>

                            <% if (item.hasStory) { %>
                                <a href="<%= item.storyUrl %>" class="story-video-badge" title="<%= __('cases_story_badge') %>">
                                    <i class="fas fa-circle-play"></i> <%= __('cases_story_badge') %>
                                </a>
                            <% } %>

                            <% if (item.isSatisfied) { %>
                                <div class="satisfied-overlay">
                                    <span class="badge" style="background: var(--secondary); color: white; border: none; padding: 10px 20px; font-weight: 900; box-shadow: 0 4px 15px rgba(0, 165, 68, 0.4);">
                                        <i class="fas fa-heart-circle-check"></i> <%= __('cases_satisfied_text') %>
                                    </span>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="card-body-content" style="position: relative;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                <h3 class="font-cairo case-title" style="margin: 0;">
                                    <%= item.title %>
                                </h3>
                                <% if (item.area) { %>
                                    <span style="font-size: 0.75rem; color: var(--secondary); font-weight: 700; background: rgba(0, 165, 68, 0.1); padding: 2px 8px; border-radius: 5px;">
                                        <i class="fas fa-location-dot"></i> <%= item.area %>
                                    </span>
                                <% } %>
                            </div>
                            <p class="case-description">
                                <%= item.description %>
                            </p>

                            <div class="card-footer-stats">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: <%= typeof item.fundingBarPercent !== 'undefined' ? item.fundingBarPercent : Math.min((item.raisedAmount / (item.targetAmount || 1) * 100), 100) %>%;"></div>
                                </div>
                                <div class="stats-labels">
                                    <span class="raised-text"><%= __('cases_raised_text') %> $<%= item.raisedAmount %></span>
                                    <span class="target-text"><%= __('cases_target_text') %> $<%= item.targetAmount || __('cases_target_open') %></span>
                                </div>

                                <% if (item.hasStory) { %>
                                    <a href="<%= item.storyUrl %>" class="btn-lux btn-sm btn-story-link">
                                        <i class="fas fa-circle-play"></i> <%= __('cases_btn_watch_story') %>
                                    </a>
                                <% } %>
                                <a href="/cases/<%= item._id %>" class="btn-lux btn-lux-primary btn-sm btn-full-width" style="background: var(--grad-green); color: #fff; box-shadow: 0 10px 20px rgba(0, 165, 68, 0.2);">
                                    <%= __('cases_btn_details') %> <i class="fas fa-arrow-<%= langDir === 'rtl' ? 'left' : 'right' %>"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 100px 5%; background: white; border-radius: 30px; border: 2px dashed #f1f5f9;" class="reveal-on-scroll">
                    <div style="width: 100px; height: 100px; background: #f8fafc; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 25px; color: #cbd5e1;">
                        <i class="fas fa-magnifying-glass-chart fa-3x"></i>
                    </div>
                    <h3 class="font-cairo" style="color: var(--primary); font-weight: 900;"><%= __('cases_empty_title') %></h3>
                    <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto;"><%= __('cases_empty_desc') %></p>
                </div>
            <% } %>
        </div>

        <% if ((pagination?.totalPages || 1) > 1) { %>
            <% 
                const currentPage = pagination.page;
                const totalPages = pagination.totalPages;
                const startPage = Math.max(1, currentPage - 2);
                const endPage = Math.min(totalPages, currentPage + 2);
                const pageUrl = (p) => buildCasesUrl({ page: p });
            %>

            <nav aria-label="Cases pagination" class="cases-pagination cases-pagination-desktop" style="display: flex; justify-content: center; margin-top: 38px;">
                <ul class="pagination-lux" style="display: flex; list-style: none; padding: 0; gap: 8px; flex-wrap: wrap; justify-content: center;">
                    <% if (currentPage > 1) { %>
                        <li><a class="page-link-lux" href="<%= pageUrl(currentPage - 1) %>" aria-label="Previous"><i class="fas fa-chevron-<%= langDir === 'rtl' ? 'right' : 'left' %>"></i></a></li>
                    <% } %>

                    <% if (startPage > 1) { %>
                        <li><a class="page-link-lux" href="<%= pageUrl(1) %>">1</a></li>
                        <% if (startPage > 2) { %>
                            <li><span class="page-link-lux disabled">...</span></li>
                        <% } %>
                    <% } %>

                    <% for(let i = startPage; i <= endPage; i++) { %>
                        <li><a class="page-link-lux <%= currentPage === i ? 'active' : '' %>" href="<%= pageUrl(i) %>"><%= i %></a></li>
                    <% } %>

                    <% if (endPage < totalPages) { %>
                        <% if (endPage < totalPages - 1) { %>
                            <li><span class="page-link-lux disabled">...</span></li>
                        <% } %>
                        <li><a class="page-link-lux" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a></li>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <li><a class="page-link-lux" href="<%= pageUrl(currentPage + 1) %>" aria-label="Next"><i class="fas fa-chevron-<%= langDir === 'rtl' ? 'left' : 'right' %>"></i></a></li>
                    <% } %>
                </ul>
            </nav>

            <div id="casesLoadMoreWrap" class="cases-load-more-wrap" style="display: none; justify-content: center; margin-top: 28px;">
                <button type="button" id="casesLoadMoreBtn" class="btn-lux btn-lux-primary" style="min-width: 220px; justify-content: center; border-radius: 999px; padding: 14px 28px; font-weight: 800;">
                    <i class="fas fa-chevron-down"></i> <%= __('cases_load_more') %>
                </button>
            </div>
        <% } %>
        </div>
    </section>
</main>

<style>
    .cases-controls {
        display: flex;
        flex-direction: column;
        gap: 22px;
        margin-bottom: 36px;
    }

    .cases-type-filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        padding: 12px;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(0, 38, 97, 0.06);
        border-radius: 999px;
        box-shadow: 0 18px 40px rgba(0, 38, 97, 0.06);
        width: fit-content;
        max-width: 100%;
        margin: 0 auto;
    }

    .cases-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .cases-count {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-muted);
        font-weight: 700;
    }

    .cases-count i {
        color: var(--secondary);
    }

    .cases-per-page {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 700;
    }

    .cases-load-more-wrap {
        display: none;
    }

    .filter-btn-lux {
        padding: 12px 28px;
        font-size: 0.95rem;
        cursor: pointer;
        border-radius: 30px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--primary);
        font-weight: 750;
        transition: all 0.4s var(--ease-smooth);
        font-family: 'Cairo', sans-serif;
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .filter-btn-lux i {
        font-size: 1.1rem;
        opacity: 0.6;
        transition: 0.3s;
    }

    .filter-btn-lux:hover {
        background: rgba(0, 165, 68, 0.05);
        color: var(--secondary);
    }

    .filter-btn-lux.active {
        background: var(--primary);
        color: white;
        box-shadow: 0 15px 35px rgba(0, 38, 97, 0.2);
    }

    .filter-btn-lux.active i {
        opacity: 1;
        color: var(--secondary-light);
    }

    @media (max-width: 768px) {
        .cases-type-filters {
            border-radius: 24px;
            width: 100%;
            justify-content: stretch;
        }

        .filter-btn-lux {
            flex: 1;
            justify-content: center;
            padding: 12px 14px;
            font-size: 0.88rem;
        }

        .cases-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    /* Card Improvements */
    .case-card {
        padding: 0 !important;
        transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(0,0,0,0.05);
        background: #fff;
    }

    .card-image-wrapper {
        height: 280px;
        position: relative;
        overflow: hidden;
        background: #032E15;
        margin: 12px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .case-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: block;
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(2, 6, 23, 0.8) 0%, transparent 40%, rgba(2, 6, 23, 0.2) 100%);
        opacity: 0.6;
        transition: opacity 0.4s ease;
    }

    /* Shimmer effect for images */
    .card-image-wrapper::after {
        content: "";
        position: absolute;
        top: 0; right: 0; bottom: 0; left: 0;
        background: linear-gradient(to right, transparent, rgba(255,255,255,0.1), transparent);
        transform: translateX(-100%);
        transition: transform 0.6s ease;
    }

    .case-card:hover .card-image-wrapper::after {
        transform: translateX(100%);
    }

    .case-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .verified-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
        background: #00A544;
        color: white;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 4px 12px rgba(0, 165, 68, 0.3);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .story-video-badge {
        position: absolute;
        bottom: 15px;
        left: 15px;
        right: 15px;
        z-index: 11;
        background: rgba(2, 6, 23, 0.82);
        color: #fff;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: transform 0.25s ease, background 0.25s ease;
    }

    .story-video-badge:hover {
        transform: translateY(-2px);
        background: rgba(0, 165, 68, 0.92);
        color: #fff;
    }

    .btn-story-link {
        width: 100%;
        justify-content: center;
        border-radius: 16px;
        padding: 12px 20px;
        font-weight: 800;
        margin-bottom: 10px;
        background: rgba(2, 6, 23, 0.06);
        color: var(--primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.25s ease, color 0.25s ease;
    }

    .btn-story-link:hover {
        background: rgba(0, 165, 68, 0.12);
        color: var(--secondary);
    }

    .card-body-content {
        padding: 20px 30px 30px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .case-title {
        font-size: 1.4rem;
        margin-bottom: 12px;
        font-weight: 850;
        color: var(--primary);
        transition: color 0.3s ease;
        line-height: 1.3;
    }

    .case-description {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-bottom: 25px;
        line-height: 1.8;
        height: 3.6em;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .card-footer-stats {
        margin-top: auto;
    }

    .progress-track {
        margin-bottom: 15px;
        height: 10px;
        background: #f8fafc;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
    }

    .stats-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .raised-text { color: var(--secondary); }
    .target-text { color: #94a3b8; }

    .btn-full-width {
        width: 100%;
        justify-content: center;
        border-radius: 16px;
        padding: 14px 20px;
        font-weight: 800;
        box-shadow: 0 4px 12px rgba(2, 6, 23, 0.1);
    }

    .case-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 40px 80px rgba(2, 6, 23, 0.12), 0 0 30px rgba(0, 165, 68, 0.08);
        border-color: var(--secondary);
    }

    .case-card:hover .case-image {
        transform: scale(1.12);
    }

    .case-card:hover .image-overlay {
        opacity: 0.4;
    }
    
    .case-card:hover .case-title {
        color: var(--secondary);
    }

    /* Animation for filtering */
    @keyframes fadeScale {
        from { opacity: 0; transform: translateY(20px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .case-card.filtering {
        animation: fadeScale 0.5s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
    }

    .per-page-chip {
        min-width: 42px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        color: var(--text-muted);
        background: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.82rem;
        transition: all 0.25s ease;
        padding: 0 12px;
    }

    .per-page-chip:hover {
        border-color: rgba(0, 165, 68, 0.4);
        color: var(--secondary);
        transform: translateY(-1px);
    }

    .per-page-chip.active {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
    }

    .page-link-lux {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        color: var(--text-muted);
        background: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        transition: all 0.25s ease;
    }

    .page-link-lux:hover {
        border-color: rgba(0, 165, 68, 0.4);
        color: var(--secondary);
        transform: translateY(-1px);
    }

    .page-link-lux.active {
        background: var(--secondary);
        border-color: var(--secondary);
        color: #fff;
        box-shadow: 0 8px 18px rgba(0, 165, 68, 0.22);
    }

    .page-link-lux.disabled {
        pointer-events: none;
        background: #f8fafc;
        color: #94a3b8;
    }

    .satisfied-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(2px);
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
    }
</style>

<script>
    window.__CASES_BOOT__ = <%- JSON.stringify({
        page: pagination?.page || 1,
        totalPages: pagination?.totalPages || 1,
        type: selectedType || 'all',
        limit: pagination?.limit || defaultLimit || 24,
        langDir: langDir,
        labels: {
            orphan: __('cases_type_orphan'),
            family: __('cases_type_family'),
            verifiedTooltip: __('cases_verified_tooltip'),
            verifiedText: __('cases_verified_text'),
            satisfiedText: __('cases_satisfied_text'),
            storyBadge: __('cases_story_badge'),
            watchStory: __('cases_btn_watch_story'),
            raisedText: __('cases_raised_text'),
            targetText: __('cases_target_text'),
            targetOpen: __('cases_target_open'),
            detailsBtn: __('cases_btn_details'),
            loadMore: __('cases_load_more'),
            loading: __('cases_loading')
        }
    }) %>;

    const observerOptions = { threshold: 0.1 };
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));
</script>
<script src="<%= asset('/assets/js/cases-list.js') %>" defer></script>

<%- include('../../partials/footer-bottom') %>