<% if (user && user.role === 'donor') { %>
    <%- include('../../partials/donor-layout-top') %>
<% } else { %>
    <%- include('../../partials/family-layout-top') %>
<% } %>

<div class="nm-messages-hub chat-wrapper-lux">
    <!-- Sidebar: Contacts List -->
    <div class="chat-sidebar-lux">
        <div class="sidebar-header-lux">
            <h3 class="font-cairo"><i class="fas fa-comments"></i> مركز التواصل</h3>
            <div class="search-box-lux">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="البحث عن محادثة..." id="contactSearch">
            </div>
        </div>
        <div class="contacts-list-lux" id="contactsContainer">
            <% if (contacts.length > 0) { %>
                <% contacts.forEach(contact => { %>
                    <div class="contact-item-lux <%= activeContact && String(activeContact._id) === String(contact.user._id) ? 'active' : '' %>" 
                         onclick="switchContact('<%= contact.user._id %>')" 
                         data-user-id="<%= contact.user._id %>"
                         id="contact-<%= contact.user._id %>">
                        <div class="avatar-wrapper">
                            <img src="<%= userAvatar(contact.user) %>" class="avatar-lux">
                            <span class="online-indicator"></span>
                        </div>
                        <div class="contact-info">
                            <div class="contact-header">
                                <span class="contact-name">
                                    <%= (contact.user.role === 'admin' || contact.user.role === 'super_admin') ? 'الدعم الفني' : contact.user.name %>
                                </span>
                                <span class="contact-time"><%= contact.time ? contact.time.toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'}) : '' %></span>
                            </div>
                            <p class="last-message"><%= contact.lastMessage %></p>
                            <span class="typing-text-sidebar" id="typing-sidebar-<%= contact.user._id %>" style="display: none; color: #00A544; font-size: 0.75rem; font-weight: 700;">يكتب الآن...</span>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-contacts">
                    <i class="fas fa-comment-slash"></i>
                    <p>لا توجد محادثات نشطة</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Main Chat Window -->
    <div class="chat-main-lux" id="chatMainArea">
        <!-- Placeholder (Always present, toggled via JS) -->
        <div id="chatPlaceholder" class="chat-placeholder-lux" style="display: block;">
            <div class="placeholder-icon">
                <i class="fas fa-comments"></i>
            </div>
            <h3 class="font-cairo">ابدأ حواراً آمناً</h3>
            <p>اختر أحد جهات الاتصال المعتمدة لبدء المحادثة بخصوصية وشفافية.</p>
        </div>

        <!-- Chat Content (Always present, toggled via JS) -->
        <div id="activeChatUI" style="display: none; flex-direction: column; height: 100%; overflow: hidden;">
            <!-- Chat Header -->
            <div class="chat-header-lux">
                <div class="header-user-lux">
                    <button type="button" class="chat-back-mobile" id="chatBackBtn" aria-label="العودة لقائمة المحادثات">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                    <img src="<%= activeContact ? userAvatar(activeContact) : userAvatar({ role: 'donor' }) %>" class="avatar-sm-lux" id="activeAvatar">
                    <div>
                        <h4 class="font-cairo" id="activeName">
                            <%= activeContact ? ((activeContact.role === 'admin' || activeContact.role === 'super_admin') ? 'الدعم الفني' : activeContact.name) : '' %>
                        </h4>
                        <div class="user-meta-lux">
                            <span class="status-lux" id="userStatus"><i class="fas fa-circle"></i> متصل الآن</span>
                            <span class="support-badge" id="supportBadge"><i class="fas fa-shield-alt"></i> حساب موثق</span>
                            <span class="typing-indicator-header" id="typingIndicator" style="display: none; color: #00A544; font-size: 0.75rem; font-weight: 700;">جارٍ الكتابة...</span>
                        </div>
                    </div>
                </div>
                <div class="header-actions">
                    <i class="fas fa-shield-halved" title="محادثة مراقبة" onclick="showMonitoringModal()"></i>
                </div>
            </div>

            <!-- Monitoring Warning Bar -->
            <div class="monitoring-notice">
                <i class="fas fa-shield-halved"></i>
                <span>تنبيه: هذه المحادثة مراقبة لضمان الجودة والشفافية. يُرجى مراجعة <a href="javascript:void(0)" onclick="showMonitoringModal()">شروط الاستخدام</a>.</span>
            </div>

            <!-- Chat History Area -->
            <div class="chat-history-lux" id="chatHistory">
            </div>

            <!-- Input Area (pinned to bottom) -->
            <div class="chat-input-area-lux" id="inputArea" style="display: none; flex-shrink: 0;">
                <form id="chat-form" enctype="multipart/form-data">
                    <input type="file" id="imageInput" accept="image/*" style="display: none;">
                    <button type="button" class="btn-icon" onclick="document.getElementById('imageInput').click()" title="إرسال صورة"><i class="fas fa-camera"></i></button>
                    <input type="text" id="message-input" placeholder="اكتب رسالتك هنا..." autocomplete="off">
                    <button type="button" class="btn-icon emoji-trigger-btn" title="إيموجي"><i class="far fa-face-smile"></i></button>
                    <button type="submit" class="btn-send-lux" id="sendBtn">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
                <!-- Simple Emoji Picker -->
                <div id="emojiPicker" class="emoji-picker-panel" style="display:none;"></div>
            </div>

            <!-- Consent Required Area -->
            <div id="consentRequiredArea" class="monitoring-consent-lock" style="display: none; flex-shrink: 0;">
                <div class="lock-content">
                    <i class="fas fa-lock"></i>
                    <h4 class="font-cairo">يرجى الموافقة على شروط المراقبة لبدء التواصل</h4>
                    <p id="consentStatusText">يجب الضغط على زر الموافقة لتفعيل إرسال الرسائل.</p>
                    <button id="mainAgreeBtn" class="btn-lux btn-lux-primary" onclick="showMonitoringModal()" style="padding: 10px 25px; margin-top: 10px; border-radius: 12px; background: var(--primary); color: white; border: none; cursor: pointer;">قراءة وموافقة</button>
                </div>
            </div>

            <!-- Chat Restricted Area (Day/Time Window) -->
            <div id="chatRestrictedArea" class="chat-restricted-banner" style="display: none; flex-shrink: 0;">
                <div class="restricted-content">
                    <div class="restricted-icon"><i class="fas fa-calendar-times"></i></div>
                    <div class="restricted-text">
                        <h4 class="font-cairo">التواصل غير متاح حالياً</h4>
                        <p id="restrictionReasonDisplay"></p>
                        <div class="restricted-note">
                            <span><%= __('chat_restriction_note') %><% if (typeof serverTimezone !== 'undefined' && serverTimezone) { %> · <%= __('chat_server_timezone_note', { tz: serverTimezone }) %><% } %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ban Policy Banner -->
            <div id="banBanner" class="ban-policy-banner" style="display: none; flex-shrink: 0;">
                <div class="ban-content">
                    <div class="ban-icon"><i class="fas fa-hand-slashing"></i></div>
                    <div class="ban-text">
                        <h4 class="font-cairo">تم حظر التواصل بينكما بقرار إداري</h4>
                        <p id="banReasonDisplay"></p>
                        <div class="ban-appeal">
                            <span>يمكنك تقديم اعتراض من خلال خيار "مركز الدعم" في القائمة الجانبية.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Monitoring Consent Modal -->
<div id="monitoringModal" class="modal-overlay-lux" style="display: none;">
    <div class="nm-admin-card nm-admin-modal-card modal-content-lux" style="max-width: 500px; text-align: center;">
        <div class="modal-icon-lux" style="font-size: 3rem; color: var(--secondary); margin-bottom: 20px;"><i class="fas fa-user-shield"></i></div>
        <h3 class="font-cairo">اتفاقية التواصل الآمن</h3>
        <p style="margin: 20px 0; line-height: 1.7; color: var(--text-muted);">
            بموجب سياسة الشفافية في مؤسسة السنابل، نقوم بمراقبة جميع الرسائل المتبادلة لضمان الخصوصية والالتزام بالمعايير الأخلاقية. 
            <br><b>ملاحظة:</b> لن تتمكن من إرسال الرسائل حتى يوافق الطرفان على هذه الاتفاقية.
        </p>
        <button id="agreeBtn" class="btn-lux btn-lux-primary" style="width: 100%; justify-content: center; padding: 15px; background: var(--primary); color: white; border: none; border-radius: 12px; cursor: pointer; font-size: 1rem; font-weight: bold;">أوافق وأرغب في المتابعة</button>
    </div>
</div>

<div id="supportConfig" data-initial-support="<%= (activeContact && (activeContact.role === 'admin' || activeContact.role === 'super_admin')) ? 'true' : 'false' %>" style="display: none;"></div>
    <div id="initialChatConfig" data-contact-id="<%= (typeof activeContact !== 'undefined' && activeContact) ? activeContact._id : '' %>" style="display: none;"></div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const currentUserId = "<%= user._id %>";
    const currentUserRole = "<%= user.role %>";
    let activeReceiverId = '';
    let currentChatRequest = null;

    const chatPlaceholder = document.getElementById('chatPlaceholder');
    const activeChatUI = document.getElementById('activeChatUI');
    const chatHistoryEl = document.getElementById('chatHistory');
    const chatForm = document.getElementById('chat-form');
    const messageInput = document.getElementById('message-input');
    const imageInput = document.getElementById('imageInput');
    const modal = document.getElementById('monitoringModal');
    const agreeBtn = document.getElementById('agreeBtn');
    const inputArea = document.getElementById('inputArea');
    const consentArea = document.getElementById('consentRequiredArea');
    const consentText = document.getElementById('consentStatusText');
    const mainAgreeBtn = document.getElementById('mainAgreeBtn');
    const chatWrapper = document.querySelector('.nm-messages-hub');
    const chatBackBtn = document.getElementById('chatBackBtn');
    let lastRenderedDate = null;

    function formatDateLabel(date) {
        const d = new Date(date);
        const today = new Date();
        const yesterday = new Date();
        yesterday.setDate(today.getDate() - 1);
        if (d.toDateString() === today.toDateString()) return 'اليوم';
        if (d.toDateString() === yesterday.toDateString()) return 'أمس';
        return d.toLocaleDateString('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    function appendDateDivider(date) {
        const msgDate = new Date(date).toDateString();
        if (lastRenderedDate === msgDate) return;
        lastRenderedDate = msgDate;
        const divider = document.createElement('div');
        divider.className = 'nm-msg-date-divider';
        divider.innerHTML = `<span>${formatDateLabel(date)}</span>`;
        chatHistoryEl.appendChild(divider);
    }

    function isMobileViewport() {
        return window.matchMedia('(max-width: 768px)').matches;
    }

    function openMobileChatMode() {
        if (!chatWrapper || !isMobileViewport()) return;
        chatWrapper.classList.add('mobile-chat-open');
    }

    function closeMobileChatMode() {
        if (!chatWrapper) return;
        chatWrapper.classList.remove('mobile-chat-open');
    }

    socket.on('connect', () => {
        console.log('🔌 Connected to chat server');
    });

    socket.on('consentStatusChanged', (data) => {
        console.log('📜 Consent status updated:', data);
        if (currentChatRequest && String(data.chatRequestId) === String(currentChatRequest._id)) {
            currentChatRequest.donorAgreed = data.donorAgreed;
            currentChatRequest.familyAgreed = data.familyAgreed;
            checkConsentUI();
        }
    });

    async function switchContact(targetUserId) {
        if (!targetUserId) return;
        
        // Prevent unnecessary re-fetching if clicking the currently active contact
        if (String(targetUserId) === activeReceiverId && chatHistoryEl.children.length > 0) return;

        window.history.pushState({}, '', `/messages/${targetUserId}`);
        activeReceiverId = String(targetUserId);

        document.querySelectorAll('.contact-item-lux').forEach(el => el.classList.remove('active'));
        const activeItem = document.getElementById(`contact-${targetUserId}`);
        if (activeItem) activeItem.classList.add('active');

        // Clear and prepare
        chatPlaceholder.style.display = 'none';
        activeChatUI.style.display = 'flex';
        openMobileChatMode();
        chatHistoryEl.innerHTML = '<div class="loading-history" style="text-align:center; padding:20px; color:var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> جاري تحميل المحادثة...</div>';

        // Clear deduplication set on switch
        renderedMessages.clear();
        lastRenderedDate = null;

        try {
            const response = await fetch(`/messages/data/${targetUserId}`);
            const data = await response.json();
            if (data.success) renderChat(data);
        } catch (err) { console.error('Error switching contact:', err); }
    }

    function renderChat(data) {
        currentChatRequest = data.chatRequest;
        
        // Use Support identity for admins
        const isSupport = data.otherUser.role === 'admin' || data.otherUser.role === 'super_admin';
        const displayName = isSupport ? 'الدعم الفني' : data.otherUser.name;
        document.getElementById('activeName').innerText = displayName;
        document.getElementById('activeAvatar').src = data.otherUser.avatar || '<%= userAvatar({ role: "donor" }) %>';
        
        const supportBadge = document.getElementById('supportBadge');
        if (supportBadge) supportBadge.style.display = isSupport ? 'inline-flex' : 'none';
        
        chatHistoryEl.innerHTML = '';
        lastRenderedDate = null;
        if (data.chatHistory) data.chatHistory.forEach(msg => appendMessage(msg));
        chatHistoryEl.scrollTop = chatHistoryEl.scrollHeight;

        // Ban Handling
        const banBanner = document.getElementById('banBanner');
        const banReasonDisplay = document.getElementById('banReasonDisplay');
        if (data.isBlocked) {
            banBanner.style.display = 'flex';
            banReasonDisplay.innerText = data.blockReason || 'لا تتوفر تفاصيل إضافية عن سبب الحظر.';
        } else {
            banBanner.style.display = 'none';
        }

        // Chat Restriction (Day/Time) Handling
        const restrictedArea = document.getElementById('chatRestrictedArea');
        const restrictionReasonDisplay = document.getElementById('restrictionReasonDisplay');
        if (data.isChatRestricted) {
            restrictedArea.style.display = 'flex';
            restrictionReasonDisplay.innerText = data.restrictionReason
                || `التواصل في هذه المحادثة متاح فقط يوم ${data.chatDayName || 'المحدد من الإدارة'}${data.donorWindow && data.donorWindow.from && data.donorWindow.to ? ` من الساعة ${data.donorWindow.from} حتى الساعة ${data.donorWindow.to}` : ''}.`;
        } else {
            restrictedArea.style.display = 'none';
        }

        checkConsentUI(data.isBlocked, data.isChatRestricted);
    }

    // Populate renderedMessages from server-side messages
    function initRenderedMessages() {
        document.querySelectorAll('[data-msg-id]').forEach(el => {
            renderedMessages.add(el.getAttribute('data-msg-id'));
        });
    }

    function checkConsentUI(isBlockedByAdmin = false, isRestrictedByDay = false) {
        if (!currentChatRequest || isBlockedByAdmin || isRestrictedByDay) {
            inputArea.style.display = 'none';
            consentArea.style.display = 'none';
            return;
        }

        const hasMyConsent = (currentUserRole === 'donor') ? currentChatRequest.donorAgreed : currentChatRequest.familyAgreed;
        const hasOtherConsent = (currentUserRole === 'donor') ? currentChatRequest.familyAgreed : currentChatRequest.donorAgreed;

        if (hasMyConsent && hasOtherConsent) {
            inputArea.style.display = 'flex';
            consentArea.style.display = 'none';
        } else if (hasMyConsent && !hasOtherConsent) {
            inputArea.style.display = 'none';
            consentArea.style.display = 'flex';
            consentText.innerText = "تم تسجيل موافقتك. بانتظار موافقة الطرف الآخر لبدء تبادل الرسائل.";
            mainAgreeBtn.style.display = 'none';
        } else {
            inputArea.style.display = 'none';
            consentArea.style.display = 'flex';
            consentText.innerText = "يجب الضغط على زر الموافقة لتفعيل إرسال الرسائل.";
            mainAgreeBtn.style.display = 'inline-block';
        }
    }

    const renderedMessages = new Set();

    function appendMessage(msg) {
        // Standardize Message ID for deduplication
        const msgId = msg._id || `${msg.senderId}-${msg.createdAt}`;
        if (renderedMessages.has(msgId)) return;
        renderedMessages.add(msgId);

        // Standardize IDs: Handle both populated sender object or raw ID
        const senderVal = msg.senderId || msg.sender;
        const senderId = (typeof senderVal === 'object' && senderVal._id) ? senderVal._id : senderVal;
        
        const isMe = String(senderId) === String(currentUserId);
        appendDateDivider(msg.createdAt || Date.now());

        const msgDiv = document.createElement('div');
        msgDiv.className = `msg-group ${isMe ? 'sent' : 'received'}`;
        const time = new Date(msg.createdAt || Date.now()).toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'});
        
        msgDiv.innerHTML = `
            <div class="msg-bubble">
                ${msg.imageUrl ? `<img src="${msg.imageUrl}" class="chat-img-bubble" onclick="window.open(this.src)" alt="">` : ''}
                ${msg.content ? `<p>${msg.content}</p>` : ''}
                <span class="msg-time">${time}</span>
            </div>
        `;
        chatHistoryEl.appendChild(msgDiv);
        chatHistoryEl.scrollTop = chatHistoryEl.scrollHeight;
    }

    function showMonitoringModal() { modal.style.display = 'flex'; }
    
    if (agreeBtn) {
        agreeBtn.addEventListener('click', async () => {
            if (!currentChatRequest) return;
            try {
                const response = await fetch('/messages/accept-monitoring', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '<%= csrfToken %>' 
                    },
                    body: JSON.stringify({ chatRequestId: currentChatRequest._id })
                });
                const result = await response.json();
                if (result.success) {
                    currentChatRequest = result.chatRequest;
                    modal.style.display = 'none';
                    checkConsentUI();
                }
            } catch (err) { console.error('Consent error:', err); }
        });
    }

    let typingTimeout;
    if (messageInput) {
        messageInput.addEventListener('input', () => {
            if (activeReceiverId) {
                socket.emit('typing', { senderId: currentUserId, receiverId: activeReceiverId });
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(() => {
                    socket.emit('stopTyping', { senderId: currentUserId, receiverId: activeReceiverId });
                }, 2000);
            }
        });
    }

    socket.on('userTyping', (data) => {
        const tid = String(data.userId);
        if (tid === String(activeReceiverId)) {
            const headerIndicator = document.getElementById('typingIndicator');
            const userStatus = document.getElementById('userStatus');
            if (headerIndicator) headerIndicator.style.display = 'inline';
            if (userStatus) userStatus.style.display = 'none';
        }
        const sidebarIndicator = document.getElementById(`typing-sidebar-${tid}`);
        const lastMsg = document.querySelector(`#contact-${tid} .last-message`);
        if (sidebarIndicator) sidebarIndicator.style.display = 'block';
        if (lastMsg) lastMsg.style.display = 'none';
    });

    socket.on('userStopTyping', (data) => {
        const tid = String(data.userId);
        if (tid === String(activeReceiverId)) {
            const headerIndicator = document.getElementById('typingIndicator');
            const userStatus = document.getElementById('userStatus');
            if (headerIndicator) headerIndicator.style.display = 'none';
            if (userStatus) userStatus.style.display = 'inline';
        }
        const sidebarIndicator = document.getElementById(`typing-sidebar-${tid}`);
        const lastMsg = document.querySelector(`#contact-${tid} .last-message`);
        if (sidebarIndicator) sidebarIndicator.style.display = 'none';
        if (lastMsg) lastMsg.style.display = 'block';
    });

    async function sendMessage(formData) {
        try {
            const response = await fetch('/messages/send', {
                method: 'POST',
                headers: { 'X-CSRF-Token': '<%= csrfToken %>' },
                body: formData
            });
            const result = await response.json();
            if (result.success) {
                messageInput.value = '';
                imageInput.value = '';
                socket.emit('stopTyping', { senderId: currentUserId, receiverId: activeReceiverId });
            } else if (result.code === 'CONSENT_REQUIRED') {
                showMonitoringModal();
            } else {
                alert(result.error || 'فشل إرسال الرسالة');
            }
        } catch (err) { console.error('Send error:', err); }
    }

    if (chatForm) {
        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const content = messageInput.value.trim();
            if (!content && !imageInput.files[0]) return;
            if (!activeReceiverId) return;

            const formData = new FormData();
            formData.append('receiverId', activeReceiverId);
            formData.append('content', content);
            if (imageInput.files[0]) formData.append('image', imageInput.files[0]);

            sendMessage(formData);
        });
    }

    if (imageInput) {
        imageInput.addEventListener('change', () => {
            if (imageInput.files[0] && activeReceiverId) {
                const formData = new FormData();
                formData.append('receiverId', activeReceiverId);
                formData.append('image', imageInput.files[0]);
                sendMessage(formData);
            }
        });
    }

    socket.on('newMessage', (data) => {
        if (!chatHistoryEl) return;
        // Ensure String comparison for IDs
        const sId = String(data.senderId);
        const rId = String(data.receiverId);
        const activeId = String(activeReceiverId);
        const meId = String(currentUserId);

        // Show message if it belongs to the currently open conversation
        const isInActiveChat = (sId === activeId && rId === meId) || (sId === meId && rId === activeId);
        if (isInActiveChat) {
            appendMessage(data);
        }

        const contactId = (sId === meId) ? rId : sId;
        const contactEl = document.getElementById(`contact-${contactId}`);
        if (contactEl) {
            contactEl.querySelector('.last-message').innerText = data.imageUrl ? '📷 صورة' : data.content;
            contactEl.querySelector('.contact-time').innerText = new Date(data.createdAt || Date.now()).toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'});
        }
    });

    // ===== EMOJI PICKER =====
    const EMOJIS = ['😊','😂','❤️','👍','🙏','😍','🎉','✨','🔥','💪','😢','😎','🤔','💯','👏','🌹','😘','🥰','😁','🤣','😅','😭','🙂','😇','🫶','💙','💚','💛','🧡','💜','😀','🥳','🫠','🤝','👋'];
    const emojiPicker = document.getElementById('emojiPicker');
    const emojiTrigger = document.querySelector('.emoji-trigger-btn');

    if (emojiPicker && emojiTrigger) {
        EMOJIS.forEach(em => {
            const s = document.createElement('span');
            s.textContent = em;
            s.title = em;
            s.addEventListener('click', () => {
                if (messageInput) {
                    messageInput.value += em;
                    messageInput.focus();
                }
                emojiPicker.style.display = 'none';
            });
            emojiPicker.appendChild(s);
        });
        emojiTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            emojiPicker.style.display = emojiPicker.style.display === 'flex' ? 'none' : 'flex';
        });
        document.addEventListener('click', () => {
            emojiPicker.style.display = 'none';
        });
    }

    // Set initial visibility of support badge
    const supportConfig = document.getElementById('supportConfig');
    const initialIsSupport = supportConfig ? supportConfig.dataset.initialSupport === 'true' : false;
    const initialSupportBadge = document.getElementById('supportBadge');
    if (initialSupportBadge) initialSupportBadge.style.display = initialIsSupport ? 'inline-flex' : 'none';

    window.addEventListener('load', () => {
        const initialConfig = document.getElementById('initialChatConfig');
        const initialContactId = initialConfig && initialConfig.dataset.contactId
            ? String(initialConfig.dataset.contactId).trim()
            : '';

        if (initialContactId) {
            switchContact(initialContactId);
            return;
        }

        chatPlaceholder.style.display = 'flex';
        activeChatUI.style.display = 'none';
        closeMobileChatMode();
    });

    if (chatBackBtn) {
        chatBackBtn.addEventListener('click', () => {
            activeReceiverId = '';
            lastRenderedDate = null;
            activeChatUI.style.display = 'none';
            chatPlaceholder.style.display = 'flex';
            document.querySelectorAll('.contact-item-lux').forEach(el => el.classList.remove('active'));
            closeMobileChatMode();
        });
    }

    window.addEventListener('resize', () => {
        if (!isMobileViewport()) {
            closeMobileChatMode();
        }
    });

    const searchInput = document.getElementById('contactSearch');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.contact-item-lux').forEach(c => {
                const nameText = (c.querySelector('.contact-name').innerText === 'الدعم الفني') ? 'الدعم الفني technical support' : c.querySelector('.contact-name').innerText;
                const name = nameText.toLowerCase();
                c.style.display = name.includes(term) ? 'flex' : 'none';
            });
        });
    }
</script>

<% if (user && user.role === 'donor') { %>
<%- include('../../partials/donor-layout-bottom') %>
<% } else { %>
<%- include('../../partials/family-layout-bottom') %>
<% } %>