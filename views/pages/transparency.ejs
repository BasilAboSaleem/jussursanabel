<%- include('../partials/header-top') %>

<main class="nm-transparency-page">
    <%- include('../partials/nm-hero-page', {
        ariaLabel: siteText('navbar_transparency'),
        watermark: siteText('hero_title'),
        eyebrow: siteText('transparency_hero_badge'),
        title: siteText('transparency_hero_title'),
        desc: siteText('transparency_hero_desc'),
        horizonFill: '#ffffff'
    }) %>

    <!-- Impact metrics -->
    <section class="nm-transparency-stats" aria-label="<%= siteText('transparency_hero_title') %>">
        <div class="container">
            <div class="nm-transparency-stats__grid">
                <%
                    const stats = [
                        { target: parseInt(siteText('transparency_stat_value_1'), 10) || 100, label: siteText('transparency_stat_1'), icon: 'fa-hand-holding-heart', suffix: '%' },
                        { target: parseInt(siteText('transparency_stat_value_2'), 10) || 1400, label: siteText('transparency_stat_2'), icon: 'fa-clipboard-check', suffix: '+' },
                        { target: parseInt(siteText('transparency_stat_value_3'), 10) || 24, label: siteText('transparency_stat_3'), icon: 'fa-bolt', suffix: '+' },
                        { target: parseInt(siteText('transparency_stat_value_4'), 10) || 98, label: siteText('transparency_stat_4'), icon: 'fa-face-smile-beam', suffix: '%' }
                    ];
                    stats.forEach((s, idx) => {
                %>
                <article class="nm-transparency-stat reveal-on-scroll" style="transition-delay: <%= idx * 0.08 %>s">
                    <div class="nm-transparency-stat__icon"><i class="fas <%= s.icon %>"></i></div>
                    <div class="impact-number nm-transparency-stat__value" data-target="<%= s.target %>" data-suffix="<%= s.suffix %>">0</div>
                    <p class="nm-transparency-stat__label"><%= s.label %></p>
                </article>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Trust journey -->
    <section class="nm-transparency-journey">
        <div class="container">
            <header class="nm-transparency-head reveal-on-scroll">
                <span class="nm-transparency-head__badge"><i class="fas fa-route"></i> <%= siteText('transparency_journey_badge') %></span>
                <h2 class="nm-transparency-head__title"><%= siteText('transparency_journey_title') %></h2>
                <p class="nm-transparency-head__desc"><%= siteText('transparency_journey_desc') %></p>
            </header>

            <ol class="nm-transparency-steps">
                <%
                    const steps = [
                        { icon: 'fa-magnifying-glass-location', title: siteText('transparency_step_1_title'), desc: siteText('transparency_step_1_desc') },
                        { icon: 'fa-comments', title: siteText('transparency_step_2_title'), desc: siteText('transparency_step_2_desc') },
                        { icon: 'fa-file-circle-check', title: siteText('transparency_step_3_title'), desc: siteText('transparency_step_3_desc') }
                    ];
                    steps.forEach((step, idx) => {
                %>
                <li class="nm-transparency-step reveal-on-scroll" style="transition-delay: <%= idx * 0.1 %>s">
                    <span class="nm-transparency-step__index"><%= String(idx + 1).padStart(2, '0') %></span>
                    <div class="nm-transparency-step__icon"><i class="fas <%= step.icon %>"></i></div>
                    <h3 class="nm-transparency-step__title"><%= step.title %></h3>
                    <p class="nm-transparency-step__desc"><%= step.desc %></p>
                </li>
                <% }) %>
            </ol>
        </div>
    </section>

    <!-- Reports -->
    <section class="nm-transparency-reports" id="reports">
        <div class="container">
            <header class="nm-transparency-head reveal-on-scroll">
                <span class="nm-transparency-head__badge"><i class="fas fa-file-invoice-dollar"></i> <%= siteText('transparency_reports_badge') %></span>
                <h2 class="nm-transparency-head__title"><%= siteText('transparency_reports_title') %></h2>
            </header>

            <div class="nm-transparency-reports__grid">
                <%
                    const reports = [
                        { id: 1, icon: 'fa-file-pdf', action: 'fa-download', btn: __('transparency_report_btn_download') },
                        { id: 2, icon: 'fa-chart-line', action: 'fa-eye', btn: __('transparency_report_btn_view') },
                        { id: 3, icon: 'fa-certificate', action: 'fa-paperclip', btn: __('transparency_report_btn_preview') }
                    ];
                    reports.forEach((r, idx) => {
                %>
                <article class="nm-transparency-report reveal-on-scroll" style="transition-delay: <%= idx * 0.1 %>s">
                    <div class="nm-transparency-report__icon"><i class="fas <%= r.icon %>"></i></div>
                    <h3 class="nm-transparency-report__title"><%= __(`transparency_report_${r.id}_title`) %></h3>
                    <p class="nm-transparency-report__desc"><%= __(`transparency_report_${r.id}_desc`) %></p>
                    <a href="#" class="nm-transparency-report__btn">
                        <i class="fas <%= r.action %>"></i> <%= r.btn %>
                    </a>
                </article>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Trust CTA -->
    <section class="nm-transparency-trust">
        <div class="container">
            <div class="nm-transparency-trust__panel reveal-on-scroll">
                <div class="nm-transparency-trust__copy">
                    <h2 class="nm-transparency-trust__title"><%= siteText('transparency_trust_title') %></h2>
                    <p class="nm-transparency-trust__desc"><%= siteText('transparency_trust_desc') %></p>
                    <p class="nm-transparency-trust__policy">
                        <i class="fas fa-user-shield"></i>
                        <span><%= siteText('transparency_trust_policy') %></span>
                    </p>
                </div>
                <aside class="nm-transparency-trust__aside">
                    <h3 class="nm-transparency-trust__aside-title"><%= __('transparency_faq_title') %></h3>
                    <p class="nm-transparency-trust__aside-desc"><%= __('transparency_faq_desc') %></p>
                    <a href="/contact" class="nm-transparency-trust__cta"><%= siteText('about_cta_btn_contact') %></a>
                </aside>
            </div>
        </div>
    </section>
</main>

<style>
    .nm-transparency-page {
        overflow: hidden;
        background: #fff;
    }

    .nm-transparency-stats {
        background: #f8fafc;
        padding: 72px 0 100px;
        margin-top: 0;
        position: relative;
        z-index: 2;
        border-top: 1px solid rgba(0, 38, 97, 0.04);
    }

    .nm-transparency-stats__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        background: #fff;
        border: 1px solid rgba(0, 38, 97, 0.06);
        border-radius: 28px;
        padding: 12px;
        box-shadow: 0 20px 50px rgba(0, 38, 97, 0.06);
    }

    .nm-transparency-stat {
        text-align: center;
        padding: 28px 16px;
        border-radius: 22px;
        transition: background 0.3s ease;
    }

    .nm-transparency-stat:hover {
        background: #f0fdf4;
    }

    .nm-transparency-stat__icon {
        width: 46px;
        height: 46px;
        margin: 0 auto 14px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 165, 68, 0.08);
        color: var(--secondary);
        font-size: 1.1rem;
    }

    .nm-transparency-stat__value {
        font-family: 'Cairo', sans-serif;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 900;
        color: var(--primary);
        line-height: 1.1;
        margin-bottom: 8px;
    }

    .nm-transparency-stat__label {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--text-muted);
        line-height: 1.5;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .nm-transparency-journey {
        padding: 120px 0;
        background: #fff;
    }

    .nm-transparency-head {
        text-align: center;
        max-width: 640px;
        margin: 0 auto 64px;
    }

    .nm-transparency-head__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(0, 165, 68, 0.08);
        color: var(--secondary);
        border: 1px solid rgba(0, 165, 68, 0.16);
        font-size: 0.82rem;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .nm-transparency-head__title {
        margin: 0 0 12px;
        font-family: 'Cairo', sans-serif;
        font-size: clamp(1.7rem, 3.5vw, 2.4rem);
        font-weight: 900;
        color: var(--primary);
        line-height: 1.3;
    }

    .nm-transparency-head__desc {
        margin: 0;
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.8;
        font-weight: 500;
    }

    .nm-transparency-steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
        counter-reset: none;
    }

    .nm-transparency-step {
        position: relative;
        padding: 32px 28px;
        border-radius: 24px;
        background: #f8fafc;
        border: 1px solid rgba(0, 38, 97, 0.05);
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .nm-transparency-step:hover {
        transform: translateY(-6px);
        border-color: rgba(0, 165, 68, 0.25);
        box-shadow: 0 24px 48px rgba(0, 38, 97, 0.08);
        background: #fff;
    }

    .nm-transparency-step__index {
        position: absolute;
        top: 20px;
        inset-inline-end: 22px;
        font-family: 'Cairo', sans-serif;
        font-size: 0.85rem;
        font-weight: 900;
        color: rgba(0, 38, 97, 0.18);
    }

    .nm-transparency-step__icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #002661, #00A544);
        color: #fff;
        font-size: 1.15rem;
        margin-bottom: 20px;
    }

    .nm-transparency-step__title {
        margin: 0 0 10px;
        font-family: 'Cairo', sans-serif;
        font-size: 1.15rem;
        font-weight: 850;
        color: var(--primary);
        line-height: 1.4;
    }

    .nm-transparency-step__desc {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.75;
    }

    .nm-transparency-reports {
        padding: 120px 0 80px;
        background: #f8fafc;
    }

    .nm-transparency-reports__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .nm-transparency-report {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 36px 30px;
        border-radius: 26px;
        background: #fff;
        border: 1px solid rgba(0, 38, 97, 0.06);
        box-shadow: 0 12px 30px rgba(0, 38, 97, 0.04);
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .nm-transparency-report:hover {
        transform: translateY(-6px);
        border-color: rgba(0, 165, 68, 0.28);
        box-shadow: 0 28px 56px rgba(0, 38, 97, 0.1);
    }

    .nm-transparency-report__icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 165, 68, 0.08);
        color: var(--secondary);
        font-size: 1.55rem;
        margin-bottom: 22px;
    }

    .nm-transparency-report__title {
        margin: 0 0 12px;
        font-family: 'Cairo', sans-serif;
        font-size: 1.2rem;
        font-weight: 850;
        color: var(--primary);
        line-height: 1.4;
    }

    .nm-transparency-report__desc {
        margin: 0 0 28px;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.75;
        flex-grow: 1;
    }

    .nm-transparency-report__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 14px 18px;
        border-radius: 16px;
        border: 1.5px solid rgba(0, 38, 97, 0.1);
        color: var(--primary);
        font-weight: 800;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.3s ease;
        background: transparent;
    }

    .nm-transparency-report__btn:hover {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0, 38, 97, 0.18);
    }

    .nm-transparency-trust {
        padding: 0 0 130px;
        margin-top: 0;
        background: #fff;
    }

    .nm-transparency-trust .container {
        padding-top: 100px;
    }

    .nm-transparency-trust__panel {
        display: grid;
        grid-template-columns: 1.35fr 0.85fr;
        gap: 28px;
        padding: 42px;
        border-radius: 32px;
        background:
            radial-gradient(ellipse 60% 80% at 100% 0%, rgba(0, 165, 68, 0.22) 0%, transparent 55%),
            linear-gradient(135deg, #002661 0%, #032E15 100%);
        color: #fff;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0, 38, 97, 0.18);
    }

    .nm-transparency-trust__title {
        margin: 0 0 14px;
        font-family: 'Cairo', sans-serif;
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 900;
        line-height: 1.3;
    }

    .nm-transparency-trust__desc {
        margin: 0 0 22px;
        font-size: 1.05rem;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.78);
        max-width: 540px;
    }

    .nm-transparency-trust__policy {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        padding: 12px 16px;
        border-radius: 999px;
        background: rgba(0, 165, 68, 0.14);
        border: 1px solid rgba(105, 255, 151, 0.2);
        color: #b9f5c8;
        font-weight: 700;
        font-size: 0.92rem;
    }

    .nm-transparency-trust__aside {
        padding: 28px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .nm-transparency-trust__aside-title {
        margin: 0 0 10px;
        font-family: 'Cairo', sans-serif;
        font-size: 1.25rem;
        font-weight: 850;
    }

    .nm-transparency-trust__aside-desc {
        margin: 0 0 22px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.95rem;
        line-height: 1.7;
    }

    .nm-transparency-trust__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 14px 20px;
        border-radius: 14px;
        background: #00A544;
        color: #fff;
        font-weight: 850;
        text-decoration: none;
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

    .nm-transparency-trust__cta:hover {
        background: #00C758;
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(0, 165, 68, 0.35);
        color: #fff;
    }

    @media (max-width: 992px) {
        .nm-transparency-stats__grid,
        .nm-transparency-steps,
        .nm-transparency-reports__grid {
            grid-template-columns: 1fr 1fr;
        }

        .nm-transparency-trust__panel {
            grid-template-columns: 1fr;
            padding: 32px 24px;
        }
    }

    @media (max-width: 640px) {
        .nm-transparency-stats {
            padding: 56px 0 80px;
        }

        .nm-transparency-stats__grid,
        .nm-transparency-steps,
        .nm-transparency-reports__grid {
            grid-template-columns: 1fr;
        }

        .nm-transparency-head {
            margin-bottom: 40px;
        }

        .nm-transparency-journey {
            padding: 88px 0;
        }

        .nm-transparency-reports {
            padding: 88px 0 48px;
        }

        .nm-transparency-trust {
            padding-bottom: 96px;
        }

        .nm-transparency-trust .container {
            padding-top: 72px;
        }

        .nm-transparency-trust__policy {
            width: 100%;
            justify-content: center;
            text-align: center;
            border-radius: 18px;
        }
    }
</style>

<script>
    const observerOptions = { threshold: 0.12 };
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('active');
        });
    }, observerOptions);
    document.querySelectorAll('.reveal-on-scroll').forEach((el) => revealObserver.observe(el));

    const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const target = parseInt(el.getAttribute('data-target'), 10) || 0;
            const suffix = el.getAttribute('data-suffix') || '';
            animateValue(el, 0, target, 1800, suffix);
            counterObserver.unobserve(el);
        });
    }, observerOptions);

    function animateValue(obj, start, end, duration, suffix) {
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);
            obj.textContent = value.toLocaleString() + suffix;
            if (progress < 1) window.requestAnimationFrame(step);
        };
        window.requestAnimationFrame(step);
    }

    document.querySelectorAll('.impact-number').forEach((el) => counterObserver.observe(el));
</script>

<%- include('../partials/footer-bottom') %>
