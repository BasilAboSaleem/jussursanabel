<%- include('../../partials/admin-layout-top') %>

<div class="nm-activity-hub" style="text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
    <div class="nm-analytics-hub__meta nm-activity-hub__meta">
        <p class="nm-analytics-hub__desc"><%= __('admin_settings_desc') %></p>
    </div>

    <section class="nm-activity-hub__panel nm-admin-card nm-admin-card--flush">
        <form action="/admin/settings/update" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="nm-activity-hub__filter-bar">
                <div>
                    <div class="nm-admin-form-hub__title"><%= __('admin_settings_fee_label') %></div>
                    <p class="nm-admin-form-hub__desc"><%= __('admin_settings_fee_desc_split') %></p>
                </div>
            </div>
            <div class="nm-admin-form-hub__body">
                <div class="nm-activity-hub__filter-form">
                    <div class="nm-activity-hub__filter-field">
                        <label for="institutionFee"><%= __('admin_settings_institution_fee_label') %></label>
                        <input type="number" step="0.01" id="institutionFee" name="institution_fee_percentage" class="form-input"
                               value="<%= settings.institution_fee_percentage %>" required>
                    </div>
                    <div class="nm-activity-hub__filter-field">
                        <label for="gatewayFee"><%= __('admin_settings_gateway_fee_label') %></label>
                        <input type="number" step="0.01" id="gatewayFee" name="gateway_fee_percentage" class="form-input"
                               value="<%= settings.gateway_fee_percentage %>" required>
                    </div>
                </div>
                <p class="nm-admin-form-hub__note">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    <%= __('admin_settings_fee_breakdown_help') %>
                </p>
            </div>

            <div class="nm-activity-hub__filter-bar">
                <div>
                    <div class="nm-admin-form-hub__title"><%= __('admin_settings_chat_day_label') %></div>
                    <p class="nm-admin-form-hub__desc"><%= __('admin_settings_chat_day_desc') %></p>
                </div>
            </div>
            <div class="nm-admin-form-hub__body">
                <div class="nm-activity-hub__filter-form">
                    <div class="nm-activity-hub__filter-field nm-activity-hub__filter-field--date">
                        <label for="chatDay"><%= __('admin_settings_chat_day_select_label') %></label>
                        <select id="chatDay" name="chat_day" class="form-input">
                            <option value="0" <%= settings.chat_day == 0 ? 'selected' : '' %>><%= __('common_day_0') %></option>
                            <option value="1" <%= settings.chat_day == 1 ? 'selected' : '' %>><%= __('common_day_1') %></option>
                            <option value="2" <%= settings.chat_day == 2 ? 'selected' : '' %>><%= __('common_day_2') %></option>
                            <option value="3" <%= settings.chat_day == 3 ? 'selected' : '' %>><%= __('common_day_3') %></option>
                            <option value="4" <%= settings.chat_day == 4 ? 'selected' : '' %>><%= __('common_day_4') %></option>
                            <option value="5" <%= settings.chat_day == 5 ? 'selected' : '' %>><%= __('common_day_5') %></option>
                            <option value="6" <%= settings.chat_day == 6 ? 'selected' : '' %>><%= __('common_day_6') %></option>
                        </select>
                    </div>
                </div>
                <p class="nm-admin-form-hub__note">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    <%= __('admin_settings_chat_day_info') %>
                </p>
            </div>

            <div class="nm-admin-form-hub__footer">
                <button type="submit" class="btn-lux btn-lux-primary">
                    <i class="fas fa-save" aria-hidden="true"></i> <%= __('common_save_settings') %>
                </button>
            </div>
        </form>
    </section>
</div>

<style>
    .nm-admin-form-hub__title {
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--primary);
    }
    .nm-admin-form-hub__desc {
        margin: 4px 0 0;
        font-size: 0.8rem;
        color: var(--text-muted);
        line-height: 1.5;
    }
    .nm-admin-form-hub__body {
        padding: 18px;
    }
    .nm-admin-form-hub__note {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 14px 0 0;
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--text-muted);
    }
    .nm-admin-form-hub__note i {
        margin-top: 2px;
        flex-shrink: 0;
    }
    .nm-admin-form-hub__footer {
        display: flex;
        justify-content: flex-end;
        padding: 14px 18px;
        border-top: 1px solid rgba(0, 38, 97, 0.06);
        background: #fafbfc;
    }
</style>

<%- include('../../partials/admin-layout-bottom') %>
