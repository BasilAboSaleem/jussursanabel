<%- include('../../partials/admin-layout-top') %>

<div class="nm-admin-card nm-admin-page-header">
    <div class="responsive-stack" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap;">
        <div>
            <h3 class="font-cairo" style="margin: 0;"><i class="fas fa-key"></i> <%= __('admin_password_recovery_title') %></h3>
            <p style="color: var(--text-muted); margin-top: 8px; max-width: 720px; line-height: 1.7;"><%= __('admin_password_recovery_desc') %></p>
        </div>
        <div class="badge badge-navy" style="padding: 10px 16px; border-radius: 12px; font-size: 0.85rem;">
            <i class="fas fa-shield-halved"></i> <%= __('admin_password_recovery_super_only') %>
        </div>
    </div>
</div>

<div class="nm-admin-card nm-admin-filter-bar">
    <form action="/admin/password-recovery" method="GET" class="responsive-stack" style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
        <div class="form-group" style="flex: 1; min-width: 260px;">
            <label class="form-label-luxury" style="font-size: 0.8rem;"><%= __('admin_password_recovery_search_label') %></label>
            <input type="text" name="q" value="<%= search || '' %>" class="form-input" placeholder="<%= __('admin_password_recovery_search_placeholder') %>" minlength="2" required>
        </div>
        <button type="submit" class="btn-lux btn-lux-primary" style="padding: 12px 28px;">
            <i class="fas fa-search"></i> <%= __('common_search') %>
        </button>
        <% if (search) { %>
            <a href="/admin/password-recovery" class="btn-lux btn-lux-outline-white" style="padding: 12px 18px;">
                <i class="fas fa-undo"></i>
            </a>
        <% } %>
    </form>
    <p style="margin: 14px 0 0; font-size: 0.82rem; color: var(--text-muted);">
        <i class="fas fa-circle-info"></i> <%= __('admin_password_recovery_search_hint') %>
    </p>
</div>

<% if (search && search.length >= 2) { %>
    <div class="nm-admin-card nm-admin-card--flush">
        <% if (!users || users.length === 0) { %>
            <div style="padding: 40px; text-align: center; color: var(--text-muted);">
                <i class="fas fa-user-slash" style="font-size: 2rem; opacity: 0.4; margin-bottom: 12px;"></i>
                <p style="margin: 0;"><%= __('admin_password_recovery_no_results') %></p>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table style="width: 100%; border-collapse: collapse; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
                    <thead style="background: rgba(0,0,0,0.03); border-bottom: 1px solid rgba(0,0,0,0.06);">
                        <tr>
                            <th style="padding: 16px 20px;"><%= __('common_user') %></th>
                            <th style="padding: 16px 20px;"><%= __('common_id_number') %></th>
                            <th style="padding: 16px 20px;"><%= __('admin_password_recovery_col_email') %></th>
                            <th style="padding: 16px 20px;"><%= __('common_role_category') %></th>
                            <th style="padding: 16px 20px;"><%= __('common_status') %></th>
                            <th style="padding: 16px 20px; text-align: <%= langDir === 'rtl' ? 'left' : 'right' %>;"><%= __('common_actions') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                            <tr style="border-bottom: 1px solid rgba(0,0,0,0.04);">
                                <td style="padding: 16px 20px; font-weight: 700;"><%= u.name %></td>
                                <td style="padding: 16px 20px;"><%= u.idNumber || __('common_not_available') %></td>
                                <td style="padding: 16px 20px; direction: ltr; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;"><%= u.email %></td>
                                <td style="padding: 16px 20px;"><span class="badge badge-navy"><%= u.role %></span></td>
                                <td style="padding: 16px 20px;">
                                    <%= u.status %>
                                    <% if (u.mustChangePassword) { %>
                                        <span class="badge" style="background: #fef3c7; color: #92400e; margin-<%= langDir === 'rtl' ? 'right' : 'left' %>: 6px;"><%= __('admin_password_recovery_pending_change') %></span>
                                    <% } %>
                                </td>
                                <td style="padding: 16px 20px; text-align: <%= langDir === 'rtl' ? 'left' : 'right' %>;">
                                    <button type="button" class="btn-lux btn-lux-primary btn-issue-temp"
                                        data-user-id="<%= u._id %>"
                                        data-user-name="<%= u.name %>"
                                        style="padding: 10px 16px; font-size: 0.85rem;">
                                        <i class="fas fa-rotate"></i> <%= __('admin_password_recovery_issue_btn') %>
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
<% } %>

<!-- Issue temp password modal -->
<div id="tempPasswordModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 2000; align-items: center; justify-content: center; padding: 20px;">
    <div class="nm-admin-card nm-admin-modal-card">
        <h4 class="font-cairo" style="margin: 0 0 8px; font-weight: 800;" id="modalTitle"><%= __('admin_password_recovery_modal_title') %></h4>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0 0 20px;" id="modalUserName"></p>

        <div id="modalFormSection">
            <label style="display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 8px;"><%= __('admin_password_recovery_reason_label') %></label>
            <textarea id="tempPasswordReason" class="form-input" rows="4" placeholder="<%= __('admin_password_recovery_reason_placeholder') %>" style="width: 100%; resize: vertical;"></textarea>
            <p style="font-size: 0.78rem; color: var(--text-muted); margin: 8px 0 0;"><%= __('admin_password_recovery_reason_hint') %></p>

            <div style="display: flex; gap: 10px; margin-top: 22px; justify-content: flex-end; flex-wrap: wrap;">
                <button type="button" class="btn-lux btn-lux-outline-white" onclick="closeTempPasswordModal()"><%= __('common_cancel') %></button>
                <button type="button" class="btn-lux btn-lux-primary" id="confirmIssueBtn" onclick="submitTemporaryPassword()">
                    <i class="fas fa-key"></i> <%= __('admin_password_recovery_confirm_issue') %>
                </button>
            </div>
        </div>

        <div id="modalResultSection" style="display: none;">
            <div style="background: rgba(0, 165, 68, 0.1); border: 1px solid rgba(0, 165, 68, 0.25); border-radius: 14px; padding: 18px; margin-bottom: 16px;">
                <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 6px;"><%= __('admin_password_recovery_temp_password_label') %></div>
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <code id="generatedPassword" style="font-size: 1.35rem; font-weight: 800; letter-spacing: 1px; color: var(--primary); background: white; padding: 10px 14px; border-radius: 10px; border: 1px dashed #cbd5e1;"></code>
                    <button type="button" class="btn-lux btn-lux-navy" onclick="copyTempPassword()" style="padding: 10px 14px;">
                        <i class="fas fa-copy"></i> <%= __('admin_password_recovery_copy') %>
                    </button>
                </div>
            </div>
            <p id="loginHintText" style="font-size: 0.9rem; color: var(--text-main); margin: 0 0 12px;"></p>
            <p style="font-size: 0.82rem; color: #b45309; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 12px; margin: 0 0 20px;">
                <i class="fas fa-triangle-exclamation"></i> <%= __('admin_password_recovery_once_warning') %>
            </p>
            <div style="text-align: <%= langDir === 'rtl' ? 'left' : 'right' %>;">
                <button type="button" class="btn-lux btn-lux-primary" onclick="closeTempPasswordModal(true)"><%= __('common_close') %></button>
            </div>
        </div>
    </div>
</div>

<script>
    const csrfToken = '<%= csrfToken %>';
    let selectedUserId = null;

    document.querySelectorAll('.btn-issue-temp').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedUserId = btn.dataset.userId;
            document.getElementById('modalUserName').textContent = btn.dataset.userName;
            document.getElementById('tempPasswordReason').value = '';
            document.getElementById('modalFormSection').style.display = 'block';
            document.getElementById('modalResultSection').style.display = 'none';
            document.getElementById('tempPasswordModal').style.display = 'flex';
        });
    });

    function closeTempPasswordModal(reload) {
        document.getElementById('tempPasswordModal').style.display = 'none';
        selectedUserId = null;
        if (reload) location.reload();
    }

    async function submitTemporaryPassword() {
        if (!selectedUserId) return;

        const reason = document.getElementById('tempPasswordReason').value.trim();
        const confirmBtn = document.getElementById('confirmIssueBtn');
        confirmBtn.disabled = true;

        try {
            const response = await fetch(`/admin/users/${selectedUserId}/temporary-password`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken,
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ reason, _csrf: csrfToken })
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                Swal.fire({ icon: 'error', title: data.message || '<%= __('admin_password_recovery_issue_error') %>' });
                return;
            }

            document.getElementById('generatedPassword').textContent = data.tempPassword;
            document.getElementById('loginHintText').textContent = data.loginHint;
            document.getElementById('modalFormSection').style.display = 'none';
            document.getElementById('modalResultSection').style.display = 'block';
        } catch (err) {
            Swal.fire({ icon: 'error', title: '<%= __('admin_password_recovery_issue_error') %>' });
        } finally {
            confirmBtn.disabled = false;
        }
    }

    function copyTempPassword() {
        const text = document.getElementById('generatedPassword').textContent;
        navigator.clipboard.writeText(text).then(() => {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '<%= __('admin_password_recovery_copied') %>', showConfirmButton: false, timer: 2000 });
        });
    }

    document.getElementById('tempPasswordModal').addEventListener('click', (e) => {
        if (e.target.id === 'tempPasswordModal') closeTempPasswordModal();
    });
</script>

<%- include('../../partials/admin-layout-bottom') %>
