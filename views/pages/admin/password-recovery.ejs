        .nm-pwd-recovery-hub__meta.nm-analytics-hub__meta {
            flex-direction: column;
        }

        .nm-admin-pending-actions {
            justify-content: flex-start;
        }
    }
</style>

<script>
    const csrfToken = '<%= csrfToken %>';
    let selectedUserId = null;
    let searchDebounceTimer = null;

    const pwdRecoveryForm = document.getElementById('pwdRecoveryForm');
    const pwdRecoverySearch = document.getElementById('pwdRecoverySearch');
    const tempPasswordModal = document.getElementById('tempPasswordModal');

    if (pwdRecoverySearch && pwdRecoveryForm) {
        pwdRecoverySearch.addEventListener('input', () => {
            clearTimeout(searchDebounceTimer);
            const value = (pwdRecoverySearch.value || '').trim();
            if (value.length >= 2 || value.length === 0) {
                searchDebounceTimer = setTimeout(() => {
                    pwdRecoveryForm.requestSubmit();
                }, 450);
            }
        });

        pwdRecoverySearch.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                clearTimeout(searchDebounceTimer);
                pwdRecoveryForm.requestSubmit();
            }
        });
    }

    function openTempPasswordModal(userId, userName) {
        selectedUserId = userId;
        document.getElementById('modalUserName').textContent = userName;
        document.getElementById('tempPasswordReason').value = '';
        document.getElementById('modalFormSection').hidden = false;
        document.getElementById('modalResultSection').hidden = true;
        tempPasswordModal.hidden = false;
    }

    function closeTempPasswordModal(reload) {
        tempPasswordModal.hidden = true;
        selectedUserId = null;
        if (reload) location.reload();
    }

    document.querySelectorAll('.btn-issue-temp').forEach((btn) => {
        btn.addEventListener('click', () => {
            openTempPasswordModal(btn.dataset.userId, btn.dataset.userName);
        });
    });

    document.querySelectorAll('[data-action="close-modal"]').forEach((btn) => {
        btn.addEventListener('click', () => closeTempPasswordModal(false));
    });

    document.querySelectorAll('[data-action="close-modal-reload"]').forEach((btn) => {
        btn.addEventListener('click', () => closeTempPasswordModal(true));
    });

    tempPasswordModal.addEventListener('click', (event) => {
        if (event.target === tempPasswordModal) closeTempPasswordModal(false);
    });

    async function submitTemporaryPassword() {
        if (!selectedUserId) return;

        const reason = document.getElementById('tempPasswordReason').value.trim();
        const confirmBtn = document.getElementById('confirmIssueBtn');
        confirmBtn.disabled = true;

        try {
            const response = await fetch(`/admin/users/${selectedUserId}/temporary-password`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken,
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ reason, _csrf: csrfToken })
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                Swal.fire({ icon: 'error', title: data.message || '<%= __('admin_password_recovery_issue_error') %>' });
                return;
            }

            document.getElementById('generatedPassword').textContent = data.tempPassword;
            document.getElementById('loginHintText').textContent = data.loginHint;
            document.getElementById('modalFormSection').hidden = true;
            document.getElementById('modalResultSection').hidden = false;
        } catch (err) {
            Swal.fire({ icon: 'error', title: '<%= __('admin_password_recovery_issue_error') %>' });
        } finally {
            confirmBtn.disabled = false;
        }
    }

    document.getElementById('confirmIssueBtn').addEventListener('click', submitTemporaryPassword);

    document.getElementById('copyTempPasswordBtn').addEventListener('click', () => {
        const text = document.getElementById('generatedPassword').textContent;
        navigator.clipboard.writeText(text).then(() => {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: '<%= __('admin_password_recovery_copied') %>',
                showConfirmButton: false,
                timer: 2000
            });
        });
    });
</script>

<%- include('../../partials/admin-layout-bottom') %>
