        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .nm-pwd-recovery-hub__meta-aside {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .nm-pwd-recovery-hub__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 12px;
        background: rgba(15, 23, 42, 0.06);
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .nm-pwd-recovery-hub__badge i {
        opacity: 0.75;
    }

    .nm-pwd-recovery-hub__hint {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        font-size: 0.84rem;
        color: var(--text-muted);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .nm-pwd-recovery-table {
        text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;
    }

    .nm-admin-pending-user {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .nm-admin-pending-user__avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid var(--primary);
        object-fit: cover;
        flex-shrink: 0;
    }

    .nm-admin-pending-user__phone {
        color: var(--secondary);
        font-weight: 700;
    }

    .nm-admin-pending-id {
        font-family: monospace;
        font-weight: 700;
        font-size: 0.88rem;
    }

    .nm-admin-pending-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-start;
    }

    .nm-admin-pending-actions__btn {
        font-size: 0.78rem !important;
        padding: 8px 12px !important;
        white-space: nowrap;
        text-decoration: none;
    }

    .nm-pwd-recovery-email {
        direction: ltr;
        text-align: start;
    }

    .nm-pwd-recovery-status {
        display: inline-flex;
