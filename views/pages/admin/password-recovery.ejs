<%- include('../../partials/admin-layout-top') %>

<%
function pwdRecoveryUrl(overrides) {
    const q = overrides && overrides.q !== undefined ? overrides.q : search;
    const role = overrides && overrides.role !== undefined ? overrides.role : currentRole;
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    if (role && role !== 'all') params.set('role', role);
    const qs = params.toString();
    return '/admin/password-recovery' + (qs ? '?' + qs : '');
}

const roleFilters = [
    { key: 'all', href: pwdRecoveryUrl({ role: 'all' }), label: __('common_all'), count: roleCounts.all },
    { key: 'donor', href: pwdRecoveryUrl({ role: 'donor' }), label: __('admin_password_recovery_filter_donor_short'), title: __('common_donor'), count: roleCounts.donor, dot: 'field' },
    { key: 'beneficiary', href: pwdRecoveryUrl({ role: 'beneficiary' }), label: __('admin_password_recovery_filter_beneficiary_short'), title: __('admin_password_recovery_filter_beneficiary_title'), count: roleCounts.beneficiary, dot: 'media' },
];

function pwdRecoveryRoleLabel(role) {
    if (role === 'donor') return __('common_donor');
    if (role === 'family') return __('common_family');
    if (role === 'guardian') return __('common_orphan_guardian');
    return __('common_beneficiary');
}

function pwdRecoveryStatusLabel(status) {
    if (status === 'active') return __('common_status_active');
    if (status === 'suspended') return __('common_status_suspended');
    return __('common_pending');
}

const hasSearch = search && search.length >= 2;
%>

<div class="nm-pwd-recovery-hub">
    <div class="nm-analytics-hub__meta nm-pwd-recovery-hub__meta">
        <p class="nm-analytics-hub__desc"><%= __('admin_password_recovery_desc') %></p>
        <div class="nm-pwd-recovery-hub__meta-aside">
            <span class="nm-activity-hub__stat nm-pwd-recovery-hub__badge" title="<%= __('admin_password_recovery_super_only') %>">
                <i class="fas fa-shield-halved" aria-hidden="true"></i>
                <span><%= __('admin_password_recovery_super_only') %></span>
            </span>
            <% if (hasSearch) { %>
                <span class="nm-activity-hub__stat" title="<%= __('admin_password_recovery_results_hint') %>">
                    <strong><%= roleCounts.all.toLocaleString() %></strong>
                    <span><%= __('admin_password_recovery_results_label') %></span>
                </span>
            <% } %>
        </div>
    </div>

    <div class="nm-admin-hub nm-admin-card nm-admin-card--flush">
        <form action="/admin/password-recovery" method="GET" class="nm-admin-hub__toolbar" id="pwdRecoveryForm">
            <% if (currentRole !== 'all') { %>
                <input type="hidden" name="role" value="<%= currentRole %>">
            <% } %>
            <div class="nm-admin-hub__search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search"
                    name="q"
                    id="pwdRecoverySearch"
                    value="<%= search || '' %>"
                    placeholder="<%= __('admin_password_recovery_search_placeholder') %>"
                    minlength="2"
                    autocomplete="off"
                    aria-label="<%= __('admin_password_recovery_search_placeholder') %>">
            </div>

            <% if (hasSearch) { %>
                <div class="nm-admin-hub__filters" role="tablist" aria-label="<%= __('admin_password_recovery_filter_label') %>">
                    <% roleFilters.forEach((f) => { %>
                    <a href="<%= f.href %>"
                       class="nm-admin-hub__filter<%= currentRole === f.key ? ' is-active' : '' %>"
                       role="tab"
                       aria-selected="<%= currentRole === f.key ? 'true' : 'false' %>"
                       <% if (f.title) { %>title="<%= f.title %>"<% } %>>
                        <% if (f.key === 'all') { %>
                            <i class="fas fa-layer-group" aria-hidden="true"></i>
                        <% } else { %>
                            <span class="nm-admin-hub__filter-dot nm-admin-hub__filter-dot--<%= f.dot %>" aria-hidden="true"></span>
                        <% } %>
                        <span><%= f.label %></span>
                        <em><%= f.count %></em>
                    </a>
                    <% }) %>
                </div>
            <% } %>
        </form>

        <% if (!hasSearch) { %>
            <div class="nm-pwd-recovery-hub__hint">
                <i class="fas fa-circle-info" aria-hidden="true"></i>
                <span><%= __('admin_password_recovery_search_hint') %></span>
            </div>
        <% } %>

        <div class="table-responsive nm-admin-chat-table-wrap">
            <table class="nm-admin-chat-table nm-pwd-recovery-table">
                <thead>
                    <tr>
                        <th><%= __('common_user') %></th>
                        <th><%= __('common_id_number') %></th>
                        <th><%= __('common_role_category') %></th>
                        <th><%= __('common_status') %></th>
                        <th><%= __('common_actions') %></th>
                    </tr>
                </thead>
                <tbody id="pwdRecoveryBody">
                    <% if (!hasSearch) { %>
                        <tr>
                            <td colspan="5" class="nm-admin-chat-empty">
                                <i class="fas fa-key" aria-hidden="true" style="font-size: 2rem; opacity: 0.15; display: block; margin-bottom: 10px; color: var(--primary);"></i>
                                <%= __('admin_password_recovery_empty_hint') %>
                            </td>
                        </tr>
                    <% } else if (!users || users.length === 0) { %>
                        <tr>
                            <td colspan="5" class="nm-admin-chat-empty">
                                <i class="fas fa-user-slash" aria-hidden="true" style="font-size: 2rem; opacity: 0.2; display: block; margin-bottom: 10px;"></i>
                                <%= __('admin_password_recovery_no_results') %>
                            </td>
                        </tr>
                    <% } %>
                    <% (users || []).forEach(function(u) { %>
                        <tr>
                            <td data-label="<%= __('common_user') %>">
                                <div class="nm-admin-pending-user">
                                    <img src="<%= userAvatar(u) %>" alt="" class="nm-admin-pending-user__avatar">
                                    <div>
                                        <div class="nm-admin-chat-name"><%= u.name %></div>
                                        <div class="nm-admin-chat-meta nm-pwd-recovery-email"><%= u.email %></div>
                                        <% if (u.phone) { %>
                                            <div class="nm-admin-chat-meta nm-admin-pending-user__phone"><%= u.phone %></div>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td data-label="<%= __('common_id_number') %>" class="nm-admin-pending-id">
                                <%= u.idNumber || __('common_not_available') %>
                            </td>
                            <td data-label="<%= __('common_role_category') %>">
                                <span class="badge badge-navy"><%= pwdRecoveryRoleLabel(u.role) %></span>
                            </td>
                            <td data-label="<%= __('common_status') %>">
                                <span class="nm-pwd-recovery-status nm-pwd-recovery-status--<%= u.status === 'active' ? 'active' : (u.status === 'suspended' ? 'suspended' : 'pending') %>">
                                    <%= pwdRecoveryStatusLabel(u.status) %>
                                </span>
                                <% if (u.mustChangePassword) { %>
                                    <span class="nm-pwd-recovery-pending-badge"><%= __('admin_password_recovery_pending_change') %></span>
                                <% } %>
                            </td>
                            <td data-label="<%= __('common_actions') %>">
                                <div class="nm-admin-pending-actions">
                                    <button type="button"
                                        class="btn-lux btn-lux-primary nm-admin-pending-actions__btn btn-issue-temp"
                                        data-user-id="<%= u._id %>"
                                        data-user-name="<%= u.name %>">
                                        <i class="fas fa-rotate" aria-hidden="true"></i> <%= __('admin_password_recovery_issue_btn') %>
                                    </button>
                                    <a href="/admin/users/<%= u._id %>/moderation" class="btn-lux btn-lux-outline nm-admin-pending-actions__btn">
                                        <i class="fas fa-eye" aria-hidden="true"></i> <%= __('common_details') %>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Issue temp password modal -->
<div id="tempPasswordModal" class="nm-pwd-recovery-modal" hidden>
    <div class="nm-admin-card nm-admin-modal-card nm-pwd-recovery-modal__card">
        <div class="nm-pwd-recovery-modal__header">
            <div class="nm-pwd-recovery-modal__icon" aria-hidden="true">
                <i class="fas fa-key"></i>
            </div>
            <div>
                <h4 class="font-cairo nm-pwd-recovery-modal__title" id="modalTitle"><%= __('admin_password_recovery_modal_title') %></h4>
                <p class="nm-pwd-recovery-modal__user" id="modalUserName"></p>
            </div>
        </div>

        <div id="modalFormSection">
            <label class="nm-pwd-recovery-modal__label" for="tempPasswordReason"><%= __('admin_password_recovery_reason_label') %></label>
            <textarea id="tempPasswordReason" class="form-input nm-pwd-recovery-modal__textarea" rows="4" placeholder="<%= __('admin_password_recovery_reason_placeholder') %>"></textarea>
            <p class="nm-pwd-recovery-modal__hint"><%= __('admin_password_recovery_reason_hint') %></p>

            <div class="nm-pwd-recovery-modal__actions">
                <button type="button" class="btn-lux btn-lux-outline" data-action="close-modal"><%= __('common_cancel') %></button>
                <button type="button" class="btn-lux btn-lux-primary" id="confirmIssueBtn">
                    <i class="fas fa-key" aria-hidden="true"></i> <%= __('admin_password_recovery_confirm_issue') %>
                </button>
            </div>
        </div>

        <div id="modalResultSection" hidden>
            <div class="nm-pwd-recovery-modal__result">
                <div class="nm-pwd-recovery-modal__result-label"><%= __('admin_password_recovery_temp_password_label') %></div>
                <div class="nm-pwd-recovery-modal__password-row">
                    <code id="generatedPassword" class="nm-pwd-recovery-modal__password"></code>
                    <button type="button" class="btn-lux btn-lux-navy" id="copyTempPasswordBtn">
                        <i class="fas fa-copy" aria-hidden="true"></i> <%= __('admin_password_recovery_copy') %>
                    </button>
                </div>
            </div>
            <p id="loginHintText" class="nm-pwd-recovery-modal__login-hint"></p>
            <p class="nm-pwd-recovery-modal__warning">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i> <%= __('admin_password_recovery_once_warning') %>
            </p>
            <div class="nm-pwd-recovery-modal__actions nm-pwd-recovery-modal__actions--end">
                <button type="button" class="btn-lux btn-lux-primary" data-action="close-modal-reload"><%= __('common_close') %></button>
            </div>
        </div>
    </div>
</div>

<style>
