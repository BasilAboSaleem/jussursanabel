<%- include('../../partials/admin-layout-top') %>

<div class="nm-admin-card nm-admin-page-header nm-admin-page-header--accent nm-admin-chat-requests">
    <h3 class="font-cairo" style="margin: 0;"><i class="fas fa-comments"></i> <%= __('admin_sidebar_chat_requests') %></h3>
    <p style="color: var(--text-muted); margin-top: 5px;"><%= __('admin_chat_requests_desc') %></p>
</div>

<div class="table-responsive nm-admin-chat-table-wrap">
    <table class="nm-admin-chat-table">
        <thead>
            <tr>
                <th><%= __('common_donor') %></th>
                <th><%= __('common_case_family') %></th>
                <th><%= __('common_date') %></th>
                <th><%= __('common_status') %></th>
                <th><%= __('common_actions') %></th>
            </tr>
        </thead>
        <tbody>
            <% if (requests.length === 0) { %>
                <tr>
                    <td colspan="5" class="nm-admin-chat-empty">
                        <%= __('admin_chat_requests_empty') %>
                    </td>
                </tr>
            <% } %>
            <% requests.forEach(req => { %>
                <tr>
                    <td data-label="<%= __('common_donor') %>">
                        <div class="nm-admin-chat-name"><%= req.donor.name %></div>
                        <div class="nm-admin-chat-meta"><%= req.donor.email %></div>
                    </td>
                    <td data-label="<%= __('common_case_family') %>">
                        <div class="nm-admin-chat-name"><%= req.case.title %></div>
                        <div class="nm-admin-chat-meta"><%= __('common_guardian_prefix') %><%= req.family.name %></div>
                    </td>
                    <td data-label="<%= __('common_date') %>" class="nm-admin-chat-date">
                        <%= req.createdAt.toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US') %>
                    </td>
                    <td data-label="<%= __('common_status') %>">
                        <span class="badge <%= 
                            req.status === 'approved' ? 'badge-success' : 
                            req.status === 'rejected' ? 'badge-danger' : 'badge-navy' 
                        %>">
                            <%= 
                                req.status === 'approved' ? __('common_approved_status') : 
                                req.status === 'rejected' ? __('common_rejected_status') : __('common_pending_review') 
                            %>
                        </span>
                        <% if (req.status === 'rejected' && req.adminComment) { %>
                            <div class="nm-admin-chat-meta" style="margin-top: 6px;"><%= req.adminComment %></div>
                        <% } %>
                    </td>
                    <td data-label="<%= __('common_actions') %>">
                        <form action="/admin/chat-requests/handle" method="POST" class="nm-admin-chat-form" data-request-id="<%= req._id %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="requestId" value="<%= req._id %>">
                            <select name="status" class="form-input nm-admin-chat-select" onchange="toggleRejectReason(this)">
                                <option value="approved" <%= req.status === 'approved' ? 'selected' : '' %>><%= __('common_approve') %></option>
                                <option value="rejected" <%= req.status === 'rejected' ? 'selected' : '' %>><%= __('common_reject') %></option>
                            </select>
                            <input type="text" name="adminComment" class="form-input nm-admin-chat-reason"
                                placeholder="<%= __('admin_chat_reject_reason_placeholder') %>"
                                value="<%= req.adminComment || '' %>"
                                style="display: <%= req.status === 'rejected' ? 'block' : 'none' %>;">
                            <button type="submit" class="btn-lux btn-lux-primary nm-admin-chat-submit"><%= __('common_update') %></button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<script>
    function toggleRejectReason(selectEl) {
        const form = selectEl.closest('form');
        const reasonInput = form && form.querySelector('.nm-admin-chat-reason');
        if (!reasonInput) return;
        reasonInput.style.display = selectEl.value === 'rejected' ? 'block' : 'none';
        if (selectEl.value !== 'rejected') reasonInput.value = '';
    }
</script>

<%- include('../../partials/admin-layout-bottom') %>
