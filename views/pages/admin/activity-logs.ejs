<%- include('../../partials/admin-layout-top') %>

<%
const updatedAt = new Date().toLocaleString(lang === 'ar' ? 'ar-SA' : 'en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
});
const currentAction = (query && query.action) ? query.action : 'all';
const pageCurrent = pagination ? pagination.currentPage : 1;
const pageTotal = pagination ? pagination.totalPages : 1;
const totalCount = pagination ? pagination.totalCount : logs.length;
const perPage = pagination ? pagination.perPage : 100;

function t(key, vars) {
    var text = __(key);
    if (!vars) return text;
    Object.keys(vars).forEach(function(k) {
        var val = vars[k];
        text = text.split('%{' + k + '}').join(val);
        text = text.split('{' + k + '}').join(val);
    });
    return text;
}

function activityLogsPageUrl(pageNum) {
    const params = new URLSearchParams();
    if (pageNum > 1) params.set('page', String(pageNum));
    if (query && query.search) params.set('search', query.search);
    if (query && query.action && query.action !== 'all') params.set('action', query.action);
    if (query && query.startDate) params.set('startDate', query.startDate);
    if (query && query.endDate) params.set('endDate', query.endDate);
    const qs = params.toString();
    return '/admin/activity-logs' + (qs ? '?' + qs : '');
}

function activityLogActionMeta(action) {
    const map = {
        login: { icon: 'fa-sign-in-alt', tone: 'indigo', label: __('admin_log_action_login') },
        logout: { icon: 'fa-sign-out-alt', tone: 'muted', label: __('admin_log_action_logout') },
        profile_update: { icon: 'fa-user-edit', tone: 'pink', label: __('admin_log_action_profile_update') },
        case_create: { icon: 'fa-plus-square', tone: 'green', label: __('admin_log_action_case_create') },
        case_update: { icon: 'fa-edit', tone: 'blue', label: __('admin_log_action_case_update') },
        case_delete: { icon: 'fa-trash', tone: 'danger', label: __('admin_log_action_case_delete') },
        transaction_create: { icon: 'fa-hand-holding-heart', tone: 'green', label: __('admin_log_action_transaction_create') },
        transaction_verify: { icon: 'fa-check-double', tone: 'green-dark', label: __('admin_log_action_transaction_verify') },
        user_moderate: { icon: 'fa-user-shield', tone: 'danger', label: __('admin_log_action_user_moderate') },
        user_activate: { icon: 'fa-user-check', tone: 'navy', label: __('admin_log_action_user_activate') },
        chat_request_create: { icon: 'fa-comments', tone: 'purple', label: __('admin_log_action_chat_open') },
        chat_request_handle: { icon: 'fa-comment-dots', tone: 'purple-dark', label: __('admin_log_action_chat_reply') },
        case_update_submit: { icon: 'fa-file-invoice', tone: 'navy', label: __('admin_log_action_impact_submit') },
        impact_proof_approve: { icon: 'fa-file-shield', tone: 'green', label: __('admin_log_action_impact_verify') },
        impact_proof_reject: { icon: 'fa-file-circle-xmark', tone: 'danger', label: __('admin_log_action_impact_reject') },
        admin_escalation_request: { icon: 'fa-tower-observation', tone: 'danger', label: __('admin_log_action_escalation') },
        admin_escalation_approved: { icon: 'fa-circle-check', tone: 'green', label: __('admin_log_action_escalation') },
        admin_escalation_rejected: { icon: 'fa-circle-xmark', tone: 'danger', label: __('admin_log_action_escalation') },
    };
    return map[action] || { icon: 'fa-cog', tone: 'muted', label: action };
}
%>

<div class="nm-activity-hub" style="text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
    <div class="nm-analytics-hub__meta nm-activity-hub__meta">
        <p class="nm-analytics-hub__desc"><%= __('admin_activity_logs_desc') %></p>
        <div class="nm-activity-hub__meta-aside">
            <span class="nm-activity-hub__stat" title="<%= t('admin_activity_logs_results_hint', { count: perPage }) %>">
                <strong><%= totalCount.toLocaleString() %></strong>
                <span><%= __('admin_activity_logs_total_label') %></span>
            </span>
            <div class="nm-analytics-hub__updated">
                <i class="fas fa-clock" aria-hidden="true"></i>
                <span><%= __('admin_analytics_last_update') %></span>
                <time datetime="<%= new Date().toISOString() %>"><%= updatedAt %></time>
            </div>
        </div>
    </div>

    <section class="nm-activity-hub__panel nm-admin-card nm-admin-card--flush">
        <div class="nm-activity-hub__filter-bar">
            <form action="/admin/activity-logs" method="GET" class="nm-activity-hub__filter-form">
                <div class="nm-activity-hub__search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search"
                        name="search"
                        class="form-input"
                        placeholder="<%= __('admin_activity_logs_search_placeholder') %>"
                        value="<%= query && query.search || '' %>"
                        aria-label="<%= __('admin_activity_logs_search_placeholder') %>">
                </div>

                <div class="nm-activity-hub__filter-field">
                    <label for="activityAction"><%= __('admin_activity_logs_type_label') %></label>
                    <select name="action" id="activityAction" class="form-input">
                        <option value="all" <%= currentAction === 'all' ? 'selected' : '' %>><%= __('common_all') %></option>
                        <option value="login" <%= currentAction === 'login' ? 'selected' : '' %>><%= __('admin_log_action_login') %></option>
                        <option value="case_create" <%= currentAction === 'case_create' ? 'selected' : '' %>><%= __('admin_log_action_case_create') %></option>
                        <option value="case_update" <%= currentAction === 'case_update' ? 'selected' : '' %>><%= __('admin_log_action_case_update') %></option>
                        <option value="transaction_create" <%= currentAction === 'transaction_create' ? 'selected' : '' %>><%= __('admin_log_action_transaction_create') %></option>
                        <option value="transaction_verify" <%= currentAction === 'transaction_verify' ? 'selected' : '' %>><%= __('admin_log_action_transaction_verify') %></option>
                        <option value="profile_update" <%= currentAction === 'profile_update' ? 'selected' : '' %>><%= __('admin_log_action_profile_update') %></option>
                        <option value="user_moderate" <%= currentAction === 'user_moderate' ? 'selected' : '' %>><%= __('admin_log_action_user_moderate') %></option>
                        <option value="user_activate" <%= currentAction === 'user_activate' ? 'selected' : '' %>><%= __('admin_log_action_user_activate') %></option>
                        <option value="chat_request_create" <%= currentAction === 'chat_request_create' ? 'selected' : '' %>><%= __('admin_log_action_chat_ticket_open') %></option>
                        <option value="impact_proof" <%= currentAction === 'impact_proof' ? 'selected' : '' %>><%= __('admin_log_action_impact_proof') %></option>
                        <option value="escalation" <%= currentAction === 'escalation' ? 'selected' : '' %>><%= __('admin_log_action_escalation') %></option>
                    </select>
                </div>

                <div class="nm-activity-hub__filter-field nm-activity-hub__filter-field--date">
                    <label for="activityStart"><%= __('common_from_date') %></label>
                    <input type="date" id="activityStart" name="startDate" class="form-input" value="<%= query.startDate || '' %>">
                </div>
                <div class="nm-activity-hub__filter-field nm-activity-hub__filter-field--date">
                    <label for="activityEnd"><%= __('common_to_date') %></label>
                    <input type="date" id="activityEnd" name="endDate" class="form-input" value="<%= query.endDate || '' %>">
                </div>

                <div class="nm-activity-hub__filter-actions">
                    <button type="submit" class="btn-lux btn-lux-primary">
                        <i class="fas fa-filter"></i> <%= __('common_apply_filter') %>
                    </button>
                    <a href="/admin/activity-logs" class="btn-lux btn-lux-outline" title="<%= __('common_reset') %>">
                        <i class="fas fa-redo"></i>
                    </a>
                </div>
            </form>
        </div>

        <div class="nm-activity-hub__table-wrap table-responsive">
            <table class="nm-activity-log-table">
                <thead>
                    <tr>
                        <th><%= __('common_time_date') %></th>
                        <th><%= __('common_user_admin') %></th>
                        <th><%= __('common_action') %></th>
                        <th><%= __('common_full_details') %></th>
                        <th class="nm-activity-log-table__id"><%= __('common_id') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                        <tr>
                            <td colspan="5" class="nm-activity-log-table__empty">
                                <i class="fas fa-ghost" aria-hidden="true"></i>
                                <p><%= __('admin_activity_logs_empty') %></p>
                            </td>
                        </tr>
                    <% } %>
                    <% logs.forEach(log => { %>
                        <% const actionMeta = activityLogActionMeta(log.action); %>
                        <tr class="nm-activity-log-table__row">
                            <td data-label="<%= __('common_time_date') %>">
                                <div class="nm-activity-log-table__date"><%= new Date(log.createdAt).toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US') %></div>
                                <div class="nm-activity-log-table__time"><%= new Date(log.createdAt).toLocaleTimeString(lang === 'ar' ? 'ar-EG' : 'en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></div>
                            </td>
                            <td data-label="<%= __('common_user_admin') %>">
                                <div class="nm-activity-log-table__user">
                                    <img src="<%= log.user ? userAvatar(log.user) : userAvatar({}) %>" alt="" class="nm-activity-log-table__avatar">
                                    <div>
                                        <div class="nm-activity-log-table__user-name"><%= log.user ? log.user.name : __('common_system_auto') %></div>
                                        <div class="nm-activity-log-table__user-email"><%= log.user ? log.user.email : 'system@jussur.org' %></div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="<%= __('common_action') %>">
                                <span class="nm-activity-log__badge nm-activity-log__badge--<%= actionMeta.tone %>">
                                    <i class="fas <%= actionMeta.icon %>" aria-hidden="true"></i>
                                    <%= actionMeta.label %>
                                </span>
                            </td>
                            <td data-label="<%= __('common_full_details') %>">
                                <p class="nm-activity-log-table__details"><%= log.details %></p>
                            </td>
                            <td data-label="<%= __('common_id') %>" class="nm-activity-log-table__id">
                                <% if (log.targetId) { %>
                                    <code class="nm-activity-log-table__code"><%= log.targetId.toString().slice(-8).toUpperCase() %></code>
                                <% } else { %>
                                    <span class="nm-activity-log-table__dash">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (pageTotal > 1) { %>
            <%
                const startPage = Math.max(1, pageCurrent - 2);
                const endPage = Math.min(pageTotal, pageCurrent + 2);
            %>
            <nav class="nm-activity-hub__pagination" aria-label="<%= t('admin_activity_logs_page_summary', { current: pageCurrent, total: pageTotal, shown: logs.length, totalCount: totalCount.toLocaleString() }) %>">
                <p class="nm-activity-hub__pagination-summary">
                    <%= t('admin_activity_logs_page_summary', { current: pageCurrent, total: pageTotal, shown: logs.length, totalCount: totalCount.toLocaleString() }) %>
                </p>
                <div class="nm-activity-hub__pagination-links">
                    <% if (pageCurrent > 1) { %>
                        <a href="<%= activityLogsPageUrl(pageCurrent - 1) %>" class="btn-lux btn-lux-outline nm-activity-hub__pagination-btn" aria-label="<%= __('common_prev') %>">
                            <i class="fas fa-chevron-<%= langDir === 'rtl' ? 'right' : 'left' %>"></i>
                        </a>
                    <% } %>

                    <% if (startPage > 1) { %>
                        <a href="<%= activityLogsPageUrl(1) %>" class="nm-activity-hub__pagination-num<%= pageCurrent === 1 ? ' is-active' : '' %>">1</a>
                        <% if (startPage > 2) { %>
                            <span class="nm-activity-hub__pagination-ellipsis">…</span>
                        <% } %>
                    <% } %>

                    <% for (let p = startPage; p <= endPage; p++) { %>
                        <a href="<%= activityLogsPageUrl(p) %>" class="nm-activity-hub__pagination-num<%= pageCurrent === p ? ' is-active' : '' %>"<%= pageCurrent === p ? ' aria-current="page"' : '' %>><%= p %></a>
                    <% } %>

                    <% if (endPage < pageTotal) { %>
                        <% if (endPage < pageTotal - 1) { %>
                            <span class="nm-activity-hub__pagination-ellipsis">…</span>
                        <% } %>
                        <a href="<%= activityLogsPageUrl(pageTotal) %>" class="nm-activity-hub__pagination-num<%= pageCurrent === pageTotal ? ' is-active' : '' %>"><%= pageTotal %></a>
                    <% } %>

                    <% if (pageCurrent < pageTotal) { %>
                        <a href="<%= activityLogsPageUrl(pageCurrent + 1) %>" class="btn-lux btn-lux-outline nm-activity-hub__pagination-btn" aria-label="<%= __('common_next') %>">
                            <i class="fas fa-chevron-<%= langDir === 'rtl' ? 'left' : 'right' %>"></i>
                        </a>
                    <% } %>
                </div>
            </nav>
        <% } %>
    </section>
</div>

<%- include('../../partials/admin-layout-bottom') %>
