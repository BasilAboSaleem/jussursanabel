<%- include('../../partials/admin-layout-top') %>

<%
function allUsersUrl(overrides) {
    const f = {
        role: filters.role || 'all',
        caseType: filters.caseType || 'all',
        status: filters.status || 'all',
        donorType: filters.donorType || 'all',
    };
    if (overrides) Object.assign(f, overrides);
    const params = new URLSearchParams();
    if (f.role !== 'all') params.set('role', f.role);
    if (f.caseType !== 'all') params.set('caseType', f.caseType);
    if (f.status !== 'all') params.set('status', f.status);
    if (f.donorType !== 'all') params.set('donorType', f.donorType);
    const qs = params.toString();
    return '/admin/all-users' + (qs ? '?' + qs : '');
}

const roleFilters = [
    { key: 'all', href: allUsersUrl({ role: 'all', caseType: 'all', donorType: 'all' }), label: __('common_all'), count: roleCounts.all },
    { key: 'donor', href: allUsersUrl({ role: 'donor', caseType: 'all' }), label: __('admin_all_users_filter_donor_short'), title: __('common_donors'), count: roleCounts.donor, dot: 'field' },
    { key: 'beneficiary', href: allUsersUrl({ role: 'beneficiary', donorType: 'all' }), label: __('admin_all_users_filter_beneficiary_short'), title: __('common_beneficiaries'), count: roleCounts.beneficiary, dot: 'media' },
];

const statusFilters = [
    { key: 'all', href: allUsersUrl({ status: 'all' }), label: __('common_all'), count: statusCounts.all },
    { key: 'active', href: allUsersUrl({ status: 'active' }), label: __('common_status_active'), count: statusCounts.active, dot: 'approved' },
    { key: 'pending', href: allUsersUrl({ status: 'pending' }), label: __('common_status_pending'), count: statusCounts.pending, dot: 'pending' },
    { key: 'suspended', href: allUsersUrl({ status: 'suspended' }), label: __('common_status_suspended'), count: statusCounts.suspended, dot: 'rejected' },
];

const caseTypeFilters = [
    { key: 'all', href: allUsersUrl({ caseType: 'all' }), label: __('common_all') },
    { key: 'orphan', href: allUsersUrl({ caseType: 'orphan' }), label: __('common_orphans') },
    { key: 'family', href: allUsersUrl({ caseType: 'family' }), label: __('common_families') },
];

const donorTypeFilters = [
    { key: 'all', href: allUsersUrl({ donorType: 'all' }), label: __('common_all') },
    { key: 'verified', href: allUsersUrl({ role: 'donor', donorType: 'verified', caseType: 'all' }), label: __('admin_all_users_filter_verified_short'), title: __('common_verified_donor') },
    { key: 'new', href: allUsersUrl({ role: 'donor', donorType: 'new', caseType: 'all' }), label: __('admin_all_users_filter_new_short'), title: __('common_new_donor') },
];

function allUsersRoleLabel(role) {
    if (role === 'donor') return __('common_donor');
    if (role === 'family') return __('common_family');
    if (role === 'guardian') return __('common_orphan_guardian');
    return __('common_beneficiary');
}

function allUsersStatusLabel(status) {
    if (status === 'active') return __('common_status_active');
    if (status === 'suspended') return __('common_status_suspended');
    return __('common_pending');
}
%>

<div class="nm-all-users-hub">
    <div class="nm-analytics-hub__meta nm-all-users-hub__meta">
        <p class="nm-analytics-hub__desc"><%= __('admin_all_users_desc') %></p>
        <div class="nm-all-users-hub__meta-aside">
            <span class="nm-activity-hub__stat" title="<%= __('admin_all_users_total_count') %>">
                <strong><%= roleCounts.all.toLocaleString() %></strong>
                <span><%= __('common_all') %></span>
            </span>
            <span class="nm-activity-hub__stat" title="<%= __('admin_all_users_stat_donors_short') %>">
                <strong><%= roleCounts.donor.toLocaleString() %></strong>
                <span><%= __('admin_all_users_stat_donors_short') %></span>
            </span>
            <span class="nm-activity-hub__stat" title="<%= __('admin_all_users_stat_beneficiaries_short') %>">
                <strong><%= roleCounts.beneficiary.toLocaleString() %></strong>
                <span><%= __('admin_all_users_stat_beneficiaries_short') %></span>
            </span>
            <% if (user && user.role === 'super_admin') { %>
                <a href="/admin/password-recovery" class="nm-all-users-hub__pwd-link btn-lux btn-lux-outline">
                    <i class="fas fa-key" aria-hidden="true"></i> <%= __('admin_all_users_password_recovery_btn') %>
                </a>
            <% } %>
        </div>
    </div>

    <div class="nm-admin-hub nm-admin-card nm-admin-card--flush">
        <div class="nm-admin-hub__toolbar">
            <div class="nm-admin-hub__search">
                <i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" id="allUsersSearch" oninput="filterAllUsers()" placeholder="<%= __('admin_all_users_search_placeholder') %>" autocomplete="off" aria-label="<%= __('admin_all_users_search_placeholder') %>">
            </div>

            <div class="nm-admin-hub__filters" role="tablist" aria-label="<%= __('admin_all_users_filter_label') %>">
                <% roleFilters.forEach((f) => { %>
                <a href="<%= f.href %>"
                   class="nm-admin-hub__filter<%= filters.role === f.key ? ' is-active' : '' %>"
                   role="tab"
                   aria-selected="<%= filters.role === f.key ? 'true' : 'false' %>"
                   <% if (f.title) { %>title="<%= f.title %>"<% } %>>
                    <% if (f.key === 'all') { %>
                        <i class="fas fa-layer-group" aria-hidden="true"></i>
                    <% } else { %>
                        <span class="nm-admin-hub__filter-dot nm-admin-hub__filter-dot--<%= f.dot %>" aria-hidden="true"></span>
                    <% } %>
                    <span><%= f.label %></span>
                    <em><%= f.count %></em>
                </a>
                <% }) %>
            </div>
        </div>

        <div class="nm-all-users-hub__subfilters">
            <div class="nm-admin-hub__filters nm-all-users-hub__status-filters" role="tablist" aria-label="<%= __('admin_all_users_filter_status_label') %>">
                <% statusFilters.forEach((f) => { %>
                <a href="<%= f.href %>"
                   class="nm-admin-hub__filter nm-admin-hub__filter--compact<%= filters.status === f.key ? ' is-active' : '' %>"
                   role="tab"
                   aria-selected="<%= filters.status === f.key ? 'true' : 'false' %>">
                    <% if (f.dot) { %><span class="nm-admin-hub__filter-dot nm-admin-hub__filter-dot--<%= f.dot %>" aria-hidden="true"></span><% } %>
                    <span><%= f.label %></span>
                    <em><%= f.count %></em>
                </a>
                <% }) %>
            </div>

            <% if (filters.role === 'beneficiary') { %>
            <div class="nm-admin-hub__filters nm-all-users-hub__extra-filters" role="tablist" aria-label="<%= __('admin_all_users_filter_case_type') %>">
                <% caseTypeFilters.forEach((f) => { %>
                <a href="<%= f.href %>"
                   class="nm-admin-hub__filter nm-admin-hub__filter--compact<%= filters.caseType === f.key ? ' is-active' : '' %>"
                   role="tab"
                   aria-selected="<%= filters.caseType === f.key ? 'true' : 'false' %>">
                    <span><%= f.label %></span>
                </a>
                <% }) %>
            </div>
            <% } else if (filters.role === 'donor' || filters.donorType !== 'all') { %>
            <div class="nm-admin-hub__filters nm-all-users-hub__extra-filters" role="tablist" aria-label="<%= __('admin_all_users_filter_donor_type') %>">
                <% donorTypeFilters.forEach((f) => { %>
                <a href="<%= f.href %>"
                   class="nm-admin-hub__filter nm-admin-hub__filter--compact<%= filters.donorType === f.key ? ' is-active' : '' %>"
                   role="tab"
                   aria-selected="<%= filters.donorType === f.key ? 'true' : 'false' %>"
                   <% if (f.title) { %>title="<%= f.title %>"<% } %>>
                    <span><%= f.label %></span>
                </a>
                <% }) %>
            </div>
            <% } %>
        </div>

        <div class="table-responsive nm-admin-chat-table-wrap">
            <table class="nm-admin-chat-table nm-all-users-table">
                <thead>
                    <tr>
                        <th><%= __('common_user') %></th>
                        <th><%= __('admin_all_users_col_role') %></th>
                        <th><%= __('admin_all_users_col_case') %></th>
                        <th><%= __('common_account_status') %></th>
                        <th><%= __('common_registration_date') %></th>
                        <th><%= __('common_actions') %></th>
                    </tr>
                </thead>
                <tbody id="allUsersBody">
                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="6" class="nm-admin-chat-empty">
                                <i class="fas fa-search-minus" aria-hidden="true" style="font-size: 2rem; opacity: 0.2; display: block; margin-bottom: 10px;"></i>
                                <%= __('admin_all_users_empty') %>
                            </td>
                        </tr>
                    <% } %>
                    <% users.forEach(u => { %>
                        <tr class="all-users-row"
                            data-name="<%= (u.name || '').toLowerCase() %>"
                            data-email="<%= (u.email || '').toLowerCase() %>"
                            data-phone="<%= (u.phone || '').toLowerCase() %>"
                            data-id="<%= (u.idNumber || '').toLowerCase() %>"
                            data-case="<%= u.case ? (u.case.title || '').toLowerCase() : '' %>">
                            <td data-label="<%= __('common_user') %>">
                                <div class="nm-admin-pending-user">
                                    <img src="<%= userAvatar(u) %>" alt="" class="nm-admin-pending-user__avatar">
                                    <div>
                                        <div class="nm-admin-chat-name"><%= u.name %></div>
                                        <div class="nm-admin-chat-meta"><%= u.email %></div>
                                        <% if (u.phone) { %>
                                            <div class="nm-admin-chat-meta"><%= u.phone %></div>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td data-label="<%= __('admin_all_users_col_role') %>">
                                <% if (u.role === 'donor') { %>
                                    <span class="badge badge-teal nm-all-users-role">
                                        <%= __('common_donor') %>
                                        <% if (u.isVerifiedDonor) { %>
                                            <i class="fas fa-star all-users-role-badge__star" title="<%= __('common_verified_donor') %>" aria-label="<%= __('common_verified_donor') %>"></i>
                                        <% } %>
                                    </span>
                                <% } else { %>
                                    <span class="all-users-role-badge all-users-role-badge--beneficiary"><%= allUsersRoleLabel(u.role) %></span>
                                <% } %>
                            </td>
                            <td data-label="<%= __('admin_all_users_col_case') %>">
                                <% if (u.case) { %>
                                    <a href="/cases/<%= u.case._id %>" class="nm-all-users-case-link">
                                        <%= u.case.title.length > 28 ? u.case.title.substring(0, 28) + '…' : u.case.title %>
                                    </a>
                                <% } else { %>
                                    <span class="nm-admin-chat-meta">—</span>
                                <% } %>
                            </td>
                            <td data-label="<%= __('common_account_status') %>">
                                <span class="badge <%= u.status === 'active' ? 'badge-teal' : (u.status === 'suspended' ? 'badge-danger' : 'badge-gold') %>">
                                    <%= allUsersStatusLabel(u.status) %>
                                </span>
                            </td>
                            <td data-label="<%= __('common_registration_date') %>" class="nm-admin-chat-date">
                                <div><%= u.createdAt.toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US') %></div>
                                <div class="nm-admin-chat-meta"><%= u.createdAt.toLocaleTimeString(lang === 'ar' ? 'ar-EG' : 'en-US', { hour: '2-digit', minute: '2-digit' }) %></div>
                            </td>
                            <td data-label="<%= __('common_actions') %>">
                                <div class="nm-admin-pending-actions">
                                    <button type="button"
                                        class="btn-lux btn-lux-outline nm-admin-pending-actions__btn nm-admin-pending-actions__btn--danger all-users-mod-btn"
                                        data-user-id="<%= u._id %>"
                                        data-user-name="<%= encodeURIComponent(u.name || '') %>">
                                        <i class="fas fa-gavel"></i> <%= __('admin_all_users_btn_mod') %>
                                    </button>
                                    <a href="/admin/users/<%= u._id %>/moderation" class="btn-lux btn-lux-navy nm-admin-pending-actions__btn">
                                        <i class="fas fa-shield-halved"></i> <%= __('admin_all_users_btn_full_mod') %>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <p class="nm-admin-hub__no-results" id="allUsersNoResults" hidden><%= __('admin_all_users_no_results') %></p>
        </div>
    </div>
</div>

<!-- Moderation Dialog -->
<div id="moderationModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="nm-admin-card nm-admin-modal-card">
        <h5 class="font-cairo" style="margin-bottom: 15px; font-weight: 800;"><%= __('admin_all_users_mod_modal_title') %></h5>
        <div id="userInfoShort" style="margin-bottom: 15px; padding: 12px; background: #f8fafc; border-radius: 12px; font-size: 0.85rem; font-weight: 700;"></div>
        
        <div style="margin-bottom: 15px;">
            <label style="display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 8px;"><%= __('admin_all_users_mod_label_action') %></label>
            <select id="modAction" class="form-control" style="border-radius: 12px; height: 45px;" onchange="updateModUI()">
                <option value="note"><%= __('admin_mod_action_note') %></option>
                <option value="warning"><%= __('admin_mod_action_warning') %></option>
                <option value="ban_user_specific" id="opt-ban-specific"><%= __('admin_mod_action_ban_specific') %></option>
                <% if (user && user.role === 'super_admin') { %>
                    <option value="ban_global_comm" class="full-mod"><%= __('admin_mod_action_ban_global') %></option>
                    <option value="ban" class="full-mod"><%= __('admin_mod_action_suspend') %></option>
                    <option value="soft_delete" class="full-mod"><%= __('admin_mod_action_soft_delete') %></option>
                    <option value="hard_delete" class="full-mod"><%= __('admin_mod_action_hard_delete') %></option>
                    <option value="undo_warning"><%= __('admin_mod_action_undo_warning') %></option>
                    <option value="undo_ban_global_comm"><%= __('admin_mod_action_undo_ban_global') %></option>
                    <option value="undo_soft_delete"><%= __('admin_mod_action_undo_soft_delete') %></option>
                <% } %>
            </select>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 8px;" id="noteLabel"><%= __('common_details_reason') %></label>
            <textarea id="modNote" rows="4" style="width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 0.9rem; resize: none;" placeholder="<%= __('admin_all_users_mod_placeholder_note') %>"></textarea>
        </div>

        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button class="btn-lux btn-lux-outline" onclick="closeModDialog()"><%= __('common_cancel') %></button>
            <button class="btn-lux btn-lux-primary" id="confirmModBtn" onclick="submitModeration()"><%= __('common_confirm_action') %></button>
        </div>

        <% if (user && user.role !== 'super_admin') { %>
        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px dashed #e2e8f0;">
            <div style="font-size: 0.8rem; color: #94a3b8; text-align: center; margin-bottom: 12px;"><%= __('admin_all_users_mod_super_admin_notice') %></div>
            <button class="btn-lux btn-lux-danger" style="width: 100%; opacity: 0.8;" onclick="openEscalationForm()">
                <i class="fas fa-tower-observation"></i> <%= __('admin_all_users_btn_escalate') %>
            </button>
        </div>
        <% } %>
    </div>
</div>

<!-- Escalation Request Modal (Admins only) -->
<div id="escalationModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:1001; align-items:center; justify-content:center;">
    <div class="nm-admin-card nm-admin-modal-card nm-admin-modal-card--danger">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
            <div style="width:50px;height:50px;background:#fee2e2;border-radius:15px;display:flex;align-items:center;justify-content:center;color:#ef4444;font-size:1.4rem;">
                <i class="fas fa-tower-observation"></i>
            </div>
            <div>
                <h5 class="font-cairo" style="margin:0;font-weight:800;color:#991b1b;"><%= __('admin_escalation_modal_title') %></h5>
                <p style="margin:0;font-size:0.8rem;color:#94a3b8;"><%= __('admin_escalation_modal_desc') %></p>
            </div>
        </div>

        <form action="/admin/escalations/submit" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="targetUser" id="escalationTargetUserId" value="">

            <div class="form-group mb-3">
                <label style="font-weight:800;color:var(--primary);display:block;margin-bottom:8px;"><%= __('admin_escalation_label_type') %></label>
                <select name="type" class="form-input" required>
                    <option value="hard_delete_user"><%= __('admin_escalation_type_hard_delete') %></option>
                    <option value="change_role"><%= __('admin_escalation_type_role') %></option>
                    <option value="other"><%= __('admin_escalation_type_other') %></option>
                </select>
            </div>

            <div class="form-group mb-4">
                <label style="font-weight:800;color:var(--primary);display:block;margin-bottom:8px;"><%= __('admin_escalation_label_reason') %> <span style="color:#ef4444;">*</span></label>
                <textarea name="reason" rows="4" class="form-input" placeholder="<%= __('admin_escalation_placeholder_reason') %>" required></textarea>
            </div>

            <div style="display:flex;gap:10px;">
                <button type="button" class="btn-lux btn-lux-outline" style="flex:1;" onclick="closeEscalationModal()"><%= __('common_cancel') %></button>
                <button type="submit" class="btn-lux btn-lux-danger" style="flex:2;">
                    <i class="fas fa-paper-plane"></i> <%= __('admin_escalation_btn_submit') %>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .nm-all-users-hub {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 24px;
        text-align: start;
    }

    .nm-all-users-hub__meta.nm-analytics-hub__meta {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .nm-all-users-hub__meta-aside {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .nm-all-users-hub__pwd-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        font-weight: 700;
        font-size: 0.82rem;
        padding: 8px 14px !important;
