    .nm-all-users-table {
        text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;
    }

    .nm-admin-pending-user {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .nm-admin-pending-user__avatar {
        width: 42px;
        height: 42px;
