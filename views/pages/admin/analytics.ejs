        pointer-events: none;
    }
    .analytics-impact-section--pending .analytics-impact-section__glow {
        background: radial-gradient(circle at 0% 0%, rgba(0, 165, 68, 0.22), transparent 45%), radial-gradient(circle at 100% 100%, rgba(234, 88, 12, 0.1), transparent 38%);
    }
    .analytics-impact-section__inner {
        position: relative; padding: 20px;
        background: linear-gradient(135deg, #fff 0%, #f8fafc 55%, #f0fdf4 100%);
        border: 1px solid rgba(0, 38, 97, 0.08); border-radius: 18px;
        box-shadow: 0 12px 36px rgba(2, 26, 15, 0.05);
    }
    .analytics-impact-section--pending .analytics-impact-section__inner { border-color: rgba(0, 165, 68, 0.18); }
    .analytics-impact-section__header {
        display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;
        margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px dashed rgba(0, 38, 97, 0.1);
    }
    .analytics-impact-section__intro { display: flex; gap: 14px; align-items: flex-start; flex: 1; min-width: 240px; }
    .analytics-impact-section__icon {
        width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
        font-size: 1.15rem; color: #016630; background: linear-gradient(135deg, rgba(0, 165, 68, 0.16), rgba(0, 165, 68, 0.06));
        border: 1px solid rgba(0, 165, 68, 0.2); flex-shrink: 0;
