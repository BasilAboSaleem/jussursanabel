    .analytics-impact-section__cta {
        display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px !important;
        border-radius: 12px !important; font-weight: 800; text-decoration: none; white-space: nowrap;
    }
    .impact-workflow { margin-bottom: 18px; padding: 16px; border-radius: 14px; background: rgba(255,255,255,0.72); border: 1px solid rgba(0,38,97,0.08); }
    .analytics-impact-section__queue-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
    .analytics-impact-section__queue-title { margin: 0; font-size: 0.95rem; font-weight: 900; color: var(--primary); }
    .analytics-impact-section__queue-badge { padding: 4px 10px; border-radius: 999px; background: #fff7ed; color: #ea580c; font-size: 0.72rem; font-weight: 800; border: 1px solid #fed7aa; }
    .analytics-impact-section__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
    .analytics-impact-card {
