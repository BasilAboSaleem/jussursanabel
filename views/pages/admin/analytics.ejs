<%- include('../../partials/admin-layout-top') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<%
const totalReqs = stats.chatReqStats.reduce((a, b) => a + b.count, 0);
const approvedReqs = stats.chatReqStats.find(s => s._id === 'approved')?.count || 0;
const approvalRate = totalReqs > 0 ? ((approvedReqs / totalReqs) * 100).toFixed(0) : 0;
const updatedAt = new Date().toLocaleString(lang === 'ar' ? 'ar-SA' : 'en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
});
%>

<div class="nm-analytics-hub">
    <div class="nm-analytics-hub__meta">
        <p class="nm-analytics-hub__desc"><%= __('admin_analytics_desc') %></p>
        <div class="nm-analytics-hub__updated">
            <i class="fas fa-clock" aria-hidden="true"></i>
            <span><%= __('admin_analytics_last_update') %></span>
            <time datetime="<%= new Date().toISOString() %>"><%= updatedAt %></time>
        </div>
    </div>

    <div class="nm-analytics-hub__kpis">
        <article class="nm-admin-card nm-analytics-hub__kpi nm-analytics-hub__kpi--featured">
            <span class="nm-analytics-hub__kpi-icon" aria-hidden="true"><i class="fas fa-coins"></i></span>
            <div class="nm-analytics-hub__kpi-value">$<%= stats.kpis.total.toLocaleString() %></div>
            <div class="nm-analytics-hub__kpi-label"><%= __('admin_analytics_total_donations') %></div>
            <span class="nm-analytics-hub__kpi-hint nm-analytics-hub__kpi-hint--up"><i class="fas fa-arrow-up"></i> <%= stats.kpis.count %> <%= __('admin_analytics_successful_ops') %></span>
        </article>
        <article class="nm-admin-card nm-analytics-hub__kpi nm-admin-stat-card nm-admin-stat-card--accent">
            <span class="nm-analytics-hub__kpi-icon nm-analytics-hub__kpi-icon--orange" aria-hidden="true"><i class="fas fa-repeat"></i></span>
            <div class="nm-analytics-hub__kpi-value"><%= stats.activeSponsorships %></div>
            <div class="nm-analytics-hub__kpi-label"><%= __('admin_analytics_active_sponsorships') %></div>
            <span class="nm-analytics-hub__kpi-hint"><%= __('admin_analytics_sustainable_support') %></span>
        </article>
        <article class="nm-admin-card nm-analytics-hub__kpi nm-admin-stat-card nm-admin-stat-card--green">
            <span class="nm-analytics-hub__kpi-icon nm-analytics-hub__kpi-icon--green" aria-hidden="true"><i class="fas fa-check-double"></i></span>
            <div class="nm-analytics-hub__kpi-value"><%= stats.satisfactionRate %>%</div>
            <div class="nm-analytics-hub__kpi-label"><%= __('admin_analytics_satisfaction_rate') %></div>
            <span class="nm-analytics-hub__kpi-hint"><%= __('admin_analytics_total_published') %></span>
        </article>
        <article class="nm-admin-card nm-analytics-hub__kpi nm-admin-stat-card">
            <span class="nm-analytics-hub__kpi-icon nm-analytics-hub__kpi-icon--pink" aria-hidden="true"><i class="fas fa-bolt"></i></span>
            <div class="nm-analytics-hub__kpi-value"><%= stats.activityVol %></div>
            <div class="nm-analytics-hub__kpi-label"><%= __('admin_analytics_platform_activity_30d') %></div>
            <span class="nm-analytics-hub__kpi-hint"><%= __('admin_analytics_admin_interaction') %></span>
        </article>
    </div>

    <section class="nm-analytics-hub__section analytics-impact-section<%= pendingImpactProofsCount > 0 ? ' analytics-impact-section--pending' : '' %>" aria-labelledby="analytics-impact-heading" style="text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
        <div class="analytics-impact-section__glow" aria-hidden="true"></div>
        <div class="analytics-impact-section__inner">
            <header class="analytics-impact-section__header">
                <div class="analytics-impact-section__intro">
                    <div class="analytics-impact-section__icon" aria-hidden="true"><i class="fas fa-file-shield"></i></div>
                    <div>
                        <h3 id="analytics-impact-heading" class="font-cairo analytics-impact-section__title"><%= __('admin_analytics_impact_title') %></h3>
                        <p class="analytics-impact-section__desc"><%= __('admin_analytics_impact_desc') %></p>
                    </div>
                </div>
                <div class="analytics-impact-section__meta">
                    <div class="analytics-impact-section__stat">
                        <span class="analytics-impact-section__stat-value"><%= pendingImpactProofsCount %></span>
                        <span class="analytics-impact-section__stat-label"><%= __('admin_analytics_impact_pending_label') %></span>
                    </div>
                    <a href="/admin/pending-impact-proofs" class="analytics-impact-section__cta btn-lux btn-lux-primary">
                        <span><%= __('admin_analytics_impact_view_all') %></span>
                        <i class="fas fa-arrow-<%= langDir === 'rtl' ? 'left' : 'right' %>"></i>
                    </a>
                </div>
            </header>

            <%- include('../../partials/admin-impact-workflow') %>

            <% if (pendingImpactProofs && pendingImpactProofs.length > 0) { %>
                <div class="analytics-impact-section__queue-head">
                    <h4 class="font-cairo analytics-impact-section__queue-title"><%= __('admin_impact_workflow_queue_title') %></h4>
                    <span class="analytics-impact-section__queue-badge"><%= pendingImpactProofsCount %> <%= __('admin_impact_workflow_queue_badge') %></span>
                </div>
                <div class="analytics-impact-section__grid">
                    <% pendingImpactProofs.forEach(function(proof) { %>
                        <article class="analytics-impact-card" id="impact-proof-<%= proof._id %>">
                            <% if (proof.images && proof.images.length > 0) { %>
                                <div class="analytics-impact-card__media" style="background-image: url('<%= proof.images[0] %>');"></div>
                            <% } else { %>
                                <div class="analytics-impact-card__media analytics-impact-card__media--empty"><i class="fas fa-image"></i></div>
                            <% } %>
                            <div class="analytics-impact-card__body">
                                <% if (proof.case && proof.case.title) { %>
                                    <span class="analytics-impact-card__case"><%= proof.case.title %></span>
                                <% } %>
                                <h4 class="font-cairo analytics-impact-card__title"><%= proof.title %></h4>
                                <p class="analytics-impact-card__excerpt"><%= proof.content %></p>
                                <div class="analytics-impact-card__footer">
                                    <span><i class="fas fa-user-shield"></i> <%= proof.guardian ? proof.guardian.name : '—' %></span>
                                    <span><i class="far fa-clock"></i> <%= new Date(proof.createdAt).toLocaleDateString(lang === 'ar' ? 'ar-SA' : 'en-US') %></span>
                                </div>
                                <div class="analytics-impact-card__actions">
                                    <form action="/admin/impact-proofs/<%= proof._id %>/approve" method="POST" class="analytics-impact-card__action-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="returnTo" value="/admin/analytics">
                                        <button type="submit" class="btn-lux btn-lux-primary analytics-impact-card__btn"><i class="fas fa-check"></i> <%= __('common_approve_publish') %></button>
                                    </form>
                                    <button type="button" class="btn-lux btn-lux-outline analytics-impact-card__btn" onclick="toggleImpactReject('<%= proof._id %>')"><i class="fas fa-times"></i> <%= __('common_reject') %></button>
                                </div>
                                <div id="impact-reject-<%= proof._id %>" class="analytics-impact-card__reject" hidden>
                                    <form action="/admin/impact-proofs/<%= proof._id %>/reject" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="returnTo" value="/admin/analytics">
                                        <textarea name="rejectionReason" required class="form-input content-mgmt-textarea" rows="2" placeholder="<%= __('admin_impact_rejection_placeholder') %>"></textarea>
                                        <button type="submit" class="btn-lux btn-lux-danger analytics-impact-card__btn analytics-impact-card__btn--full"><%= __('admin_impact_confirm_rejection') %></button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="analytics-impact-section__empty">
                    <div class="analytics-impact-section__empty-icon" aria-hidden="true"><i class="fas fa-clipboard-check"></i></div>
                    <div>
                        <strong class="font-cairo"><%= __('admin_impact_no_pending') %></strong>
                        <p><%= __('admin_analytics_impact_empty_desc') %></p>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <section class="nm-analytics-hub__section" aria-labelledby="analytics-financial-heading">
        <header class="nm-analytics-hub__section-head">
            <h3 id="analytics-financial-heading" class="font-cairo"><i class="fas fa-chart-line"></i> <%= __('admin_analytics_section_financial') %></h3>
        </header>
        <div class="nm-analytics-hub__grid nm-analytics-hub__grid--2-1">
            <article class="nm-admin-card nm-analytics-hub__chart-card">
                <header class="nm-analytics-hub__chart-head">
                    <h4 class="font-cairo"><%= __('admin_analytics_revenue_timeline') %></h4>
                    <span class="nm-analytics-hub__badge"><%= __('admin_analytics_last_12m') %></span>
                </header>
                <div class="nm-analytics-hub__chart-body nm-analytics-hub__chart-body--tall">
                    <canvas id="revenueChart"></canvas>
                </div>
            </article>
            <article class="nm-admin-card nm-analytics-hub__chart-card">
                <header class="nm-analytics-hub__chart-head">
                    <h4 class="font-cairo"><%= __('admin_analytics_donation_structure') %></h4>
                </header>
                <div class="nm-analytics-hub__chart-body nm-analytics-hub__chart-body--medium">
                    <canvas id="typeChart"></canvas>
                </div>
                <footer class="nm-analytics-hub__chart-foot">
                    <div>
                        <span><%= __('admin_analytics_fees_collected') %></span>
                        <small><%= __('admin_analytics_fees_note_short') %></small>
                    </div>
                    <strong>$<%= stats.kpis.fees.toLocaleString() %></strong>
                </footer>
            </article>
        </div>
    </section>

    <section class="nm-analytics-hub__section" aria-labelledby="analytics-demo-heading">
        <header class="nm-analytics-hub__section-head">
            <h3 id="analytics-demo-heading" class="font-cairo"><i class="fas fa-chart-pie"></i> <%= __('admin_analytics_section_demographics') %></h3>
        </header>
        <div class="nm-analytics-hub__grid nm-analytics-hub__grid--3">
            <article class="nm-admin-card nm-analytics-hub__chart-card">
                <header class="nm-analytics-hub__chart-head"><h5 class="font-cairo"><%= __('admin_analytics_user_distribution') %></h5></header>
                <div class="nm-analytics-hub__chart-body nm-analytics-hub__chart-body--medium"><canvas id="userDistChart"></canvas></div>
            </article>
            <article class="nm-admin-card nm-analytics-hub__chart-card">
                <header class="nm-analytics-hub__chart-head"><h5 class="font-cairo"><%= __('admin_analytics_case_status') %></h5></header>
                <div class="nm-analytics-hub__chart-body nm-analytics-hub__chart-body--medium"><canvas id="caseStatusChart"></canvas></div>
            </article>
            <article class="nm-admin-card nm-analytics-hub__chart-card">
                <header class="nm-analytics-hub__chart-head"><h5 class="font-cairo"><%= __('admin_analytics_geo_distribution') %></h5></header>
                <div class="nm-analytics-hub__chart-body nm-analytics-hub__chart-body--medium"><canvas id="locationChart"></canvas></div>
            </article>
        </div>
    </section>

    <section class="nm-analytics-hub__section" aria-labelledby="analytics-engage-heading">
        <header class="nm-analytics-hub__section-head">
            <h3 id="analytics-engage-heading" class="font-cairo"><i class="fas fa-users"></i> <%= __('admin_analytics_section_engagement') %></h3>
        </header>
        <div class="nm-analytics-hub__grid nm-analytics-hub__grid--2">
            <article class="nm-admin-card nm-analytics-hub__chart-card nm-admin-card--flush">
                <header class="nm-analytics-hub__chart-head" style="padding-inline: 18px; padding-top: 18px;">
                    <h4 class="font-cairo"><i class="fas fa-trophy" style="color: var(--secondary);"></i> <%= __('admin_analytics_top_donors_title') %></h4>
                </header>
                <div class="nm-analytics-hub__table-wrap">
                    <table class="nm-analytics-hub__table" style="text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
                        <thead>
                            <tr>
                                <th><%= __('common_donor') %></th>
                                <th><%= __('common_contributions_count') %></th>
                                <th style="text-align: <%= langDir === 'rtl' ? 'left' : 'right' %>;"><%= __('common_total_donations') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!stats.topDonors.length) { %>
                                <tr>
                                    <td colspan="3" style="text-align: center; color: #94a3b8; padding: 28px;"><%= __('common_no_data') %></td>
                                </tr>
                            <% } %>
                            <% stats.topDonors.forEach(donor => { %>
                                <tr>
                                    <td>
                                        <div class="nm-analytics-hub__donor">
                                            <img src="<%= userAvatar(donor.donorDetails) %>" alt="">
                                            <div>
                                                <strong><%= donor.donorDetails.name %></strong>
                                                <span><%= donor.donorDetails.email %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="nm-analytics-hub__pill"><%= donor.count %> <%= __('common_donation') %></span></td>
                                    <td style="text-align: <%= langDir === 'rtl' ? 'left' : 'right' %>;"><span class="nm-analytics-hub__amount">$<%= donor.totalDonated.toLocaleString() %></span></td>
                                </tr>
                            <% }) %>
