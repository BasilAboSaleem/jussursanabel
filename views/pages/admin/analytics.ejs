<%- include('../../partials/admin-layout-top') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="analytics-container" style="padding-bottom: 50px;">
    <!-- Header with context -->
    <!-- Header with context -->
    <div class="responsive-stack" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
        <div>
            <h2 class="font-cairo" style="margin: 0; color: var(--primary); font-weight: 900; font-size: 2.2rem;"><%= __('admin_sidebar_analytics') %></h2>
            <p style="color: #64748b; margin-top: 5px; font-size: 1.1rem;"><%= __('admin_analytics_desc') %></p>
        </div>
        <div class="responsive-hide" style="background: white; padding: 12px 25px; border-radius: 15px; border: 1px solid #e2e8f0; box-shadow: var(--shadow-sm); text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
            <div style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;"><%= __('admin_analytics_last_update') %></div>
            <div style="font-weight: 800; color: var(--primary); font-size: 1.1rem;"><%= new Date().toLocaleString(lang === 'ar' ? 'ar-EG' : 'en-US') %></div>
        </div>
    </div>

    <!-- KPI Ribbon -->
    <div class="grid-auto-4" style="margin-bottom: 40px; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
        <div class="kpi-card-lux" style="background: linear-gradient(135deg, var(--primary), var(--grad-navy)); color: white;">
            <div class="kpi-icon"><i class="fas fa-coins"></i></div>
            <div class="kpi-value">$<%= stats.kpis.total.toLocaleString() %></div>
            <div class="kpi-label text-align-inherit"><%= __('admin_analytics_total_donations') %></div>
            <div class="kpi-trend text-align-inherit"><i class="fas fa-arrow-up"></i> <%= stats.kpis.count %> <%= __('admin_analytics_successful_ops') %></div>
        </div>
        <div class="kpi-card-lux" style="background: white; border: 1px solid #e2e8f0;">
            <div class="kpi-icon" style="background: #fff7ed; color: #ea580c;"><i class="fas fa-repeat"></i></div>
            <div class="kpi-value" style="color: var(--primary);"><%= stats.activeSponsorships %></div>
            <div class="kpi-label text-align-inherit"><%= __('admin_analytics_active_sponsorships') %></div>
            <div class="kpi-trend text-align-inherit" style="color: #016630;"><%= __('admin_analytics_sustainable_support') %></div>
        </div>
        <div class="kpi-card-lux" style="background: white; border: 1px solid #e2e8f0;">
            <div class="kpi-icon" style="background: #f0fdf4; color: #16a34a;"><i class="fas fa-check-double"></i></div>
            <div class="kpi-value" style="color: var(--primary);"><%= stats.satisfactionRate %>%</div>
            <div class="kpi-label text-align-inherit"><%= __('admin_analytics_satisfaction_rate') %></div>
            <div class="kpi-trend text-align-inherit" style="color: #64748b;"><%= __('admin_analytics_total_published') %></div>
        </div>
        <div class="kpi-card-lux" style="background: white; border: 1px solid #e2e8f0;">
            <div class="kpi-icon" style="background: #fdf2f8; color: #db2777;"><i class="fas fa-bolt"></i></div>
            <div class="kpi-value" style="color: var(--primary);"><%= stats.activityVol %></div>
            <div class="kpi-label text-align-inherit"><%= __('admin_analytics_platform_activity_30d') %></div>
            <div class="kpi-trend text-align-inherit" style="color: #64748b;"><%= __('admin_analytics_admin_interaction') %></div>
        </div>
    </div>

    <!-- Impact Proofs — Reports subsection -->
    <section class="analytics-impact-section<%= pendingImpactProofsCount > 0 ? ' analytics-impact-section--pending' : '' %>" style="margin-bottom: 40px; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
        <div class="analytics-impact-section__glow" aria-hidden="true"></div>
        <div class="analytics-impact-section__inner">
            <div class="analytics-impact-section__header">
                <div class="analytics-impact-section__intro">
                    <div class="analytics-impact-section__icon">
                        <i class="fas fa-file-shield"></i>
                    </div>
                    <div>
                        <h3 class="font-cairo analytics-impact-section__title"><%= __('admin_analytics_impact_title') %></h3>
                        <p class="analytics-impact-section__desc"><%= __('admin_analytics_impact_desc') %></p>
                    </div>
                </div>
                <div class="analytics-impact-section__meta">
                    <div class="analytics-impact-section__stat">
                        <span class="analytics-impact-section__stat-value"><%= pendingImpactProofsCount %></span>
                        <span class="analytics-impact-section__stat-label"><%= __('admin_analytics_impact_pending_label') %></span>
                    </div>
                    <a href="/admin/pending-impact-proofs" class="analytics-impact-section__cta btn-lux btn-lux-primary">
                        <span><%= __('admin_analytics_impact_view_all') %></span>
                        <i class="fas fa-arrow-<%= langDir === 'rtl' ? 'left' : 'right' %>"></i>
                    </a>
                </div>
            </div>

            <!-- Impact workflow -->
            <%- include('../../partials/admin-impact-workflow') %>

            <% if (pendingImpactProofs && pendingImpactProofs.length > 0) { %>
                <div class="analytics-impact-section__queue-head">
                    <h4 class="font-cairo analytics-impact-section__queue-title"><%= __('admin_impact_workflow_queue_title') %></h4>
                    <span class="analytics-impact-section__queue-badge"><%= pendingImpactProofsCount %> <%= __('admin_impact_workflow_queue_badge') %></span>
                </div>
                <div class="analytics-impact-section__grid">
                    <% pendingImpactProofs.forEach(function(proof) { %>
                        <article class="analytics-impact-card" id="impact-proof-<%= proof._id %>">
                            <% if (proof.images && proof.images.length > 0) { %>
                                <div class="analytics-impact-card__media" style="background-image: url('<%= proof.images[0] %>');"></div>
                            <% } else { %>
                                <div class="analytics-impact-card__media analytics-impact-card__media--empty">
                                    <i class="fas fa-image"></i>
                                </div>
                            <% } %>
                            <div class="analytics-impact-card__body">
                                <% if (proof.case && proof.case.title) { %>
                                    <span class="analytics-impact-card__case"><%= proof.case.title %></span>
                                <% } %>
                                <h4 class="font-cairo analytics-impact-card__title"><%= proof.title %></h4>
                                <p class="analytics-impact-card__excerpt"><%= proof.content %></p>
                                <div class="analytics-impact-card__footer">
                                    <span><i class="fas fa-user-shield"></i> <%= proof.guardian ? proof.guardian.name : '—' %></span>
                                    <span><i class="far fa-clock"></i> <%= new Date(proof.createdAt).toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US') %></span>
                                </div>
                                <div class="analytics-impact-card__actions">
                                    <form action="/admin/impact-proofs/<%= proof._id %>/approve" method="POST" class="analytics-impact-card__action-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="returnTo" value="/admin/analytics">
                                        <button type="submit" class="btn-lux btn-lux-primary analytics-impact-card__btn"><i class="fas fa-check"></i> <%= __('common_approve_publish') %></button>
                                    </form>
                                    <button type="button" class="btn-lux btn-lux-outline analytics-impact-card__btn" onclick="toggleImpactReject('<%= proof._id %>')"><i class="fas fa-times"></i> <%= __('common_reject') %></button>
                                </div>
                                <div id="impact-reject-<%= proof._id %>" class="analytics-impact-card__reject" hidden>
                                    <form action="/admin/impact-proofs/<%= proof._id %>/reject" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="returnTo" value="/admin/analytics">
                                        <textarea name="rejectionReason" required class="form-input content-mgmt-textarea" rows="2" placeholder="<%= __('admin_impact_rejection_placeholder') %>"></textarea>
                                        <button type="submit" class="btn-lux btn-lux-danger analytics-impact-card__btn analytics-impact-card__btn--full"><%= __('admin_impact_confirm_rejection') %></button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="analytics-impact-section__empty">
                    <div class="analytics-impact-section__empty-icon"><i class="fas fa-clipboard-check"></i></div>
                    <div>
                        <strong class="font-cairo"><%= __('admin_impact_no_pending') %></strong>
                        <p><%= __('admin_analytics_impact_empty_desc') %></p>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Main Charts Section -->
    <div class="grid-auto-2" style="grid-template-columns: 2fr 1fr !important; margin-bottom: 40px;">
        <!-- 1. Revenue Timeline -->
        <div class="chart-container-lux">
            <div class="chart-header">
                <h5 class="font-cairo"><i class="fas fa-chart-line"></i> <%= __('admin_analytics_revenue_timeline') %></h5>
                <span class="badge badge-soft-primary responsive-hide"><%= __('admin_analytics_last_12m') %></span>
            </div>
            <div style="height: 350px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- 2. Donation Type Breakdown -->
        <div class="chart-container-lux">
            <div class="chart-header">
                <h5 class="font-cairo"><i class="fas fa-chart-pie"></i> <%= __('admin_analytics_donation_structure') %></h5>
            </div>
            <div style="height: 250px; position: relative;">
                <canvas id="typeChart"></canvas>
            </div>
            <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #f1f5f9; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 10px;">
                    <span style="color: #64748b;"><%= __('admin_analytics_fees_collected') %></span>
                    <strong style="color: var(--secondary);">$<%= stats.kpis.fees.toLocaleString() %></strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row: Users & Locations -->
    <div class="grid-auto-3" style="margin-bottom: 40px; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
        <div class="chart-container-lux">
            <div class="chart-header"><h6 class="font-cairo"><%= __('admin_analytics_user_distribution') %></h6></div>
            <canvas id="userDistChart" height="280"></canvas>
        </div>
        <div class="chart-container-lux">
            <div class="chart-header"><h6 class="font-cairo"><%= __('admin_analytics_case_status') %></h6></div>
            <canvas id="caseStatusChart" height="280"></canvas>
        </div>
        <div class="chart-container-lux">
            <div class="chart-header"><h6 class="font-cairo"><%= __('admin_analytics_geo_distribution') %></h6></div>
            <canvas id="locationChart" height="280"></canvas>
        </div>
    </div>

    <!-- Bottom Row: Tables & Funnels -->
    <div class="grid-auto-2" style="grid-template-columns: 1.5fr 1fr !important;">
        <!-- Top Donors Table -->
        <div class="chart-container-lux">
            <div class="chart-header">
                <h5 class="font-cairo"><i class="fas fa-trophy" style="color: #00A544;"></i> <%= __('admin_analytics_top_donors_title') %></h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle" style="margin-top: 10px; text-align: <%= langDir === 'rtl' ? 'right' : 'left' %>;">
                    <thead style="background: #f8fafc;">
                        <tr style="font-size: 0.85rem; color: #64748b;">
                            <th class="border-0 px-3"><%= __('common_donor') %></th>
                            <th class="border-0"><%= __('common_contributions_count') %></th>
                            <th class="border-0 text-<%= langDir === 'rtl' ? 'left' : 'right' %> px-3"><%= __('common_total_donations') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% stats.topDonors.forEach(donor => { %>
                            <tr>
                                <td class="px-3">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <img src="<%= userAvatar(donor.donorDetails) %>" style="width: 35px; height: 35px; border-radius: 10px; object-fit: cover;">
                                        <div>
                                            <div style="font-weight: 800; color: var(--primary); font-size: 0.9rem;"><%= donor.donorDetails.name %></div>
                                            <div style="font-size: 0.75rem; color: #94a3b8;"><%= donor.donorDetails.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge-soft-navy"><%= donor.count %> <%= __('common_donation') %></span></td>
                                <td class="text-<%= langDir === 'rtl' ? 'left' : 'right' %> px-3"><strong style="color: var(--secondary); font-size: 1.1rem;">$<%= donor.totalDonated.toLocaleString() %></strong></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Communication Efficiency -->
        <div class="chart-container-lux">
            <div class="chart-header">
                <h5 class="font-cairo"><i class="fas fa-comments"></i> <%= __('admin_analytics_comm_efficiency') %></h5>
            </div>
            <div style="padding: 10px;">
                <canvas id="chatChart" height="250"></canvas>
                <div style="margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <% 
                        const totalReqs = stats.chatReqStats.reduce((a, b) => a + b.count, 0);
                        const approved = stats.chatReqStats.find(s => s._id === 'approved')?.count || 0;
                        const approvalRate = totalReqs > 0 ? ((approved / totalReqs) * 100).toFixed(0) : 0;
                    %>
                    <div style="background: #f0fdf4; padding: 20px; border-radius: 15px; border: 1px solid #dcfce7; text-align: center;">
                        <div style="font-size: 1.8rem; font-weight: 900; color: #16a34a;"><%= approvalRate %>%</div>
                        <div style="font-size: 0.8rem; color: #15803d; font-weight: 700;"><%= __('admin_analytics_approval_rate') %></div>
                    </div>
                    <div style="background: #fff7ed; padding: 20px; border-radius: 15px; border: 1px solid #ffedd5; text-align: center;">
                        <div style="font-size: 1.8rem; font-weight: 900; color: #ea580c;"><%= totalReqs %></div>
                        <div style="font-size: 0.8rem; color: #c2410c; font-weight: 700;"><%= __('common_total_requests') %></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .kpi-card-lux {
        padding: 25px;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease;
    }
    .kpi-card-lux:hover { transform: translateY(-5px); }
    .kpi-icon {
        width: 45px; height: 45px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; margin-bottom: 15px;
        background: rgba(255,255,255,0.15);
    }
    .kpi-value { font-size: 2rem; font-weight: 900; margin-bottom: 5px; }
    .kpi-label { font-size: 0.85rem; opacity: 0.8; font-weight: 700; margin-bottom: 12px; }
    .kpi-trend { font-size: 0.75rem; font-weight: 800; }
    .text-align-inherit { text-align: inherit; }

    .chart-container-lux {
        background: white; border: 1px solid #f1f5f9; border-radius: 25px;
        padding: 25px; box-shadow: 0 10px 40px rgba(0,0,0,0.02);
    }
    .chart-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #f8fafc;
    }
    .chart-header h5, .chart-header h6 { margin: 0; font-weight: 850; color: var(--primary); }
    
    .badge-soft-primary { background: #eff6ff; color: #1e40af; padding: 6px 14px; border-radius: 8px; font-weight: 800; font-size: 0.75rem; }
    .badge-soft-navy { background: #f1f5f9; color: var(--primary); padding: 5px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; border: 1px solid #e2e8f0; }

    .analytics-impact-section {
        position: relative;
        border-radius: 28px;
        overflow: hidden;
    }
    .analytics-impact-section__glow {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 0% 0%, rgba(0, 165, 68, 0.14), transparent 42%),
            radial-gradient(circle at 100% 100%, rgba(0, 38, 97, 0.12), transparent 40%);
        pointer-events: none;
    }
    .analytics-impact-section--pending .analytics-impact-section__glow {
        background:
            radial-gradient(circle at 0% 0%, rgba(0, 165, 68, 0.22), transparent 45%),
            radial-gradient(circle at 100% 100%, rgba(234, 88, 12, 0.1), transparent 38%);
    }
    .analytics-impact-section__inner {
        position: relative;
        padding: 28px;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 55%, #f0fdf4 100%);
        border: 1px solid rgba(0, 38, 97, 0.08);
        border-radius: 28px;
        box-shadow: 0 18px 50px rgba(2, 26, 15, 0.06);
    }
    .analytics-impact-section--pending .analytics-impact-section__inner {
        border-color: rgba(0, 165, 68, 0.18);
    }
    .analytics-impact-section__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 22px;
        padding-bottom: 20px;
        border-bottom: 1px dashed rgba(0, 38, 97, 0.1);
    }
    .analytics-impact-section__intro {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        flex: 1;
        min-width: 260px;
    }
    .analytics-impact-section__icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #016630;
        background: linear-gradient(135deg, rgba(0, 165, 68, 0.16), rgba(0, 165, 68, 0.06));
        border: 1px solid rgba(0, 165, 68, 0.2);
        flex-shrink: 0;
    }
    .analytics-impact-section__title {
        margin: 0 0 6px;
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--primary);
    }
    .analytics-impact-section__desc {
        margin: 0;
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.6;
        max-width: 520px;
    }
    .analytics-impact-section__meta {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .analytics-impact-section__stat {
        min-width: 88px;
        padding: 12px 16px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid #e2e8f0;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
    }
    .analytics-impact-section__stat-value {
        display: block;
        font-size: 1.6rem;
        font-weight: 900;
        color: var(--secondary);
        line-height: 1;
    }
    .analytics-impact-section__stat-label {
        display: block;
        margin-top: 4px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
    }
    .analytics-impact-section__cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px !important;
        border-radius: 14px !important;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }
    .analytics-impact-section__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }
    .analytics-impact-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(0, 38, 97, 0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .analytics-impact-card:hover {
        transform: translateY(-3px);
        border-color: rgba(0, 165, 68, 0.22);
        box-shadow: 0 14px 30px rgba(0, 165, 68, 0.1);
    }
    .analytics-impact-card {
        flex-direction: column;
    }
    .analytics-impact-card__media {
        width: 100%;
        height: 120px;
        border-radius: 14px;
        background-size: cover;
        background-position: center;
        flex-shrink: 0;
        border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .analytics-impact-card__media--empty {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc, #eef2f7);
        color: #cbd5e1;
        font-size: 1.2rem;
    }
    .analytics-impact-card__body {
        min-width: 0;
        flex: 1;
    }
    .analytics-impact-card__case {
        display: inline-block;
        margin-bottom: 6px;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(0, 38, 97, 0.06);
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 800;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .analytics-impact-card__title {
        margin: 0 0 6px;
        font-size: 0.95rem;
        font-weight: 800;
        color: #0f172a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .analytics-impact-card__excerpt {
        margin: 0 0 10px;
        font-size: 0.8rem;
        line-height: 1.5;
        color: #64748b;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .analytics-impact-card__footer {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
    }
    .analytics-impact-card__footer i {
        color: var(--secondary);
        margin-inline-end: 4px;
    }
    .impact-workflow { margin-bottom: 22px; padding: 18px; border-radius: 18px; background: rgba(255,255,255,0.72); border: 1px solid rgba(0,38,97,0.08); }
    .analytics-impact-section__queue-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }
    .analytics-impact-section__queue-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 900;
        color: var(--primary);
    }
    .analytics-impact-section__queue-badge {
        padding: 5px 12px;
        border-radius: 999px;
        background: #fff7ed;
        color: #ea580c;
        font-size: 0.75rem;
        font-weight: 800;
        border: 1px solid #fed7aa;
    }
    .analytics-impact-card__actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
    }
    .analytics-impact-card__action-form { flex: 1; min-width: 120px; }
    .analytics-impact-card__btn {
