    .analytics-impact-card__actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
    .analytics-impact-card__action-form { flex: 1; min-width: 110px; }
    .analytics-impact-card__btn { width: 100%; padding: 7px 10px !important; font-size: 0.76rem !important; border-radius: 10px !important; font-weight: 800; }
    .analytics-impact-card__btn--full { margin-top: 8px; }
    .analytics-impact-card__reject { margin-top: 8px; padding-top: 8px; border-top: 1px dashed #e2e8f0; }
    .analytics-impact-card__reject textarea { width: 100%; font-size: 0.8rem; }
    .analytics-impact-section__empty {
        display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: 14px;
        background: rgba(255,255,255,0.75); border: 1px dashed #dbe3ee;
    }
    .analytics-impact-section__empty-icon {
        width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        background: #f0fdf4; color: #16a34a; font-size: 1.2rem; flex-shrink: 0;
    }
    .analytics-impact-section__empty strong { display: block; margin-bottom: 4px; color: var(--primary); }
    .analytics-impact-section__empty p { margin: 0; color: #94a3b8; font-size: 0.84rem; }
    @media (max-width: 768px) {
        .analytics-impact-section__meta { width: 100%; }
        .analytics-impact-section__cta { width: 100%; justify-content: center; }
    }
</style>

<script>
    function toggleImpactReject(id) {
        const el = document.getElementById('impact-reject-' + id);
        if (el) el.hidden = !el.hidden;
    }
</script>

<script>
    const locale = '<%= lang === "ar" ? "ar-EG" : "en-US" %>';
    const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'long' });
    const stats = <%- JSON.stringify(stats) %>;

    const chartFont = { family: 'Cairo', weight: '700' };
    const gridColor = 'rgba(148, 163, 184, 0.2)';

    const revCtx = document.getElementById('revenueChart').getContext('2d');
    const revGradient = revCtx.createLinearGradient(0, 0, 0, 320);
    revGradient.addColorStop(0, 'rgba(0, 38, 97, 0.18)');
    revGradient.addColorStop(1, 'rgba(0, 38, 97, 0)');

    new Chart(revCtx, {
        type: 'line',
        data: {
            labels: stats.financialTrends.map(d => monthFormatter.format(new Date(2000, d._id.month - 1, 1)) + ' ' + d._id.year),
            datasets: [{
                label: '<%= __("admin_analytics_js_net_donations") %>',
                data: stats.financialTrends.map(d => d.total),
                borderColor: '#002661',
                borderWidth: 3,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#002661',
                pointBorderWidth: 2,
                pointRadius: 5,
                backgroundColor: revGradient,
                fill: true,
                tension: 0.35,
            }],
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { grid: { color: gridColor, borderDash: [4, 4] }, ticks: { font: chartFont, callback: v => '$' + v } },
                x: { grid: { display: false }, ticks: { font: chartFont, maxRotation: 0, autoSkip: true, maxTicksLimit: 6 } },
            },
        },
    });

    new Chart(document.getElementById('typeChart'), {
        type: 'doughnut',
        data: {
            labels: ['<%= __("admin_analytics_js_direct_donations") %>', '<%= __("admin_analytics_active_sponsorships") %>'],
            datasets: [{
                data: [Math.max(stats.kpis.count - stats.activeSponsorships, 0), stats.activeSponsorships],
                backgroundColor: ['#002661', '#00A544'],
                borderWidth: 0,
                hoverOffset: 12,
            }],
        },
        options: {
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: { legend: { position: 'bottom', labels: { font: chartFont, padding: 14 } } },
        },
    });

    const statusMap = {
        verified: '<%= __("common_verified") %>',
        pending: '<%= __("common_pending") %>',
        rejected: '<%= __("common_rejected") %>',
        orphan: '<%= __("common_orphans") %>',
        family: '<%= __("common_families") %>',
    };
    const roleMap = {
        donor: '<%= __("common_donor") %>',
        family: '<%= __("common_family") %>',
        admin: '<%= __("common_admin") %>',
        super_admin: '<%= __("common_super_admin") %>',
    };

    new Chart(document.getElementById('userDistChart'), {
        type: 'polarArea',
        data: {
            labels: stats.userRoleDistribution.map(r => roleMap[r._id] || r._id),
            datasets: [{
                data: stats.userRoleDistribution.map(r => r.count),
                backgroundColor: ['rgba(0, 38, 97, 0.75)', 'rgba(234, 179, 8, 0.75)', 'rgba(0, 165, 68, 0.75)', 'rgba(239, 68, 68, 0.75)'],
            }],
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
        },
    });

    new Chart(document.getElementById('caseStatusChart'), {
        type: 'bar',
        data: {
            labels: stats.casesByStatus.map(s => statusMap[s._id] || s._id),
            datasets: [{
                label: '<%= __("common_cases_count") %>',
                data: stats.casesByStatus.map(s => s.count),
                backgroundColor: '#00A544',
                borderRadius: 8,
            }],
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { grid: { color: gridColor }, ticks: { font: chartFont } },
                x: { grid: { display: false }, ticks: { font: chartFont } },
            },
        },
    });

    new Chart(document.getElementById('locationChart'), {
        type: 'bar',
        data: {
            labels: stats.casesByLocation.map(l => l._id),
            datasets: [{
                data: stats.casesByLocation.map(l => l.count),
                backgroundColor: '#cbd5e1',
                borderRadius: 8,
            }],
        },
        options: {
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: gridColor }, ticks: { font: chartFont } },
                y: { grid: { display: false }, ticks: { font: chartFont } },
            },
        },
    });

    const chatMap = {
        approved: '<%= __("common_approved") %>',
        pending: '<%= __("common_pending") %>',
        rejected: '<%= __("common_rejected") %>',
    };
    const chatColorMap = { approved: '#00A544', pending: '#f59e0b', rejected: '#ef4444' };

    new Chart(document.getElementById('chatChart'), {
        type: 'doughnut',
        data: {
            labels: stats.chatReqStats.map(s => chatMap[s._id] || s._id),
            datasets: [{
                data: stats.chatReqStats.map(s => s.count),
                backgroundColor: stats.chatReqStats.map(s => chatColorMap[s._id] || '#94a3b8'),
                borderWidth: 0,
            }],
        },
        options: {
            maintainAspectRatio: false,
            cutout: '58%',
            plugins: { legend: { position: 'bottom', labels: { font: chartFont, padding: 12 } } },
        },
    });
</script>

<%- include('../../partials/admin-layout-bottom') %>
