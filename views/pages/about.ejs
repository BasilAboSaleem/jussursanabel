<%- include('../partials/header-top') %>

<main class="about-page">
    <!-- Signature About Hero — unique to this page -->
    <section class="nm-about-hero" aria-label="<%= __('about_us') %>">
        <div class="nm-about-hero__atmosphere" aria-hidden="true">
            <span class="nm-about-hero__orb nm-about-hero__orb--1"></span>
            <span class="nm-about-hero__orb nm-about-hero__orb--2"></span>
            <span class="nm-about-hero__orb nm-about-hero__orb--3"></span>
            <span class="nm-about-hero__grain" style="--x:12%; --d:0s;"></span>
            <span class="nm-about-hero__grain" style="--x:28%; --d:1.2s;"></span>
            <span class="nm-about-hero__grain" style="--x:46%; --d:0.4s;"></span>
            <span class="nm-about-hero__grain" style="--x:63%; --d:2s;"></span>
            <span class="nm-about-hero__grain" style="--x:78%; --d:0.8s;"></span>
            <span class="nm-about-hero__grain" style="--x:91%; --d:1.6s;"></span>
        </div>

        <div class="nm-about-hero__watermark" aria-hidden="true"><%= __('hero_title') %></div>

        <div class="container nm-about-hero__layout">
            <div class="nm-about-hero__copy">
                <p class="nm-about-hero__affiliate"><%= __('hero_affiliation') %></p>
                <h1 class="nm-about-hero__title">
                    <span class="nm-about-hero__title-ar"><%= __('hero_title') %></span>
                    <span class="nm-about-hero__title-en">Nameer</span>
                </h1>
                <p class="nm-about-hero__tagline"><%= __('about_story_title') %></p>
                <p class="nm-about-hero__text"><%= __('about_hero_desc') %></p>
                <div class="nm-about-hero__cta">
                    <a href="#about-story" class="nm-about-hero__btn nm-about-hero__btn--primary"><%= __('about_story_badge') %></a>
                    <a href="/cases" class="nm-about-hero__btn nm-about-hero__btn--line"><%= __('cases') %></a>
                </div>
            </div>

            <div class="nm-about-hero__emblem" aria-hidden="true">
                <svg class="nm-about-hero__sheaf" viewBox="0 0 320 420" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="nmSheafGold" x1="160" y1="20" x2="160" y2="400" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#B8F5C8"/>
                            <stop offset="0.45" stop-color="#00C758"/>
                            <stop offset="1" stop-color="#016630"/>
                        </linearGradient>
                        <linearGradient id="nmSheafGlow" x1="160" y1="40" x2="160" y2="280" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#69FF97" stop-opacity="0.55"/>
                            <stop offset="1" stop-color="#69FF97" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    <ellipse cx="160" cy="210" rx="110" ry="150" fill="url(#nmSheafGlow)"/>
                    <!-- central stalk -->
                    <path d="M160 390 C158 300 160 220 160 90" stroke="url(#nmSheafGold)" stroke-width="3.5" stroke-linecap="round"/>
                    <!-- wheat heads -->
                    <path class="nm-stalk nm-stalk--a" d="M160 120 C120 90 95 70 78 48 C108 62 138 88 160 120Z" fill="url(#nmSheafGold)" opacity="0.95"/>
                    <path class="nm-stalk nm-stalk--b" d="M160 145 C110 120 78 98 55 72 C95 92 130 118 160 145Z" fill="url(#nmSheafGold)" opacity="0.85"/>
                    <path class="nm-stalk nm-stalk--c" d="M160 170 C105 150 70 130 42 102 C88 122 128 148 160 170Z" fill="url(#nmSheafGold)" opacity="0.75"/>
                    <path class="nm-stalk nm-stalk--d" d="M160 120 C200 90 225 70 242 48 C212 62 182 88 160 120Z" fill="url(#nmSheafGold)" opacity="0.95"/>
                    <path class="nm-stalk nm-stalk--e" d="M160 145 C210 120 242 98 265 72 C225 92 190 118 160 145Z" fill="url(#nmSheafGold)" opacity="0.85"/>
                    <path class="nm-stalk nm-stalk--f" d="M160 170 C215 150 250 130 278 102 C232 122 192 148 160 170Z" fill="url(#nmSheafGold)" opacity="0.75"/>
                    <path class="nm-stalk nm-stalk--g" d="M160 95 C145 68 140 42 138 22 C152 42 158 70 160 95Z" fill="#E8FFE8" opacity="0.9"/>
                    <circle cx="160" cy="88" r="7" fill="#69FF97"/>
                    <circle cx="160" cy="88" r="18" stroke="#69FF97" stroke-opacity="0.35" stroke-width="1.5"/>
                    <circle class="nm-pulse" cx="160" cy="88" r="28" stroke="#69FF97" stroke-opacity="0.2" stroke-width="1"/>
                </svg>
                <p class="nm-about-hero__emblem-caption"><%= __('brand_affiliation_short') %></p>
            </div>
        </div>

        <svg class="nm-about-hero__horizon" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,80 C240,20 480,110 720,60 C960,10 1200,90 1440,40 L1440,120 L0,120 Z" fill="#ffffff"/>
        </svg>
    </section>

    <!-- What is Nameer -->
    <section id="about-story" class="about-section about-section--story">
        <div class="container about-story">
            <div class="about-story__label"><%= __('about_story_badge') %></div>
            <h2 class="about-story__title"><%= __('about_hero_title') %></h2>
            <div class="about-story__copy">
                <p><%= __('about_story_p1') %></p>
                <p><%= __('about_story_p2') %></p>
            </div>
            <a class="about-text-link" href="https://www.senabil-pal.org/ar/about" target="_blank" rel="noopener">
                <%= __('about_senabil_cta') %>
                <i class="fas fa-arrow-<%= locals.langDir === 'ltr' ? 'right' : 'left' %>"></i>
            </a>
        </div>
    </section>

    <!-- Vision + Mission -->
    <section class="about-section about-section--split">
        <div class="container about-split">
            <article class="about-split__item">
                <h3><%= __('about_vision_title') %></h3>
                <p><%= __('about_vision_desc') %></p>
            </article>
            <article class="about-split__item">
                <h3><%= __('about_mission_title') %></h3>
                <p><%= __('about_mission_desc') %></p>
            </article>
        </div>
    </section>

    <!-- Goals -->
    <section class="about-section">
        <div class="container">
            <header class="about-section__head">
                <p class="about-section__eyebrow"><%= __('about_goals_badge') %></p>
                <h2><%= __('about_goals_title') %></h2>
            </header>
            <ol class="about-goals">
                <li>
                    <span class="about-goals__num">01</span>
                    <div>
                        <h4><%= __('about_goal_1_title') %></h4>
                        <p><%= __('about_goal_1_desc') %></p>
                    </div>
                </li>
                <li>
                    <span class="about-goals__num">02</span>
                    <div>
                        <h4><%= __('about_goal_2_title') %></h4>
                        <p><%= __('about_goal_2_desc') %></p>
                    </div>
                </li>
                <li>
                    <span class="about-goals__num">03</span>
                    <div>
                        <h4><%= __('about_goal_3_title') %></h4>
                        <p><%= __('about_goal_3_desc') %></p>
                    </div>
                </li>
            </ol>
        </div>
    </section>

    <!-- Principles -->
    <section class="about-section about-section--muted">
        <div class="container">
            <header class="about-section__head">
                <p class="about-section__eyebrow"><%= __('about_values_badge') %></p>
                <h2><%= __('about_values_title') %></h2>
            </header>
            <div class="about-principles">
                <div>
                    <h4><%= __('about_value_1_title') %></h4>
                    <p><%= __('about_value_1_desc') %></p>
                </div>
                <div>
                    <h4><%= __('about_value_2_title') %></h4>
                    <p><%= __('about_value_2_desc') %></p>
                </div>
                <div>
                    <h4><%= __('about_value_3_title') %></h4>
                    <p><%= __('about_value_3_desc') %></p>
                </div>
                <div>
                    <h4><%= __('about_value_4_title') %></h4>
                    <p><%= __('about_value_4_desc') %></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Nameer -->
    <section class="about-section">
        <div class="container about-why">
            <header class="about-section__head about-section__head--start">
                <p class="about-section__eyebrow"><%= __('about_why_badge') %></p>
                <h2><%= __('about_why_title') %></h2>
            </header>
            <ul class="about-why__list">
                <li><%= __('about_why_1') %></li>
                <li><%= __('about_why_2') %></li>
                <li><%= __('about_why_3') %></li>
                <li><%= __('about_why_4') %></li>
            </ul>
        </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="about-section about-section--muted about-faq-wrap">
        <div class="container">
            <header class="about-section__head">
                <h2><%= __('faq_title') %></h2>
                <p class="about-section__sub"><%= __('faq_subtitle') %></p>
            </header>
            <div class="about-faq">
                <% [['faq_q1','faq_a1'],['faq_q2','faq_a2'],['faq_q3','faq_a3'],['faq_q4','faq_a4']].forEach(([q,a]) => { %>
                    <details>
                        <summary><%= __(q) %></summary>
                        <p><%= __(a) %></p>
                    </details>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="about-cta">
        <div class="container about-cta__inner">
            <h2><%= __('about_cta_title') %></h2>
            <p><%= __('about_cta_desc') %></p>
            <div class="about-cta__actions">
                <a href="/auth/register" class="about-btn about-btn--solid"><%= __('about_cta_btn_start') %></a>
                <a href="/contact" class="about-btn about-btn--ghost"><%= __('about_cta_btn_contact') %></a>
            </div>
        </div>
    </section>
</main>

<script>
    if (window.location.hash === '#faq') {
        const faq = document.getElementById('faq');
        if (faq) setTimeout(() => faq.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
    }
</script>

<%- include('../partials/footer-bottom') %>
