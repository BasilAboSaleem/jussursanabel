<%- include('../partials/header-top') %>

<main class="nm-public-main">
    <%- include('../partials/nm-hero-signature', {
        ariaLabel: siteText('hero_title'),
        affiliate: siteText('hero_affiliation'),
        titleAr: siteText('hero_title'),
        titleEn: siteText('hero_title_en'),
        tagline: siteText('hero_tagline'),
        text: siteText('hero_desc'),
        primaryHref: '/cases',
        primaryText: siteText('btn_start_sponsorship'),
        secondaryHref: '/about',
        secondaryText: siteText('about_us'),
        emblemPrefix: 'nmImpact',
        emblemCaption: siteText('hero_tagline'),
        horizonFill: '#f8fafc',
        showEmblemLabels: true,
        showEmblemParticles: true
    }) %>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Impact stats ribbon -->
    <section class="section-zen nm-impact-ribbon">
        <div class="container">
            <div class="impact-mobile-carousel" id="impactCarousel">
                <div class="impact-track" id="impactTrack">
                    <%- include('../partials/nm-stat-card', {
                        icon: 'fa-hand-holding-heart',
                        target: homepageStats.beneficiaryCases,
                        suffix: '+',
                        label: siteText('stats_cases')
                    }) %>
                    <%- include('../partials/nm-stat-card', {
                        icon: 'fa-vault',
                        target: homepageStats.registeredDonors,
                        suffix: '+',
                        label: siteText('stats_donations'),
                        bordered: true
                    }) %>
                    <%- include('../partials/nm-stat-card', {
                        icon: 'fa-gem',
                        target: homepageStats.transparencyPercent,
                        suffix: '%',
                        label: siteText('stats_transparency')
                    }) %>
                </div>
                <div class="impact-dots" id="impactDots" aria-hidden="true">
                    <button type="button" class="impact-dot active" data-index="0"></button>
                    <button type="button" class="impact-dot" data-index="1"></button>
                    <button type="button" class="impact-dot" data-index="2"></button>
                </div>
            </div>
        </div>
    </section>

    <!-- Urgent cases -->
    <section class="section-zen container nm-urgent-cases">
        <%- include('../partials/nm-section-head', {
            badgeIcon: 'fa-bolt',
            badgeText: siteText('index_urgent_cases_badge'),
            title: siteText('index_urgent_cases_title')
        }) %>

        <div class="swiper stories-swiper">
            <div class="swiper-wrapper">
                <% cases.forEach((item) => { %>
                    <div class="swiper-slide story-card-wrapper">
                        <a href="/cases/<%= item._id %>" class="story-card">
                            <div class="story-img-container">
                                <img src="<%= item.image || 'https://images.unsplash.com/photo-1593113563332-ceb47c0bace6?auto=format&fit=crop&w=600&q=80' %>" alt="<%= item.title %>" class="story-thumbnail">
                                <%
                                    const isYoutube = Boolean(item.storyVideoIsYouTube);
                                    const embedUrl = item.storyYouTubeEmbedUrl || "";
                                %>
                                <% if (item.storyVideoPlayable) { %>
                                    <% if (isYoutube) { %>
                                        <iframe class="story-hover-video yt-iframe" src="<%= embedUrl %>" allow="autoplay; encrypted-media" title="YouTube video player"></iframe>
                                    <% } else { %>
                                        <video class="story-hover-video html5-video" src="<%= item.storyVideoPlayable %>" muted loop playsinline preload="metadata">
                                            <source src="<%= item.storyVideoPlayable %>" type="video/mp4">
                                        </video>
                                    <% } %>

                                    <div class="story-video-controls">
                                        <button type="button" class="mute-btn">
                                            <i class="fas fa-volume-xmark"></i>
                                        </button>
                                    </div>

                                    <div class="story-play-indicator">
                                        <div class="play-pulse play-pulse-inner">
                                            <i class="fas fa-play"></i>
                                        </div>
                                    </div>
                                <% } %>
                                <div class="story-overlay"></div>
                                <div class="story-type-badge">
                                    <i class="fas <%= item.type === 'orphan' ? 'fa-child' : 'fa-users' %>"></i>
                                    <%= item.type === 'orphan' ? __('index_case_type_orphan') : __('index_case_type_family') %>
                                </div>
                                <div class="story-content">
                                    <h3 class="story-title"><%= item.title %></h3>
                                    <div class="story-progress-container">
                                        <div class="progress-track">
                                            <div class="progress-fill story-progress-fill" style="width: <%= Math.min((item.raisedAmount / (item.targetAmount || 1) * 100), 100) %>%"></div>
                                        </div>
                                        <div class="story-progress-row">
                                            <span>$<%= item.raisedAmount %> <%= __('index_case_raised_short') %></span>
                                            <span>$<%= item.targetAmount %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>

            <div class="stories-nav-prev"><i class="fas fa-chevron-left"></i></div>
            <div class="stories-nav-next"><i class="fas fa-chevron-right"></i></div>
        </div>

        <div class="reveal-on-scroll stories-hub-cta">
            <a href="/cases" class="btn-lux btn-lux-outline">
                <i class="fas fa-list"></i>
                <%= siteText('index_all_cases') %>
            </a>
            <a href="/stories" class="btn-lux btn-lux-primary">
                <i class="fas fa-play-circle stories-hub-cta__play-icon"></i>
                <%= siteText('index_watch_stories') %>
                <span class="stories-hub-cta__badge"><%= __('index_live_badge') %></span>
            </a>
        </div>
    </section>

    <!-- Vision split -->
    <section class="section-zen">
        <div class="container">
            <div class="grid-2 grid-lux-mobile-stack align-items-stretch nm-vision-split">
                <div class="reveal-on-scroll mobile-padding-sm nm-vision-split__content">
                    <h2 class="section-title-luxury nm-vision-split__title"><%= siteText('index_vision_title') %></h2>
                    <p class="nm-vision-split__text"><%= siteText('index_vision_desc') %></p>
                    <div class="flex-wrap-mobile nm-vision-split__features">
                        <div class="nm-vision-feature nm-vision-feature--accent">
                            <div class="nm-vision-feature__row">
                                <i class="fas fa-hand-holding-dollar nm-vision-feature__icon--accent"></i>
                                <div class="nm-vision-feature__value--accent">100%</div>
                            </div>
                            <div class="nm-vision-feature__label"><%= siteText('index_feature_1_title') %></div>
                        </div>
                        <div class="nm-vision-feature nm-vision-feature--light">
                            <div class="nm-vision-feature__row">
                                <i class="fas fa-route nm-vision-feature__icon--light"></i>
                                <div class="nm-vision-feature__value--light"><%= __('index_feature_direct_highlight') %></div>
                            </div>
                            <div class="nm-vision-feature__label"><%= siteText('index_feature_2_title') %></div>
                        </div>
                    </div>
                </div>
                <div class="reveal-on-scroll nm-vision-split__media">
                    <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?q=80&w=1200&auto=format&fit=crop" alt="" class="nm-vision-split__img">
                    <div class="vision-fade-mobile"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Journey steps -->
    <section class="section-zen nm-journey-section">
        <div class="nm-journey-path" aria-hidden="true"></div>

        <div class="container">
            <%- include('../partials/nm-section-head', {
                badgeIcon: 'fa-sparkles',
                badgeText: siteText('index_how_it_works_badge'),
                title: siteText('index_how_it_works_title'),
                bordered: true,
                titleLarge: true
            }) %>

            <div class="grid-3 nm-journey-grid">
                <%
                    const journeys = [
                        { icon: 'fa-fingerprint' },
                        { icon: 'fa-hand-holding-heart' },
                        { icon: 'fa-paper-plane' }
                    ];
                    [1, 2, 3].forEach((i, idx) => {
                %>
                <div class="reveal-on-scroll journey-card-couture">
                    <div class="nm-journey-card__orb">0<%= i %></div>
                    <div class="nm-journey-card__icon-wrap">
                        <i class="fas <%= journeys[idx].icon %> nm-journey-card__icon"></i>
                    </div>
                    <h3 class="font-cairo nm-journey-card__title"><%= __(`index_step_${i}_title`) %></h3>
                    <p class="nm-journey-card__desc"><%= __(`index_step_${i}_desc`) %></p>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="section-zen nm-testimonials-section">
        <div class="container">
            <%- include('../partials/nm-section-head', {
                badgeIcon: 'fa-quote-right',
                badgeText: siteText('index_testimonials_badge'),
                title: siteText('index_testimonials_title'),
                bordered: true
            }) %>

            <div class="testimonial-carousel-container">
                <div class="testimonial-track" id="testimonial-track">
                    <% testimonials.forEach(tm => { %>
                        <div class="testimonial-item">
                            <div class="luxury-card nm-testimonial-card">
                                <div class="nm-testimonial-stars">
                                    <% for (let i = 0; i < (tm.rating || 5); i++) { %>
                                        <i class="fas fa-star"></i>
                                    <% } %>
                                </div>
                                <p class="nm-testimonial-quote">"<%= tm.content %>"</p>
                                <div class="nm-testimonial-author">
                                    <div class="nm-testimonial-avatar">
                                        <%= tm.user ? tm.user.name.charAt(0) : 'D' %>
                                    </div>
                                    <div>
                                        <div class="nm-testimonial-name"><%= tm.user ? tm.user.name : __('index_testimonials_anonymous') %></div>
                                        <div class="nm-testimonial-meta"><%= tm.locationAr || __('index_testimonials_donor') %></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/nm-cta-block', {
        icon: 'fa-dove',
        title: siteText('index_footer_cta_title'),
        desc: siteText('index_footer_cta_desc'),
        btnHref: '/auth/register',
        btnText: siteText('navbar_register'),
        btnIcon: 'fa-sparkles'
    }) %>
</main>

<script>
    (function ElegantInit() {
        // 1. Reveal on scroll logic
        const initObserver = () => {
            const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, observerOptions);
            document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));
        };

        // 2. Counter animation
        const initCounters = () => {
            const impactEls = Array.from(document.querySelectorAll('.impact-number'));

            const setCounterValue = (el) => {
                const target = parseInt(el.getAttribute('data-target') || '0', 10);
                const suffix = el.getAttribute('data-suffix') || '+';
                el.innerHTML = target.toLocaleString() + suffix;
            };

            // On mobile/tablet sliders, values should always be present even when slides are off-canvas.
            if (window.innerWidth <= 992) {
                impactEls.forEach(setCounterValue);
                return;
            }

            const counterObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const target = parseInt(entry.target.getAttribute('data-target'));
                        animateValue(entry.target, 0, target, 2500);
                        counterObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });

            function animateValue(obj, start, end, duration) {
                const suffix = obj.getAttribute('data-suffix') || '+';
                let startTimestamp = null;
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString() + suffix;
                    if (progress < 1) window.requestAnimationFrame(step);
                };
                window.requestAnimationFrame(step);
            }
            impactEls.forEach(el => counterObserver.observe(el));
        };

        // 3. Swiper Init
        const initSwipers = () => {
            if (typeof Swiper !== 'undefined') {
                new Swiper('.stories-swiper', {
                    slidesPerView: 'auto',
                    spaceBetween: 24,
                    grabCursor: true,
                    freeMode: true,
                    resistance: true,
                    resistanceRatio: 0.7,
                    navigation: { nextEl: '.stories-nav-next', prevEl: '.stories-nav-prev' },
                    breakpoints: {
                        320:  { slidesPerView: 1.15, spaceBetween: 16 },
                        480:  { slidesPerView: 1.6,  spaceBetween: 20 },
                        768:  { slidesPerView: 2.4,  spaceBetween: 24 },
                        1024: { slidesPerView: 3.2,  spaceBetween: 28 },
                        1280: { slidesPerView: 3.8,  spaceBetween: 32 }
                    }
                });
            } else {
                setTimeout(initSwipers, 250);
            }
        };

        // 3.1 Impact carousel for mobile/tablet only
        const initImpactCarousel = () => {
            const carousel = document.getElementById('impactCarousel');
            const track = document.getElementById('impactTrack');
            const dotsWrap = document.getElementById('impactDots');
            if (!carousel || !track || !dotsWrap) return;

            // These cards are inside a slider viewport; keep them visible regardless of intersection observer timing.
            track.querySelectorAll('.impact-slide.reveal-on-scroll').forEach((el) => el.classList.add('active'));

            const dots = Array.from(dotsWrap.querySelectorAll('.impact-dot'));
            let index = 0;
            let direction = 1;
            let timer = null;

            // Keep slider geometry predictable in RTL/LTR pages.
            track.style.direction = 'ltr';
            const pageDir = (document.documentElement.getAttribute('dir') || 'rtl') === 'ltr' ? 'ltr' : 'rtl';
            track.querySelectorAll('.impact-slide').forEach((slide) => {
                slide.style.direction = pageDir;
            });

            const isMobileOrTablet = () => window.innerWidth <= 992;

            const update = (nextIndex) => {
                index = nextIndex;
                track.style.transform = `translateX(-${index * 100}%)`;
                dots.forEach((d, i) => d.classList.toggle('active', i === index));
            };

            const start = () => {
                if (!isMobileOrTablet()) {
                    track.style.transform = 'translateX(0)';
                    dotsWrap.style.display = 'none';
                    clearInterval(timer);
                    timer = null;
                    return;
                }

                dotsWrap.style.display = 'flex';
                if (timer) return;
                timer = setInterval(() => {
                    if (index === dots.length - 1) direction = -1;
                    if (index === 0) direction = 1;
                    update(index + direction);
                }, 3000);
            };

            const stop = () => {
                clearInterval(timer);
                timer = null;
            };

            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    stop();
                    update(Number(dot.dataset.index));
                    start();
                });
            });

            carousel.addEventListener('mouseenter', stop);
            carousel.addEventListener('mouseleave', start);
            carousel.addEventListener('touchstart', stop, { passive: true });
            carousel.addEventListener('touchend', start, { passive: true });

            window.addEventListener('resize', () => {
                if (!isMobileOrTablet()) {
                    index = 0;
                    update(0);
                }
                start();
            });

            update(0);
            start();
        };

        // 4. Hover-to-Play logic for video stories
        const initVideoHover = () => {
            const cards = document.querySelectorAll('.story-card');
            cards.forEach(card => {
                const video = card.querySelector('.story-hover-video');
                const playIndicator = card.querySelector('.story-play-indicator');

                if (video) {
                    const isYT = video.classList.contains('yt-iframe');

                    card.addEventListener('mouseenter', () => {
                        cards.forEach(otherCard => {
                            if (otherCard !== card) {
                                const otherVideo = otherCard.querySelector('.story-hover-video');
                                const otherIndicator = otherCard.querySelector('.story-play-indicator');
                                if (otherVideo) {
                                    otherVideo.style.opacity = '0';
                                    otherVideo.style.transform = 'scale(1.05)';
                                    if (otherIndicator) otherIndicator.style.opacity = '1';
                                    if (otherVideo.classList.contains('yt-iframe')) {
                                        otherVideo.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                                        otherVideo.contentWindow.postMessage('{"event":"command","func":"mute","args":""}', '*');
                                    } else {
                                        otherVideo.pause();
                                        otherVideo.muted = true;
                                    }
                                    otherCard.setAttribute('data-muted', 'true');
                                    const oBtn = otherCard.querySelector('.mute-btn i');
                                    if (oBtn) {
                                        oBtn.classList.remove('fa-volume-high');
                                        oBtn.classList.add('fa-volume-xmark');
                                    }
                                }
                            }
                        });

                        video.style.opacity = '1';
                        video.style.transform = 'scale(1)';
                        if (playIndicator) playIndicator.style.opacity = '0';
                        if (isYT) {
                            video.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
                        } else {
                            video.play().catch(e => console.log('Autoplay prevented:', e));
                        }
                    });

                    card.addEventListener('mouseleave', () => {
                        const isUnmuted = card.getAttribute('data-muted') === 'false';
                        if (isUnmuted) return;

                        video.style.opacity = '0';
                        video.style.transform = 'scale(1.05)';
                        if (playIndicator) playIndicator.style.opacity = '1';

                        if (isYT) {
                            video.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                            video.contentWindow.postMessage('{"event":"command","func":"mute","args":""}', '*');
                        } else {
                            video.pause();
                            video.muted = true;
                        }

                        card.setAttribute('data-muted', 'true');
                        const muteBtnIcon = card.querySelector('.mute-btn i');
                        if (muteBtnIcon) {
                            muteBtnIcon.classList.remove('fa-volume-high');
                            muteBtnIcon.classList.add('fa-volume-xmark');
                        }
                    });
                    card.setAttribute('data-muted', 'true');

                    const muteBtn = card.querySelector('.mute-btn');
                    if (muteBtn) {
                        muteBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            window.toggleMute(muteBtn);
                        });
                    }
                }
            });
        };

        window.toggleMute = function(btn) {
            const card = btn.closest('.story-card');
            if (!card) return;
            const video = card.querySelector('.story-hover-video');
            if (!video) return;

            const isYT = video.classList.contains('yt-iframe');
            const icon = btn.querySelector('i');

            if (isYT) {
                const currentlyMuted = card.getAttribute('data-muted') === 'true';
                if (currentlyMuted) {
                    video.contentWindow.postMessage('{"event":"command","func":"unMute","args":""}', '*');
                    card.setAttribute('data-muted', 'false');
                    icon.classList.remove('fa-volume-xmark');
                    icon.classList.add('fa-volume-high');
                } else {
                    video.contentWindow.postMessage('{"event":"command","func":"mute","args":""}', '*');
                    card.setAttribute('data-muted', 'true');
                    icon.classList.remove('fa-volume-high');
                    icon.classList.add('fa-volume-xmark');
                }
            } else {
                video.muted = !video.muted;
                card.setAttribute('data-muted', video.muted ? 'true' : 'false');
                if (video.muted) {
                    icon.classList.remove('fa-volume-high');
                    icon.classList.add('fa-volume-xmark');
                } else {
                    icon.classList.remove('fa-volume-xmark');
                    icon.classList.add('fa-volume-high');
                }
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initObserver(); initCounters(); initSwipers(); initImpactCarousel(); initVideoHover();
            });
        } else {
            initObserver(); initCounters(); initSwipers(); initImpactCarousel(); initVideoHover();
        }

        let testimonialIndex = 0;
        setInterval(() => {
            const track = document.getElementById('testimonial-track');
            const items = document.querySelectorAll('.testimonial-item');
            if (track && items.length > 0) {
                const visibleItems = window.innerWidth > 1200 ? 3 : (window.innerWidth > 800 ? 2 : 1);
                testimonialIndex = (testimonialIndex + 1) >= (items.length - visibleItems + 1) ? 0 : testimonialIndex + 1;
                track.style.transform = `translateX(${testimonialIndex * (100 / visibleItems)}%)`;
            }
        }, 7000);
    })();
</script>

<%- include('../partials/footer-bottom') %>