<%- include('../../partials/header-top') %>

<main class="nm-support-page<%= ticket ? ' nm-support-page--chat' : ' nm-support-page--empty' %>">
    <div class="container nm-support-page__inner">
        <% if (!ticket) { %>
        <header class="nm-support-page__header">
            <h1 class="font-cairo nm-support-page__title"><%= __('support_page_title') %></h1>
            <p class="nm-support-page__desc"><%= __('support_page_desc') %></p>
        </header>
        <% } else { %>
        <header class="nm-support-page__header nm-support-page__header--compact">
            <div>
                <h1 class="font-cairo nm-support-page__title"><%= __('support_page_title') %></h1>
                <p class="nm-support-page__desc"><%= __('support_page_desc') %></p>
            </div>
            <% if (!isAdmin) { %>
            <a href="/dashboard" class="btn-lux btn-lux-outline btn-sm nm-support-page__back">
                <i class="fas fa-arrow-<%= langDir === 'rtl' ? 'right' : 'left' %>"></i> <%= __('dashboard') %>
            </a>
            <% } %>
        </header>
        <% } %>

        <% if (!ticket) { %>
            <div class="nm-support-empty">
                <div class="nm-support-empty__icon"><i class="fas fa-headset"></i></div>
                <h2 class="font-cairo"><%= __('support_page_empty_title') %></h2>
                <p><%= __('support_page_empty_desc') %></p>
                <button type="button" onclick="openNewTicket()" class="btn-lux btn-lux-primary btn-lg">
                    <%= __('support_page_open_ticket') %> <i class="fas fa-plus-circle"></i>
                </button>
            </div>
        <% } else { %>
            <div class="nm-support-chat">
                <div class="nm-support-chat__header <%= isAdmin ? 'nm-support-chat__header--admin' : '' %>">
                    <div class="nm-support-chat__header-info">
                        <% if (isAdmin) { %>
                            <img src="<%= ticket.user.avatar %>" alt="" class="nm-support-chat__avatar">
                            <div>
                                <h2 class="font-cairo"><%= ticket.user.name %></h2>
                                <span><%= ticket.user.role === 'donor' ? __('support_page_role_donor') : __('support_page_role_family') %></span>
                            </div>
                        <% } else { %>
                            <div class="nm-support-chat__status-dot"></div>
                            <div>
                                <h2 class="font-cairo"><%= __('support_page_active_title') %></h2>
                                <span><%= __('support_page_ticket_id') %>: <%= ticket._id.toString().slice(-6).toUpperCase() %></span>
                            </div>
                        <% } %>
                    </div>
                    <div class="nm-support-chat__header-actions">
                        <span class="badge <%= ticket.status === 'resolved' ? 'badge-success' : 'badge-gold' %>">
                            <%= ticket.status === 'resolved' ? __('support_page_status_resolved') : (ticket.status === 'open' ? __('support_page_status_open') : __('support_page_status_in_progress')) %>
                        </span>
                        <% if (isAdmin && ticket.status !== 'resolved') { %>
                            <button type="button" onclick="resolveTicket()" class="btn-lux btn-lux-outline-white nm-support-chat__resolve-btn">
                                <i class="fas fa-check-circle"></i> <%= __('support_page_resolve_btn') %>
                            </button>
                        <% } %>
                    </div>
                </div>

                <div id="chat-messages" class="nm-support-chat__messages">
                    <% if (messages.length === 0) { %>
                        <div class="nm-support-chat__empty">
                            <i class="fas fa-comments"></i>
                            <p><%= __('support_page_no_messages') %></p>
                        </div>
                    <% } %>
                    <% messages.forEach(msg => { %>
                        <% const isMe = msg.sender._id.toString() === user._id.toString(); %>
                        <div class="nm-support-msg <%= isMe ? 'nm-support-msg--sent' : 'nm-support-msg--received' %>">
                            <div class="nm-support-msg__bubble">
                                <% if (msg.sender.role === 'admin' || msg.sender.role === 'super_admin') { %>
                                    <div class="nm-support-msg__sender"><%= __('support_team_label') %> (<%= msg.sender.name %>)</div>
                                <% } %>
                                <p><%= msg.content %></p>
                            </div>
                            <time class="nm-support-msg__time">
                                <%= new Date(msg.createdAt).toLocaleTimeString(lang === 'ar' ? 'ar-SA' : 'en-US', { hour: '2-digit', minute: '2-digit' }) %>
                            </time>
                        </div>
                    <% }) %>
                </div>

                <div class="nm-support-chat__input">
                    <input type="text" id="chat-input"
                        placeholder="<%= ticket.status === 'resolved' ? __('support_page_input_closed') : __('support_page_input_placeholder') %>"
                        <%= ticket.status === 'resolved' ? 'disabled' : '' %>>
                    <button type="button" onclick="sendMessage()" class="btn-lux btn-lux-navy"
                        <%= ticket.status === 'resolved' ? 'disabled' : '' %>>
                        <%= __('support_page_send') %> <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        <% } %>
    </div>
</main>

<!-- Socket.io for Real-time Chat -->
<script src="/socket.io/socket.io.js"></script>
<script>
    // Global Constants
    const socket = io();
    const currentUserId = '<%= user._id %>';
    const currentTicketId = '<%= ticket ? ticket._id : "" %>';
    const socketIsAdmin = <%= isAdmin %>;

    // Rooms are joined automatically after JWT auth on connect.

    // Scroll to bottom helper
    function scrollToBottom() {
        const chatBox = document.getElementById('chat-messages');
        if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
    }
    
    // Initial scroll
    scrollToBottom();

    // UI: Listen for new messages
    socket.on('newSupportMessage', (data) => {
        // Ensure message belongs to this ticket
        if (data.ticketId !== currentTicketId) return;

        const isMe = data.senderId === currentUserId;
        const messagesContainer = document.getElementById('chat-messages');
        
        // Remove empty placeholder
        const placeholder = messagesContainer.querySelector('.nm-support-chat__empty');
        if (placeholder) placeholder.remove();

        const msgHtml = `
            <div class="nm-support-msg ${isMe ? 'nm-support-msg--sent' : 'nm-support-msg--received'}">
                <div class="nm-support-msg__bubble">
                    ${data.isAdminTeam ? `<div class="nm-support-msg__sender"><%= __('support_team_label') %> (${data.senderName})</div>` : ''}
                    <p>${data.content}</p>
                </div>
                <time class="nm-support-msg__time">${new Date().toLocaleTimeString('<%= lang === "ar" ? "ar-SA" : "en-US" %>', { hour: '2-digit', minute: '2-digit' })}</time>
            </div>
        `;
        
        messagesContainer.insertAdjacentHTML('beforeend', msgHtml);
        scrollToBottom();
    });

    async function openNewTicket() {
        try {
            const response = await fetch('/support/ticket/open', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            if (response.ok) {
                location.reload(); // Reload is required here to switch from "No Ticket" to "Chat" view
            } else {
                alert('فشل في فتح تذكرة جديدة');
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    async function sendMessage() {
        const input = document.getElementById('chat-input');
        const content = input.value.trim();
        if (!content || !currentTicketId) return;

        try {
            // 1. Save to DB via API
            const response = await fetch('/support/message/send', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({
                    ticketId: currentTicketId,
                    content: content
                })
            });

            if (response.ok) {
                input.value = '';
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Input handlers
    document.getElementById('chat-input')?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendMessage();
    });

    // Resolution Logic
    async function resolveTicket() {
        if (!confirm('هل أنت متأكد من أن المشكلة تم حلها؟ سيتم إغلاق المحادثة.')) return;
        
        try {
            const response = await fetch(`/support/admin/ticket/${currentTicketId}/resolve`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': '<%= csrfToken %>'
                }
            });
            
            if (response.ok) {
                location.reload();
            } else {
                alert('فشل في إغلاق التذكرة');
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Listen for resolution 
    socket.on('ticketResolved', (data) => {
        if (data.ticketId === currentTicketId) {
            location.reload();
        }
    });
</script>

<%- include('../../partials/footer-bottom') %>
