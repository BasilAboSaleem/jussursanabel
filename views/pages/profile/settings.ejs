<% if (user && usesAdminPanel(user)) { %>
    <%- include('../../partials/admin-layout-top') %>
<% } else if (user && user.role === 'donor') { %>
    <%- include('../../partials/donor-layout-top') %>
<% } else { %>
    <%- include('../../partials/family-layout-top') %>
<% } %>

<%
const canChangeAvatar = user.role !== 'admin' && user.role !== 'super_admin';
%>

<div class="profile-settings-page" style="max-width: 900px; margin: 0 auto;">
    <div class="profile-settings-page__header">
        <span class="section-badge" style="margin: 0 0 10px 0;"><i class="fas fa-user-gear"></i> <%= __('profile_settings_title') %></span>
        <h2 class="font-cairo" style="margin: 0; font-weight: 800;"><%= __('admin_sidebar_my_profile') %></h2>
        <p style="color: var(--text-muted); margin-top: 5px; font-size: 0.95rem;"><%= __('profile_page_desc') %></p>
    </div>

    <div class="grid-1" style="gap: 30px;">
        <div class="luxury-card glass-panel" style="padding: 35px;">
            <div class="section-header-luxury" style="margin-bottom: 30px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
                <h3 class="font-cairo" style="font-size: 1.2rem; margin: 0; color: var(--primary);">
                    <i class="fas fa-id-card"></i> <%= __('profile_section_basic') %>
                </h3>
            </div>

            <form action="/profile/update" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="profile-settings-top" style="display: flex; gap: 30px; align-items: flex-start; flex-wrap: wrap;">
                    <div class="profile-avatar-col" style="text-align: center; flex: 0 0 180px;">
                        <div class="profile-settings-page__avatar-wrap">
                            <img src="<%= userAvatar(user) %>" id="avatarPreview" alt="" class="profile-settings-page__avatar">
                            <% if (canChangeAvatar) { %>
                                <label for="avatarInput" class="profile-settings-page__avatar-btn" title="<%= __('profile_avatar_hint') %>">
                                    <i class="fas fa-camera" aria-hidden="true"></i>
                                    <input type="file" id="avatarInput" name="avatar" class="profile-settings-page__avatar-input" onchange="previewImage(event)">
                                </label>
                            <% } %>
                        </div>
                        <% if (canChangeAvatar) { %>
                            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= __('profile_avatar_hint') %></span>
                        <% } else { %>
                            <div class="badge badge-navy" style="font-size: 0.7rem; padding: 5px 12px; border-radius: 20px;">
                                <i class="fas fa-shield-halved"></i> <%= __('profile_avatar_admin_badge') %>
                            </div>
                        <% } %>
                    </div>

                    <div class="profile-fields-grid" style="flex: 1; min-width: 300px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div class="form-group-luxury">
                            <label for="profileName"><%= __('profile_label_name') %></label>
                            <input type="text" id="profileName" name="name" value="<%= user.name %>" required placeholder="<%= __('profile_placeholder_name') %>">
                        </div>
                        <div class="form-group-luxury">
                            <label for="profileEmail"><%= __('profile_label_email') %></label>
                            <input type="email" id="profileEmail" value="<%= user.email %>" disabled style="background: #f8fafc; color: var(--text-muted); cursor: not-allowed;">
                        </div>
                        <div class="form-group-luxury">
                            <label for="profileId"><%= __('profile_label_id') %></label>
                            <input type="text" id="profileId" name="idNumber" value="<%= user.idNumber || '' %>" placeholder="<%= __('profile_placeholder_id') %>">
                        </div>
                        <div class="form-group-luxury">
                            <label for="profilePhone"><%= __('profile_label_phone') %></label>
                            <input type="text" id="profilePhone" name="phone" value="<%= user.phone || '' %>" placeholder="<%= __('profile_placeholder_phone') %>">
                        </div>
                    </div>
                </div>

                <div style="margin-top: 30px; border-top: 1px solid #f1f5f9; padding-top: 25px; display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn-lux btn-lux-primary" style="padding: 12px 30px;">
                        <i class="fas fa-save" aria-hidden="true"></i> <%= __('profile_btn_save') %>
                    </button>
                </div>
            </form>
        </div>

        <div class="luxury-card glass-panel" style="padding: 35px;">
            <div class="section-header-luxury" style="margin-bottom: 30px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
                <h3 class="font-cairo" style="font-size: 1.2rem; margin: 0; color: var(--primary);">
                    <i class="fas fa-shield-halved"></i> <%= __('profile_section_security') %>
                </h3>
            </div>

            <form action="/profile/password" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="password-grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                    <div class="form-group-luxury">
                        <label for="currentPassword"><%= __('profile_label_current_password') %></label>
                        <input type="password" id="currentPassword" name="currentPassword" required placeholder="••••••••">
                    </div>
                    <div class="form-group-luxury">
                        <label for="newPassword"><%= __('profile_label_new_password') %></label>
                        <input type="password" id="newPassword" name="newPassword" required placeholder="••••••••">
                    </div>
                    <div class="form-group-luxury">
                        <label for="confirmPassword"><%= __('profile_label_confirm_password') %></label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="••••••••">
                    </div>
                </div>

                <div style="margin-top: 30px; border-top: 1px solid #f1f5f9; padding-top: 25px; display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn-lux btn-lux-navy" style="padding: 12px 30px;">
                        <i class="fas fa-key" aria-hidden="true"></i> <%= __('profile_btn_update_password') %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function() {
            const output = document.getElementById('avatarPreview');
            if (output) output.src = reader.result;
        };
        reader.readAsDataURL(file);
    }
</script>

<style>
    .profile-settings-page__header {
        margin-bottom: 30px;
        background: white;
        padding: 25px;
        border-radius: var(--radius-md);
        border: 1px solid #e2e8f0;
    }
    .profile-settings-page__avatar-wrap {
        position: relative;
        width: 150px;
        height: 150px;
        margin: 0 auto 15px;
    }
    .profile-settings-page__avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 25px;
        border: 4px solid white;
        box-shadow: var(--shadow-md);
    }
    .profile-settings-page__avatar-btn {
        position: absolute;
        bottom: -10px;
        inset-inline-end: -10px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--secondary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s;
    }
    .profile-settings-page__avatar-btn:hover {
        transform: scale(1.05);
    }
    .profile-settings-page__avatar-input {
        display: none;
    }
    .form-group-luxury {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .form-group-luxury label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary);
    }
    .form-group-luxury input {
        padding: 12px 15px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        font-size: 0.9rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group-luxury input:focus {
        border-color: var(--secondary);
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 165, 68, 0.12);
    }
    @media (max-width: 992px) {
        .password-grid {
            grid-template-columns: 1fr 1fr !important;
        }
    }
    @media (max-width: 768px) {
        .profile-settings-top {
            gap: 20px !important;
        }
        .profile-avatar-col {
            flex: 1 1 100% !important;
        }
        .profile-fields-grid,
        .password-grid {
            min-width: 0 !important;
            grid-template-columns: 1fr !important;
        }
    }
</style>

<% if (user && usesAdminPanel(user)) { %>
    <%- include('../../partials/admin-layout-bottom') %>
<% } else if (user && user.role === 'donor') { %>
    <%- include('../../partials/donor-layout-bottom') %>
<% } else { %>
    <%- include('../../partials/family-layout-bottom') %>
<% } %>
