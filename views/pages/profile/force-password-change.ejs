<% const staffRoles = ['admin', 'super_admin', 'regulator', 'media', 'support']; %>
<% if (user && staffRoles.includes(user.role)) { %>
    <%- include('../../partials/admin-layout-top') %>
<% } else if (user && user.role === 'donor') { %>
    <%- include('../../partials/donor-layout-top') %>
<% } else { %>
    <%- include('../../partials/family-layout-top') %>
<% } %>

<div style="max-width: 640px; margin: 0 auto;">
    <div class="luxury-card glass-panel" style="padding: 35px; border-<%= langDir === 'rtl' ? 'right' : 'left' %>: 4px solid #f59e0b;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div style="width: 72px; height: 72px; margin: 0 auto 16px; border-radius: 20px; background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.8rem;">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h2 class="font-cairo" style="margin: 0 0 8px; font-weight: 800;"><%= __('force_password_change_title') %></h2>
            <p style="color: var(--text-muted); margin: 0; line-height: 1.7;"><%= __('force_password_change_desc') %></p>
        </div>

        <% if (error && error.length > 0) { %>
            <div style="background: #fef2f2; color: #b91c1c; padding: 14px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 0.92rem;">
                <i class="fas fa-circle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <form action="/profile/password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group-luxury" style="margin-bottom: 20px;">
                <label><%= __('force_password_change_email_label') %></label>
                <input type="email" name="email" value="<%= user.email %>" placeholder="<%= __('force_password_change_email_placeholder') %>">
                <small style="color: var(--text-muted); font-size: 0.8rem;"><%= __('force_password_change_email_hint') %></small>
            </div>

            <div class="form-group-luxury" style="margin-bottom: 20px;">
                <label><%= __('reset_password_new') %></label>
                <input type="password" name="newPassword" required minlength="6" placeholder="••••••••" autocomplete="new-password">
            </div>

            <div class="form-group-luxury" style="margin-bottom: 28px;">
                <label><%= __('reset_password_confirm') %></label>
                <input type="password" name="confirmPassword" required minlength="6" placeholder="••••••••" autocomplete="new-password">
            </div>

            <button type="submit" class="btn-lux btn-lux-primary" style="width: 100%; justify-content: center; padding: 14px;">
                <i class="fas fa-check"></i> <%= __('force_password_change_submit') %>
            </button>
        </form>
    </div>
</div>

<style>
    .form-group-luxury {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .form-group-luxury label {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary);
    }
    .form-group-luxury input {
        padding: 12px 15px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        font-family: inherit;
        font-size: 1rem;
    }
    .form-group-luxury input:focus {
        outline: none;
        border-color: var(--secondary);
        box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.15);
    }
</style>

<% if (user && staffRoles.includes(user.role)) { %>
    <%- include('../../partials/admin-layout-bottom') %>
<% } else if (user && user.role === 'donor') { %>
    <%- include('../../partials/donor-layout-bottom') %>
<% } else { %>
    <%- include('../../partials/family-layout-bottom') %>
<% } %>
