<%- include('../partials/header-top') %>

<main class="nm-contact-page">
    <section class="nm-page-hero" aria-label="<%= siteText('navbar_contact') %>">
        <div class="nm-page-hero__glow" aria-hidden="true"></div>
        <div class="nm-page-hero__watermark" aria-hidden="true"><%= siteText('hero_title') %></div>
        <div class="container nm-page-hero__inner">
            <p class="nm-page-hero__eyebrow"><%= siteText('contact_hero_badge') %></p>
            <h1 class="nm-page-hero__title"><%= siteText('contact_hero_title') %></h1>
            <p class="nm-page-hero__desc"><%= siteText('contact_hero_desc') %></p>
        </div>
        <svg class="nm-page-hero__horizon" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,48 C280,10 520,70 760,36 C1000,4 1220,58 1440,28 L1440,80 L0,80 Z" fill="#f8fafc"/>
        </svg>
    </section>

    <!-- Channels + form -->
    <section class="nm-contact-main" id="contact-form">
        <div class="container">
            <div class="nm-contact-layout">
                <div class="nm-contact-channels reveal-on-scroll">
                    <header class="nm-contact-head">
                        <span class="nm-contact-head__badge"><i class="fas fa-envelope"></i> <%= siteText('contact_channels_badge') %></span>
                        <h2 class="nm-contact-head__title"><%= siteText('contact_channels_title') %></h2>
                        <p class="nm-contact-head__desc"><%= siteText('contact_channels_desc') %></p>
                    </header>

                    <div class="nm-contact-channels__list">
                        <a href="<%= siteText('social_whatsapp') %>" target="_blank" rel="noopener" class="nm-contact-card">
                            <div class="nm-contact-card__icon nm-contact-card__icon--green"><i class="fab fa-whatsapp"></i></div>
                            <div class="nm-contact-card__text">
                                <h3><%= siteText('contact_whatsapp_title') %></h3>
                                <p><%= siteText('contact_whatsapp_desc') %></p>
                            </div>
                            <i class="fas fa-chevron-left nm-contact-card__arrow"></i>
                        </a>

                        <div class="nm-contact-card">
                            <div class="nm-contact-card__icon nm-contact-card__icon--navy"><i class="fas fa-envelope-open-text"></i></div>
                            <div class="nm-contact-card__text">
                                <h3><%= siteText('contact_email_title') %></h3>
                                <p><%= siteText('contact_email') %></p>
                            </div>
                        </div>

                        <div class="nm-contact-card">
                            <div class="nm-contact-card__icon nm-contact-card__icon--navy"><i class="fas fa-location-dot"></i></div>
                            <div class="nm-contact-card__text">
                                <h3><%= siteText('contact_office_title') %></h3>
                                <p><%= siteText('contact_office_desc') %></p>
                            </div>
                        </div>
                    </div>

                    <div class="nm-contact-social">
                        <a href="<%= siteText('social_facebook') %>" class="nm-contact-social__btn" aria-label="Facebook" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i></a>
                        <a href="<%= siteText('social_instagram') %>" class="nm-contact-social__btn" aria-label="Instagram" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
                        <a href="<%= siteText('social_twitter') %>" class="nm-contact-social__btn" aria-label="X" target="_blank" rel="noopener"><i class="fab fa-twitter"></i></a>
                        <a href="<%= siteText('social_youtube') %>" class="nm-contact-social__btn" aria-label="YouTube" target="_blank" rel="noopener"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <div class="nm-contact-form-wrap reveal-on-scroll" style="transition-delay: 0.12s">
                    <div class="nm-contact-form-card">
                        <h3 class="nm-contact-form-card__title"><%= siteText('contact_form_title') %></h3>
                        <p class="nm-contact-form-card__desc"><%= siteText('contact_form_desc') %></p>

                        <form action="/contact" method="POST" class="nm-contact-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="nm-contact-field">
                                <label for="contact-name"><%= __('contact_form_name') %></label>
                                <div class="nm-contact-field__input">
                                    <i class="fas fa-user"></i>
                                    <input id="contact-name" type="text" name="name" placeholder="<%= __('contact_form_name_placeholder') %>" required>
                                </div>
                            </div>

                            <div class="nm-contact-field">
                                <label for="contact-email"><%= siteText('contact_email_title') %></label>
                                <div class="nm-contact-field__input">
                                    <i class="fas fa-at"></i>
                                    <input id="contact-email" type="email" name="email" placeholder="example@mail.com" required>
                                </div>
                            </div>

                            <div class="nm-contact-field">
                                <label for="contact-subject"><%= __('contact_form_subject') %></label>
                                <div class="nm-contact-field__input">
                                    <i class="fas fa-tag"></i>
                                    <select id="contact-subject" name="subject">
                                        <option value="<%= __('contact_form_subject_donation') %>"><%= __('contact_form_subject_donation') %></option>
                                        <option value="<%= __('contact_form_subject_orphan') %>"><%= __('contact_form_subject_orphan') %></option>
                                        <option value="<%= __('contact_form_subject_complaint') %>"><%= __('contact_form_subject_complaint') %></option>
                                        <option value="<%= __('contact_form_subject_other') %>"><%= __('contact_form_subject_other') %></option>
                                    </select>
                                </div>
                            </div>

                            <div class="nm-contact-field">
                                <label for="contact-message"><%= __('contact_form_message') %></label>
                                <textarea id="contact-message" name="message" rows="5" placeholder="<%= __('contact_form_message_placeholder') %>" required></textarea>
                            </div>

                            <button type="submit" class="nm-contact-submit">
                                <i class="fas fa-paper-plane"></i> <%= __('contact_form_submit') %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map -->
    <section class="nm-contact-map">
        <div class="container">
            <div class="nm-contact-map__panel reveal-on-scroll">
                <div class="nm-contact-map__intro">
                    <div class="nm-contact-map__icon"><i class="fas fa-map-location-dot"></i></div>
                    <h2 class="nm-contact-map__title"><%= siteText('contact_map_title') %></h2>
                    <p class="nm-contact-map__desc"><%= siteText('contact_map_desc') %></p>
                    <span class="nm-contact-map__pin">
                        <i class="fas fa-location-arrow"></i>
                        دير البلح، قطاع غزة، فلسطين
                    </span>
                </div>

                <div class="nm-contact-map__frame">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1152.483!2d34.348582!3d31.419307!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzHCsDI1JzA5LjUiTiAzNMKwMjAnNTQuOSJF!5e0!3m2!1sar!2sps!4v1712396600000!5m2!1sar!2sps"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="<%= siteText('contact_map_title') %>">
                    </iframe>
                </div>

                <div class="nm-contact-map__footer">
                    <a href="https://maps.google.com/?q=31.419307,34.348582" target="_blank" rel="noopener" class="nm-contact-map__link">
                        <i class="fas fa-external-link-alt"></i>
                        المقر الرئيسي (فتح في خرائط جوجل)
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('active');
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => revealObserver.observe(el));
</script>

<%- include('../partials/footer-bottom') %>
