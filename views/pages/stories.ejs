<!DOCTYPE html>
<html lang="<%= locals.currentLocale || 'ar' %>" dir="<%= locals.langDir || 'rtl' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="<%= asset('/assets/css/premium.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/css/public-mobile.css') %>">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            width: 100%; height: 100%;
            overflow: hidden;
            background: #000;
            font-family: 'Tajawal', 'Cairo', sans-serif;
        }

        /* ── CONTAINER ── */
        #stories-container {
            width: 100%; height: 100dvh;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        #stories-container::-webkit-scrollbar { display: none; }

        /* ── SLIDE ── */
        .story-slide {
            width: 100%; height: 100dvh;
            scroll-snap-align: start;
            position: relative;
            overflow: hidden;
            background: #000;
            display: flex; align-items: center; justify-content: center;
        }

        /* ── MEDIA ── */
        .story-media {
            position: absolute; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover; border: none;
            opacity: 0;
            transform: scale(1.05);
            transition: opacity 0.5s ease, transform 8s ease-out;
        }
        .story-media.playing {
            opacity: 1; transform: scale(1);
        }
        .story-media.embed-frame.tiktok-frame,
        .story-media.embed-frame.instagram-frame {
            width: 100%;
            height: 100%;
            border: none;
            transform: scale(1.12);
            transform-origin: center center;
        }
        .story-media.embed-frame.tiktok-frame.playing,
        .story-media.embed-frame.instagram-frame.playing {
            transform: scale(1.05);
        }

        /* ── SKELETON LOADING ── */
        .story-skeleton {
            position: absolute; inset: 0; z-index: 1;
            background: linear-gradient(110deg, #1a1a2e 25%, #16213e 50%, #1a1a2e 75%);
            background-size: 200% 100%;
            animation: skeleton-wave 1.8s infinite linear;
        }
        @keyframes skeleton-wave {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* ── THUMBNAIL ── */
        .story-thumb {
            position: absolute; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            transition: opacity 0.6s ease;
            z-index: 2;
        }
        .story-thumb.hidden { opacity: 0; pointer-events: none; }

        /* ── GRADIENTS ── */
        .story-gradient {
            position: absolute; inset: 0;
            background: linear-gradient(to top,
                rgba(0,0,0,0.95) 0%,
                rgba(0,0,0,0.45) 38%,
                rgba(0,0,0,0.08) 65%,
                transparent 100%);
            z-index: 3; pointer-events: none;
        }
        .story-gradient-top {
            position: absolute; top: 0; left: 0; right: 0;
            height: 200px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent);
            z-index: 3; pointer-events: none;
        }

        /* ── TOP BAR ── */
        .stories-topbar {
            position: fixed; top: 0; left: 0; right: 0;
            z-index: 200;
            display: flex; align-items: center; justify-content: space-between;
            padding: calc(env(safe-area-inset-top, 0px) + 12px) 16px 12px;
            pointer-events: none;
        }
        .stories-topbar > * { pointer-events: auto; }

        .stories-logo {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; color: white;
        }
        .stories-logo img { height: 34px; filter: brightness(0) invert(1); }
        .stories-logo-text {
            display: flex; flex-direction: column;
        }
        .stories-logo-text span:first-child {
            font-family: 'Cairo', sans-serif; font-weight: 900;
            font-size: 1rem; color: white;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
            line-height: 1.1;
        }

        /* ① Live counter */
        .stories-live-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: linear-gradient(135deg, rgba(239,68,68,0.85), rgba(220,38,38,0.85));
            border-radius: 20px; padding: 2px 9px;
            font-size: 0.7rem; font-weight: 800; color: white;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255,255,255,0.2);
            margin-top: 3px;
        }
        .live-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: white;
            animation: live-pulse 1.5s infinite;
        }
        @keyframes live-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.4; transform: scale(0.75); }
        }

        .stories-close-btn {
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.22);
            color: white; width: 44px; height: 44px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; backdrop-filter: blur(10px);
            font-size: 1.2rem; text-decoration: none;
            transition: background 0.2s;
        }
        .stories-close-btn:hover { background: rgba(255,255,255,0.28); }

        /* Progress bar */
        .stories-progress-wrap {
            position: fixed;
            top: calc(env(safe-area-inset-top, 0px) + 56px);
            left: 14px; right: 14px;
            z-index: 201;
            height: 3px;
            background: rgba(255,255,255,0.22);
            border-radius: 4px;
            overflow: hidden;
            pointer-events: none;
        }
        .stories-progress-fill {
            height: 100%; width: 0%;
            background: #fff;
            border-radius: 4px;
            transition: width 0.15s linear;
        }
        .stories-progress-fill.indeterminate {
            width: 35%;
            animation: progress-indeterminate 1.4s ease-in-out infinite;
        }
        @keyframes progress-indeterminate {
            0% { transform: translateX(-120%); }
            100% { transform: translateX(320%); }
        }

        .story-position-counter {
            position: fixed;
            top: calc(env(safe-area-inset-top, 0px) + 66px);
            left: 16px;
            z-index: 201;
            font-size: 0.72rem;
            font-weight: 800;
            color: rgba(255,255,255,0.75);
            text-shadow: 0 2px 6px rgba(0,0,0,0.6);
            pointer-events: none;
        }

        /* Tap zones */
        .story-tap-zones {
            position: absolute; inset: 0;
            z-index: 5;
            display: flex;
            pointer-events: none;
        }
        .story-tap-prev, .story-tap-next, .story-tap-center {
            border: none; background: transparent;
            pointer-events: auto;
            cursor: pointer;
        }
        .story-tap-prev { width: 28%; }
        .story-tap-center { flex: 1; }
        .story-tap-next { width: 28%; }

        .sound-hint {
            position: fixed;
            bottom: calc(env(safe-area-inset-bottom, 0px) + 120px);
            left: 50%; transform: translateX(-50%);
            z-index: 210;
            display: flex; align-items: center; gap: 8px;
            background: rgba(0,0,0,0.55);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            padding: 10px 18px;
            border-radius: 30px;
            font-size: 0.82rem;
            font-weight: 800;
            backdrop-filter: blur(8px);
            animation: hint-pulse 2s ease-in-out infinite;
        }
        .sound-hint.hidden { display: none; }
        @keyframes hint-pulse {
            0%, 100% { opacity: 0.85; }
            50% { opacity: 1; }
        }

        .stories-load-sentinel {
            width: 100%; height: 40px;
            display: none; align-items: center; justify-content: center;
            color: rgba(255,255,255,0.5);
            font-size: 0.8rem;
            font-weight: 700;
        }
        .stories-load-sentinel.visible { display: flex; }

        .story-media-mount {
            position: absolute; inset: 0;
            z-index: 1;
        }

        /* ── RIGHT ACTIONS ── */
        .story-actions {
            position: absolute; right: 18px; bottom: 230px;
            z-index: 10;
            display: flex; flex-direction: column; gap: 18px; align-items: center;
        }
        .action-btn {
            display: flex; flex-direction: column; align-items: center; gap: 5px;
            background: none; border: none; color: white;
            cursor: pointer; font-family: 'Cairo', sans-serif; padding: 0;
        }
        .action-btn-icon {
            width: 52px; height: 52px;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; backdrop-filter: blur(8px);
            transition: all 0.2s;
        }
        .action-btn:hover .action-btn-icon { background: rgba(255,255,255,0.3); transform: scale(1.1); }
        .action-btn span { font-size: 0.72rem; font-weight: 700; text-shadow: 0 1px 4px rgba(0,0,0,0.8); }

        /* ── BOTTOM INFO ── */
        .story-info {
            position: absolute; bottom: 0; right: 0;
            width: 88%;
            z-index: 10;
            padding: 24px 18px calc(env(safe-area-inset-bottom, 0px) + 28px);
            text-align: right;
        }

        .story-badges-row {
            display: flex; align-items: center; justify-content: flex-start;
            gap: 8px; margin-bottom: 12px; flex-wrap: wrap;
        }

        .story-type-badge {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--secondary, #00A544); color: white;
            border-radius: 30px; padding: 5px 14px;
            font-size: 0.8rem; font-weight: 800; font-family: 'Cairo', sans-serif;
        }

        /* ④ URGENT badge — pulsing red */
        .story-urgent-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(239, 68, 68, 0.9); color: white;
            border-radius: 30px; padding: 5px 12px;
            font-size: 0.78rem; font-weight: 900; font-family: 'Cairo', sans-serif;
            animation: urgent-pulse 1.8s ease-in-out infinite;
            border: 1px solid rgba(255,100,100,0.5);
        }
        @keyframes urgent-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.5); }
            50%       { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
        }

        .story-title-text {
            font-family: 'Cairo', sans-serif; font-size: 1.5rem; font-weight: 900;
            color: white; line-height: 1.35; margin-bottom: 8px;
            text-shadow: 0 3px 12px rgba(0,0,0,0.8);
        }
        .story-desc-text {
            font-size: 0.9rem; color: rgba(255,255,255,0.8);
            line-height: 1.6; margin-bottom: 14px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.6);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* ⑦ Supporters count */
        .story-supporters {
            display: flex; align-items: center; justify-content: flex-start;
            gap: 8px; margin-bottom: 14px;
        }
        .story-supporters-avatars {
            display: flex;
        }
        .supporter-avatar {
            width: 26px; height: 26px; border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.4);
            background: linear-gradient(135deg, #00A544, #016630);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.65rem; color: white; font-weight: 900;
            margin-inline-start: -8px;
        }
        .supporter-avatar:first-child { margin-inline-start: 0; }
        .story-supporters-text {
            font-size: 0.82rem; color: rgba(255,255,255,0.75);
            text-shadow: 0 1px 6px rgba(0,0,0,0.6); font-weight: 700;
        }
        .story-supporters-text strong { color: #00C758; }

        /* Donation bar */
        .story-donation-bar { margin-bottom: 18px; }
        .story-amounts {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;
            flex-direction: row-reverse;
        }
        .story-raised {
            font-family: 'Cairo', sans-serif; font-weight: 900;
            font-size: 1.1rem; color: white;
            text-shadow: 0 2px 8px rgba(0,0,0,0.7);
        }
        .story-raised span { color: #00C758; }
        .story-target {
            font-size: 0.83rem; color: rgba(255,255,255,0.7); font-weight: 700;
            text-shadow: 0 2px 6px rgba(0,0,0,0.6);
        }
        .story-bar-track {
            height: 6px; background: rgba(255,255,255,0.2);
            border-radius: 10px; overflow: hidden;
        }
        .story-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #00A544, #00C758);
            border-radius: 10px;
            box-shadow: 0 0 14px rgba(52,211,153,0.65);
            transition: width 1.2s ease;
        }

        /* CTA */
        .story-cta-btn {
            display: flex; align-items: center; justify-content: center; gap: 12px;
            width: 100%; padding: 16px 28px;
            background: linear-gradient(135deg, #00A544, #016630);
            color: white; border: none; border-radius: 18px;
            font-family: 'Cairo', sans-serif; font-size: 1.1rem; font-weight: 900;
            cursor: pointer; text-decoration: none;
            box-shadow: 0 8px 30px rgba(0,165,68,0.5);
            transition: all 0.25s ease;
        }
        .story-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(0,165,68,0.65); color: white; }

        /* Scroll hint */
        @keyframes bounce-up { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-10px)} }
        .scroll-hint {
            position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
            z-index: 20;
            display: flex; flex-direction: column; align-items: center; gap: 6px;
            color: rgba(255,255,255,0.5); font-size: 0.75rem;
            animation: bounce-up 2s infinite;
            pointer-events: none;
            transition: opacity 0.5s;
        }
        .scroll-hint i { font-size: 1.3rem; }

        /* Empty */
        .stories-empty {
            width: 100%; height: 100dvh;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            color: white; text-align: center; padding: 40px;
            background: linear-gradient(135deg, #032E15, #002661);
        }
        .stories-empty i { font-size: 5rem; color: rgba(255,255,255,0.2); margin-bottom: 25px; }
        .stories-empty h2 { font-family: 'Cairo', sans-serif; font-size: 1.8rem; font-weight: 900; margin-bottom: 15px; }
        .stories-empty p { color: rgba(255,255,255,0.6); line-height: 1.8; max-width: 400px; }

        .stories-empty-btn {
            margin-top: 30px;
            display: inline-flex; align-items: center; gap: 10px;
            background: white; color: #032E15;
            padding: 14px 30px; border-radius: 12px;
            font-family: 'Cairo', sans-serif; font-weight: 900;
            text-decoration: none;
        }

        @media (max-width: 600px) {
            .story-title-text { font-size: 1.2rem; }
            .story-actions { right: 10px; bottom: calc(env(safe-area-inset-bottom, 0px) + 200px); }
            .story-info { width: 92%; padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 22px); }
        }
    </style>
</head>
<body class="stories-page">

<!-- ── TOP BAR ── -->
<div class="stories-topbar">
    <a href="/" class="stories-logo">
        <img src="/logo-senabil-white.png" alt="نَمير" class="header-logo-story">
        <div class="stories-logo-text">
            <span>نَمير</span>
            <!-- ① Live Counter Badge -->   
            <span class="stories-live-badge">
                <span class="live-dot"></span>
                <span id="live-count"><%= storiesTotal || 0 %></span> قصة حية
            </span>
        </div>
    </a>
    <a href="/" class="stories-close-btn" title="العودة للرئيسية">
        <i class="fas fa-xmark"></i>
    </a>
</div>
<% if (!locals.cloudinaryEnabled && locals.user && (locals.user.role === 'admin' || locals.user.role === 'super_admin')) { %>
<div style="position: fixed; top: 74px; left: 16px; right: 16px; z-index: 250; padding: 10px 12px; border-radius: 14px; background: rgba(239,68,68,0.18); border: 1px solid rgba(239,68,68,0.35); color: rgba(255,255,255,0.92); font-size: 0.78rem; font-weight: 800; backdrop-filter: blur(10px);">
    Cloudinary غير مُفعّل على السيرفر. روابط الفيديو المباشرة قد تُعرض كـ (صوت فقط) على الجوال. فعّل `CLOUDINARY_*` أو استخدم YouTube Shorts.
</div>
<% } %>

<div class="stories-progress-wrap" aria-hidden="true">
    <div class="stories-progress-fill" id="stories-progress-fill"></div>
</div>
<div class="story-position-counter" id="story-position">—</div>

<div id="sound-hint" class="sound-hint hidden">
    <i class="fas fa-volume-high"></i>
    <span>اضغط لتشغيل الصوت</span>
</div>

<div id="stories-container">
    <div class="story-slide story-boot-loader" style="height:100dvh;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.6);font-weight:800;">
        <i class="fas fa-circle-notch fa-spin" style="margin-left:10px;"></i> جاري تحميل القصص...
    </div>
    <div id="stories-load-sentinel" class="stories-load-sentinel">
        <i class="fas fa-circle-notch fa-spin" style="margin-left:8px;"></i> تحميل المزيد...
    </div>
</div>

<script>
    window.__STORIES_BOOT__ = {
        total: <%= storiesTotal || 0 %>,
        caseId: <%- JSON.stringify(initialCaseId || '') %>,
        pageSize: 3
    };
</script>
<script src="<%= asset('/assets/js/stories-feed.js') %>" defer></script>

</body>
</html>
