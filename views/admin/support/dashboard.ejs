<%- include('../../partials/admin-layout-top') %>

<div class="nm-admin-card nm-admin-page-header nm-admin-page-header--accent">
    <h3 class="font-cairo" style="margin: 0;"><i class="fas fa-headset"></i> <%= __('admin_sidebar_support_center') %></h3>
    <p style="color: var(--text-muted); margin-top: 5px;"><%= __('admin_support_center_desc') %></p>
</div>

<div class="support-head-row" style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 24px;">
    <div class="support-stats-row" style="display: flex; gap: 15px;">
        <div class="stat-card" style="padding: 15px 25px; min-width: 150px; text-align: center;">
            <span style="display: block; font-size: 0.85rem; color: var(--text-light);"><%= __('admin_support_total_tickets') %></span>
            <strong style="font-size: 1.5rem;"><%= tickets.length %></strong>
        </div>
        <div class="stat-card" style="padding: 15px 25px; min-width: 150px; text-align: center; border-<%= langDir === 'rtl' ? 'right' : 'left' %>: 4px solid var(--secondary);">
            <span style="display: block; font-size: 0.85rem; color: var(--text-light);"><%= __('admin_support_active_tickets') %></span>
            <strong style="font-size: 1.5rem;"><%= tickets.filter(t => t.status !== 'closed' && t.status !== 'resolved').length %></strong>
        </div>
    </div>
</div>

<div class="grid-4 support-layout-grid" style="grid-template-columns: 350px 1fr; gap: 30px; height: 700px; align-items: stretch;">
    <div class="luxury-card" style="padding: 0; background: white; overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 20px; border-bottom: 1px solid #f1f5f9; background: #f8fafc;">
            <h5 class="font-cairo" style="margin: 0; font-weight: 800;"><%= __('admin_support_tickets_list') %></h5>
        </div>
        <div style="flex: 1; overflow-y: auto;">
            <% if (tickets.length === 0) { %>
                <div style="text-align: center; padding: 40px; opacity: 0.5;">
                    <p><%= __('admin_support_no_tickets') %></p>
                </div>
            <% } %>
            <% tickets.forEach(t => { %>
                <div class="ticket-item <%= t.status %>" onclick="loadTicketMessages('<%= t._id %>')" style="
                    padding: 20px;
                    border-bottom: 1px solid #f1f5f9;
                    cursor: pointer;
                    transition: var(--transition-fast);
                    position: relative;
                ">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                        <img src="<%= t.user ? userAvatar(t.user) : userAvatar({}) %>" style="width: 35px; height: 35px; border-radius: 50%; object-fit: cover;">
                        <div style="flex: 1; overflow: hidden;">
                            <h6 style="margin: 0; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= t.user.name %></h6>
                            <span style="font-size: 0.75rem; color: var(--text-light);"><%= t.user.role === 'donor' ? __('common_donor') : __('common_family') %></span>
                        </div>
                        <span style="font-size: 0.65rem; color: var(--text-light);">
                            <%= new Date(t.lastMessageAt).toLocaleDateString(lang === 'ar' ? 'ar-SA' : 'en-US') %>
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="badge <%= t.status === 'open' ? 'badge-gold' : (t.status === 'in_progress' ? 'badge-teal' : (t.status === 'resolved' ? 'badge-success' : 'badge-navy')) %>" style="font-size: 0.65rem;">
                            <%= t.status === 'open' ? __('admin_support_status_new') : (t.status === 'in_progress' ? __('admin_support_status_in_progress') : (t.status === 'resolved' ? __('admin_support_status_resolved') : __('admin_support_status_closed'))) %>
                        </span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div id="chat-window-container" style="display: none;"></div>

    <div id="chat-placeholder" class="luxury-card" style="display: flex; align-items: center; justify-content: center; background: white; opacity: 0.6;">
        <div style="text-align: center;">
            <i class="fas fa-inbox" style="font-size: 4rem; margin-bottom: 20px; color: var(--text-light);"></i>
            <h4 class="font-cairo"><%= __('admin_support_select_ticket') %></h4>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();

    socket.on('newSupportMessage', (data) => {
        const ticketItem = document.querySelector(`.ticket-item[onclick*="${data.ticketId}"]`);
        if (ticketItem) {
            const container = ticketItem.parentElement;
            container.prepend(ticketItem);

            if (!data.isAdminTeam) {
                const badge = ticketItem.querySelector('.badge');
                badge.className = 'badge badge-gold';
                badge.innerText = '<%= __('admin_support_status_new') %>';
            }
        }
    });

    function loadTicketMessages(ticketId) {
        window.location.href = '/support/chat?adminTicketId=' + ticketId;
    }
</script>

<style>
    .ticket-item:hover { background: #f8fafc; }
    .ticket-item.active { background: #eef2ff; border-right: 4px solid var(--primary); }
    .badge-gold { background: rgba(0, 165, 68, 0.12); color: var(--secondary); border: 1px solid rgba(0, 165, 68, 0.22); }
    .badge-teal { background: #f0fdfa; color: #016630; }
    .badge-success { background: #f0fdf4; color: #166534; }
    .badge-navy { background: #f1f5f9; color: #475569; }

    @media (max-width: 992px) {
        .support-head-row {
            flex-direction: column;
            align-items: stretch !important;
            gap: 15px;
            margin-bottom: 20px !important;
        }

        .support-stats-row {
            flex-wrap: wrap;
        }

        .support-layout-grid {
            grid-template-columns: 1fr !important;
            height: auto !important;
        }
    }
</style>

<%- include('../../partials/admin-layout-bottom') %>
