<%
    const _navPath = (typeof currentPath !== 'undefined' ? currentPath : '') || '';
    const navExact = (path) => _navPath === path;
    const navPrefix = (path) => _navPath === path || _navPath.startsWith(path + '/');
    const navCases = () => navExact('/admin/cases-manager') || /^\/admin\/cases\/[^/]+\/(media-review|field-report)$/.test(_navPath);
    const navAllUsers = () => navExact('/admin/all-users') || /^\/admin\/users\/[^/]+\/moderation$/.test(_navPath);
    const navTeam = () => navExact('/admin/users');
%>
<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-close-btn" id="sidebarClose">
        <i class="fas fa-times"></i>
    </div>
    <div class="admin-sidebar-header">
        <a href="/" class="logo-luxury" style="color: white; font-size: 1.3rem;">
            <img src="/logo-senabil-white.png" alt="نَمير" style="height: 36px; width: auto;">
            <span class="font-cairo" style="color:#fff;"><%= __('site_name') %></span>
        </a>
    </div>

    <div class="admin-sidebar-nav" id="adminSidebarNav">
        <!-- Main group (always visible) -->
        <div class="admin-nav-group-label"><%= __('admin_sidebar_group_main') %></div>
        <a href="/admin/dashboard" class="admin-nav-item<%= navExact('/admin/dashboard') ? ' active' : '' %>">
            <i class="fas fa-chart-line"></i>
            <span><%= __('admin_sidebar_dashboard') %></span>
        </a>

        <!-- Cases / Media Cases (conditional for media role) -->
        <% if (user && user.role === 'media') { %>
            <a href="/admin/cases-manager" class="admin-nav-item<%= navCases() ? ' active' : '' %>">
                <i class="fas fa-photo-film"></i>
                <span><%= __('admin_sidebar_media_cases') %></span>
            </a>
        <% } else { %>
            <a href="/admin/cases-manager" class="admin-nav-item<%= navCases() ? ' active' : '' %>">
                <i class="fas fa-folder-open"></i>
                <span><%= __('admin_sidebar_cases_manager') %></span>
            </a>
        <% } %>

        <!-- Management group -->
        <div class="admin-nav-group-label"><%= __('admin_sidebar_group_management') %></div>
        <a href="/admin/chat-requests" class="admin-nav-item<%= navExact('/admin/chat-requests') ? ' active' : '' %>">
            <i class="fas fa-comments"></i>
            <span><%= __('admin_sidebar_chat_requests') %></span>
        </a>
        <a href="/support/admin/dashboard" class="admin-nav-item<%= navPrefix('/support/admin') ? ' active' : '' %>">
            <i class="fas fa-headset"></i>
            <span><%= __('admin_sidebar_support_center') %></span>
        </a>
        <a href="/admin/monitor-chats" class="admin-nav-item<%= navPrefix('/admin/monitor-chats') ? ' active' : '' %>">
            <i class="fas fa-shield-halved"></i>
            <span><%= __('admin_sidebar_chat_monitor') %></span>
        </a>
        <a href="/admin/analytics" class="admin-nav-item<%= navExact('/admin/analytics') ? ' active' : '' %>">
            <i class="fas fa-chart-pie"></i>
            <span><%= __('admin_sidebar_analytics') %></span>
        </a>
        <a href="/admin/distribution" class="admin-nav-item<%= navPrefix('/admin/distribution') ? ' active' : '' %>">
            <i class="fas fa-hand-holding-dollar"></i>
            <span><%= __('admin_sidebar_distribution') %></span>
        </a>
        <% if (user && isSuperAdmin(user)) { %>
        <a href="/admin/activity-logs" class="admin-nav-item<%= navExact('/admin/activity-logs') ? ' active' : '' %>">
            <i class="fas fa-binoculars"></i>
            <span><%= __('admin_sidebar_activity_logs') %></span>
        </a>
        <% } %>
        <a href="/admin/pending-approvals" class="admin-nav-item<%= navExact('/admin/pending-approvals') ? ' active' : '' %>">
            <i class="fas fa-user-clock"></i>
            <span><%= __('admin_sidebar_pending_approvals') %></span>
        </a>
        <a href="/admin/escalations" class="admin-nav-item<%= navPrefix('/admin/escalations') ? ' active' : '' %>" style="<%= langDir === 'rtl' ? 'border-right: 3px solid #ef4444; padding-right: 17px;' : 'border-left: 3px solid #ef4444; padding-left: 17px;' %>">
            <i class="fas fa-tower-observation" style="color: #ef4444;"></i>
            <span><%= __('admin_sidebar_escalations') %></span>
        </a>
        <a href="/admin/all-users" class="admin-nav-item<%= navAllUsers() ? ' active' : '' %>">
            <i class="fas fa-users"></i>
            <span><%= __('admin_sidebar_all_users') %></span>
        </a>

        <% if (user && user.role === 'super_admin') { %>
            <div class="admin-nav-group-label"><%= __('admin_sidebar_group_super_admin') %></div>
            <a href="/admin/content-management" class="admin-nav-item<%= navExact('/admin/content-management') ? ' active' : '' %>">
                <i class="fas fa-wand-magic-sparkles"></i>
                <span><%= __('admin_sidebar_content_management') %></span>
            </a>
            <a href="/admin/users" class="admin-nav-item<%= navTeam() ? ' active' : '' %>">
                <i class="fas fa-users-cog"></i>
                <span><%= __('admin_sidebar_team_management') %></span>
            </a>
            <a href="/admin/donations-ledger" class="admin-nav-item<%= navPrefix('/admin/donations-ledger') ? ' active' : '' %>">
                <i class="fas fa-receipt"></i>
                <span><%= __('admin_sidebar_donations_ledger') %></span>
            </a>
            <a href="/admin/settings" class="admin-nav-item<%= navExact('/admin/settings') || navExact('/admin/password-recovery') ? ' active' : '' %>">
                <i class="fas fa-cogs"></i>
                <span><%= __('admin_sidebar_settings') %></span>
            </a>
        <% } %>

        <!-- Account group -->
        <div class="admin-nav-group-label"><%= __('admin_sidebar_group_account') %></div>
        <a href="/profile/settings" class="admin-nav-item<%= navExact('/profile/settings') ? ' active' : '' %>">
            <i class="fas fa-user-circle"></i>
            <span><%= __('admin_sidebar_my_profile') %></span>
        </a>
        <a href="/auth/logout" class="admin-nav-item" style="color: #ef4444;">
            <i class="fas fa-sign-out-alt"></i>
            <span><%= __('admin_sidebar_logout') %></span>
        </a>
    </div>

    <div class="admin-sidebar-footer">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="<%= userAvatar(user) %>" style="width: 35px; height: 35px; border-radius: 50%; border: 1.5px solid var(--secondary); object-fit: cover;">
            <div style="font-size: 0.85rem;">
                <div style="font-weight: 700; color: white;"><%= user.name %></div>
                <div style="color: rgba(255,255,255,0.4); font-size: 0.75rem;">
                    <%= user.role === 'super_admin' ? __('admin_role_super_admin') :
                        user.role === 'regulator' ? __('admin_role_regulator') :
                        user.role === 'support' ? __('admin_role_support') :
                        user.role === 'media' ? __('admin_role_media') :
                        __('admin_role_admin') %>
                </div>
            </div>
        </div>
    </div>
</aside>
