<% const prefix = typeof emblemPrefix !== 'undefined' ? emblemPrefix : 'nmImpact'; %>
<% const showLabels = typeof showEmblemLabels === 'undefined' ? true : showEmblemLabels; %>
<% const showParticles = typeof showEmblemParticles === 'undefined' ? true : showEmblemParticles; %>
<svg class="nm-home-give-emblem" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="<%= siteText('hero_tagline') %>">
    <defs>
        <linearGradient id="<%= prefix %>Stream" x1="80" y1="320" x2="320" y2="80" gradientUnits="userSpaceOnUse">
            <stop stop-color="#69FF97" stop-opacity="0.15"/>
            <stop offset="0.35" stop-color="#69FF97"/>
            <stop offset="0.7" stop-color="#00C758"/>
            <stop offset="1" stop-color="#E8FFE8"/>
        </linearGradient>
        <linearGradient id="<%= prefix %>Ring" x1="0" y1="0" x2="400" y2="400" gradientUnits="userSpaceOnUse">
            <stop stop-color="#69FF97" stop-opacity="0.05"/>
            <stop offset="0.5" stop-color="#69FF97" stop-opacity="0.55"/>
            <stop offset="1" stop-color="#69FF97" stop-opacity="0.05"/>
        </linearGradient>
        <radialGradient id="<%= prefix %>Halo" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(200 210) rotate(90) scale(155 140)">
            <stop stop-color="#69FF97" stop-opacity="0.32"/>
            <stop offset="1" stop-color="#69FF97" stop-opacity="0"/>
        </radialGradient>
        <% if (showParticles) { %>
        <filter id="<%= prefix %>Blur" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="10" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="<%= prefix %>Soft" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="4" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <% } %>
    </defs>

    <ellipse cx="200" cy="210" rx="152" ry="138" fill="url(#<%= prefix %>Halo)" class="nm-impact-halo"/>
    <circle cx="200" cy="200" r="168" class="nm-impact-orbit" stroke="url(#<%= prefix %>Ring)" stroke-width="1.5" fill="none"/>
    <% if (showParticles) { %>
    <path d="M 96 302 C 142 248, 178 205, 200 182 C 222 159, 258 122, 304 96" stroke="url(#<%= prefix %>Stream)" stroke-width="14" stroke-linecap="round" opacity="0.12" filter="url(#<%= prefix %>Blur)"/>
    <% } %>
    <path class="nm-impact-stream" d="M 96 302 C 142 248, 178 205, 200 182 C 222 159, 258 122, 304 96" stroke="url(#<%= prefix %>Stream)" stroke-width="2.5" stroke-linecap="round"/>

    <% if (showParticles) { %>
    <g filter="url(#<%= prefix %>Soft)">
        <circle r="5" fill="#E8FFE8">
            <animateMotion dur="3.6s" repeatCount="indefinite" path="M 96 302 C 142 248, 178 205, 200 182 C 222 159, 258 122, 304 96"/>
        </circle>
        <circle r="3.5" fill="#69FF97" opacity="0.85">
            <animateMotion dur="3.6s" begin="1.2s" repeatCount="indefinite" path="M 96 302 C 142 248, 178 205, 200 182 C 222 159, 258 122, 304 96"/>
        </circle>
        <circle r="2.5" fill="#B8F5C8" opacity="0.9">
            <animateMotion dur="3.6s" begin="2.4s" repeatCount="indefinite" path="M 96 302 C 142 248, 178 205, 200 182 C 222 159, 258 122, 304 96"/>
        </circle>
    </g>
    <% } %>

    <g transform="translate(142, 238)">
        <g class="nm-impact-stage nm-impact-stage--give">
            <circle r="22" fill="#016630" fill-opacity="0.35" stroke="#69FF97" stroke-opacity="0.5" stroke-width="1.2"/>
            <path d="M0 -7 C-6 -14 -13 -9 -13 -1 C-13 7 0 16 0 16 C0 16 13 7 13 -1 C13 -9 6 -14 0 -7Z" stroke="#E8FFE8" stroke-width="1.6" fill="none"/>
        </g>
    </g>
    <g transform="translate(200, 182)">
        <g class="nm-impact-stage nm-impact-stage--verify">
            <circle r="26" fill="#016630" fill-opacity="0.4" stroke="#69FF97" stroke-opacity="0.65" stroke-width="1.4"/>
            <path d="M0 -14 L18 -6 V8 C18 18 0 26 0 26 C0 26 -18 18 -18 8 V-6 Z" stroke="#E8FFE8" stroke-width="1.6" fill="none"/>
            <path class="nm-impact-check" d="M-7 4 L-1 11 L9 -3" stroke="#69FF97" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
    </g>
    <g transform="translate(258, 128)">
        <g class="nm-impact-stage nm-impact-stage--reach">
            <circle r="20" fill="#016630" fill-opacity="0.32" stroke="#69FF97" stroke-opacity="0.45" stroke-width="1.2"/>
            <path d="M-12 6 L0 -14 L12 6 V18 H-12 Z" stroke="#E8FFE8" stroke-width="1.5" fill="none"/>
            <rect x="-5" y="2" width="10" height="8" rx="1" fill="#69FF97" fill-opacity="0.35"/>
        </g>
    </g>

    <g transform="translate(96, 302)">
        <g class="nm-impact-anchor nm-impact-anchor--donor">
            <circle r="40" fill="none" stroke="#69FF97" stroke-opacity="0.25" stroke-width="1"/>
            <circle r="34" fill="#012a16" fill-opacity="0.55" stroke="url(#<%= prefix %>Stream)" stroke-width="2"/>
            <circle cy="-4" r="9" fill="none" stroke="#E8FFE8" stroke-width="1.8"/>
            <path d="M-16 14 C-10 2 10 2 16 14" stroke="#E8FFE8" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M-8 22 V14 M8 22 V14" stroke="#69FF97" stroke-width="1.6" stroke-linecap="round"/>
            <circle class="nm-impact-pulse" r="8" cy="18" fill="#69FF97" fill-opacity="0.35"/>
        </g>
    </g>

    <g transform="translate(304, 96)">
        <g class="nm-impact-anchor nm-impact-anchor--family">
            <circle class="nm-impact-arrival" r="20" fill="none" stroke="#69FF97" stroke-width="1.2" opacity="0.55"/>
            <circle class="nm-impact-arrival nm-impact-arrival--delay" r="20" fill="none" stroke="#69FF97" stroke-width="1" opacity="0.35"/>
            <circle r="38" fill="#012a16" fill-opacity="0.55" stroke="url(#<%= prefix %>Stream)" stroke-width="2"/>
            <path d="M-16 8 L0 -20 L16 8 V22 H-16 Z" stroke="#E8FFE8" stroke-width="1.8" fill="none"/>
            <rect x="-7" y="0" width="14" height="10" rx="1.5" fill="#69FF97" fill-opacity="0.45" class="nm-impact-window"/>
            <path d="M0 -4 C-4 -9 -10 -6 -10 -1 C-10 5 0 11 0 11 C0 11 10 5 10 -1 C10 -6 4 -9 0 -4Z" fill="#00C758" fill-opacity="0.85"/>
        </g>
    </g>

    <% if (showLabels) { %>
    <g class="nm-impact-labels" fill="#B8F5C8" font-family="Cairo, sans-serif" font-size="9" font-weight="700" opacity="0.72">
        <text x="96" y="352" text-anchor="middle"><%= siteText('hero_emblem_donor') %></text>
        <text x="200" y="228" text-anchor="middle"><%= siteText('hero_emblem_verify') %></text>
        <text x="304" y="148" text-anchor="middle"><%= siteText('hero_emblem_family') %></text>
    </g>
    <% } %>
</svg>
