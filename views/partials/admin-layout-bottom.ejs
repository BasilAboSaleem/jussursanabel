        </div>
    </main>

    <script>
        // Sidebar Toggle for Mobile Improved
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('adminSidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const sidebarClose = document.getElementById('sidebarClose');
        
        const toggleSidebar = () => {
            sidebar.classList.toggle('active');
            if (sidebarOverlay) sidebarOverlay.classList.toggle('active');
        };

        const closeSidebar = () => {
            sidebar.classList.remove('active');
            if (sidebarOverlay) sidebarOverlay.classList.remove('active');
        };

        if (sidebarToggle && sidebar) {
            sidebarToggle.addEventListener('click', toggleSidebar);
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', closeSidebar);
        }

        if (sidebarClose) {
            sidebarClose.addEventListener('click', closeSidebar);
        }

        // Scroll the active sidebar item into view
        const activeNavLink = document.querySelector('.admin-sidebar .admin-nav-item.active');
        if (activeNavLink) {
            requestAnimationFrame(() => {
                activeNavLink.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
        }

        const adminBackBtn = document.getElementById('adminBackBtn');
        if (adminBackBtn) {
            adminBackBtn.addEventListener('click', () => {
                const target = adminBackBtn.dataset.target || '/admin/dashboard';
                window.location.assign(target);
            });
        }

    </script>
