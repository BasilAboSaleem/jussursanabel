<footer class="premium-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-col-brand">
                <a href="/" class="footer-brand-link">
                    <img src="/logo-senabil-white.png" alt="<%= siteText('hero_title') %>" class="footer-brand-logo">
                    <span class="footer-brand-name">
                        <strong><%= siteText('hero_title') %></strong>
                        <small><%= siteText('brand_affiliation_short') %></small>
                    </span>
                </a>
                <p class="footer-desc">
                    <%= siteText('footer_desc') %>
                </p>
                <div class="footer-social-row">
                    <a href="<%= siteText('social_facebook') %>" class="social-btn-lux" aria-label="Facebook" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i></a>
                    <a href="<%= siteText('social_instagram') %>" class="social-btn-lux" aria-label="Instagram" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
                    <a href="<%= siteText('social_youtube') %>" class="social-btn-lux" aria-label="YouTube" target="_blank" rel="noopener"><i class="fab fa-youtube"></i></a>
                    <a href="<%= siteText('social_whatsapp') %>" class="social-btn-lux" aria-label="WhatsApp" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i></a>
                    <a href="<%= siteText('social_twitter') %>" class="social-btn-lux" aria-label="Twitter" target="_blank" rel="noopener"><i class="fab fa-twitter"></i></a>
                    <a href="<%= siteText('social_tiktok') %>" class="social-btn-lux" aria-label="TikTok" target="_blank" rel="noopener"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>

            <div class="footer-col-links">
                <h4 class="font-cairo footer-heading">
                    <%= siteText('footer_links_title') %>
                    <div class="footer-heading-line"></div>
                </h4>
                <ul class="footer-links">
                    <li><a href="/about" class="footer-link-lux"><%= siteText('about_us') %></a></li>
                    <li><a href="/cases" class="footer-link-lux"><%= siteText('footer_all_cases') %></a></li>
                    <li><a href="/cases?type=orphan" class="footer-link-lux"><%= siteText('footer_orphan_sponsorship') %></a></li>
                    <li><a href="/cases?type=family" class="footer-link-lux"><%= siteText('footer_family_support') %></a></li>
                    <li><a href="/transparency" class="footer-link-lux"><%= siteText('navbar_transparency') %></a></li>
                    <li><a href="/about#faq" class="footer-link-lux"><%= siteText('navbar_faq') %></a></li>
                    <li><a href="/contact" class="footer-link-lux"><%= siteText('navbar_contact') %></a></li>
                </ul>
            </div>

            <div class="footer-col-contact">
                <h4 class="font-cairo footer-heading">
                    <%= siteText('footer_contact_title') %>
                    <div class="footer-heading-line"></div>
                </h4>
                <div class="footer-contact-list">
                    <div class="footer-contact-item">
                        <div class="footer-contact-icon">
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <span class="footer-contact-text"><%= siteText('footer_location') %></span>
                    </div>
                    <div class="footer-contact-item">
                        <div class="footer-contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <span class="footer-contact-text"><%= siteText('contact_email') %></span>
                    </div>
                    <div class="footer-contact-item">
                        <div class="footer-contact-icon">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <a href="<%= siteText('social_whatsapp') %>" class="footer-contact-link"><%= siteText('contact_whatsapp') %></a>
                    </div>
                    <div class="footer-hours-box">
                        <p class="footer-hours-label"><%= siteText('footer_working_hours_title') %></p>
                        <p class="footer-hours-value"><%= siteText('footer_working_hours_val') %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

<%- include('../partials/support-widget') %>
