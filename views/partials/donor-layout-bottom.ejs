        </div><!-- end admin-page-content -->
    </main><!-- end admin-main -->

    <%- include('../partials/support-widget') %>
    
    <!-- Socket.io & Notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Sidebar Toggle for Mobile Improved
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('adminSidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const sidebarClose = document.getElementById('sidebarClose');
        
        const toggleSidebar = () => {
            if (sidebar) sidebar.classList.toggle('active');
            if (sidebarOverlay) sidebarOverlay.classList.toggle('active');
        };

        const closeSidebar = () => {
            if (sidebar) sidebar.classList.remove('active');
            if (sidebarOverlay) sidebarOverlay.classList.remove('active');
        };

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', toggleSidebar);
        }

        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', closeSidebar);
        }

        if (sidebarClose) {
            sidebarClose.addEventListener('click', closeSidebar);
        }

    </script>
    <%- include('./dashboard-table-mobile') %>
    <script>
        const socket = io();
        // Rooms are joined automatically after JWT auth on connect.
    </script>
    <%- include('../partials/realtime-notifications') %>
    
    <% if (locals.success && locals.success.length > 0) { %>
        <script>
            Swal.fire({
                toast: true, position: 'top-end', showConfirmButton: false, timer: 3000,
                icon: 'success', title: '<%= locals.success[0] %>'
            });
        </script>
    <% } %>
    <% if (locals.error && locals.error.length > 0) { %>
        <script>
            Swal.fire({
                toast: true, position: 'top-end', showConfirmButton: false, timer: 4500,
                icon: 'error', title: '<%= locals.error[0] %>'
            });
        </script>
    <% } %>
</body>
