<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= langDir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — <%= __('admin_title_suffix') %></title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Global CSS -->
    <link rel="stylesheet" href="<%= asset('/assets/css/premium.css') %>">
    <link rel="stylesheet" href="<%= asset('/assets/css/dashboard-mobile.css') %>">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body class="admin-layout" data-user-id="<%= locals.user ? user._id : '' %>" data-user-role="<%= locals.user ? user.role : '' %>">
    
    <%- include('./admin-sidebar') %>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <main class="admin-main">
        <header class="admin-top-bar">
            <%
                const adminPath = (typeof currentPath !== 'undefined' ? currentPath : '') || '';
                const adminBackTarget = (typeof backUrl !== 'undefined' && backUrl)
                    ? backUrl
                    : (typeof resolveAdminBackUrl === 'function' ? resolveAdminBackUrl(adminPath) : '/admin/dashboard');
                const showAdminBack = Boolean(adminBackTarget) && !(typeof hideBackButton !== 'undefined' && hideBackButton);
            %>
            <div class="admin-top-bar__leading">
                <button id="sidebarToggle" class="btn-lux btn-lux-outline mobile-sidebar-toggle admin-top-bar__menu-btn" type="button">
                    <i class="fas fa-bars"></i>
                </button>
                <% if (showAdminBack) { %>
                <button
                    type="button"
                    id="adminBackBtn"
                    class="admin-back-btn btn-lux btn-lux-outline"
                    data-target="<%= adminBackTarget %>"
                    title="<%= __('common_back') %>"
                    aria-label="<%= __('common_back') %>"
                >
                    <i class="fas fa-arrow-<%= langDir === 'rtl' ? 'right' : 'left' %>" aria-hidden="true"></i>
                    <span class="admin-back-btn__label"><%= __('common_back') %></span>
                </button>
                <% } %>
                <%
                    const pageIcon = (typeof titleIcon !== 'undefined' && titleIcon)
                        ? titleIcon
                        : (typeof resolveDashboardPageIcon === 'function'
                            ? resolveDashboardPageIcon(adminPath, { user: typeof user !== 'undefined' ? user : null })
                            : null);
                %>
                <h4 class="font-cairo admin-top-bar__title">
                    <% if (pageIcon) { %><i class="<%= pageIcon %> admin-top-bar__title-icon" aria-hidden="true"></i><% } %>
                    <span class="admin-top-bar__title-text"><%= __(title) || title %></span>
                </h4>
            </div>
            
            <div style="display: flex; align-items: center; gap: 20px;">
                <div class="admin-top-bar-date" style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">
                    <i class="far fa-calendar-alt"></i> <%= new Date().toLocaleDateString(lang === 'ar' ? 'ar-EG' : 'en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </div>
                <!-- Notifications -->
                <%- include('./notifications-dropdown', { showAdminNotifManage: true }) %>
            </div>
        </header>

        <div class="admin-page-content">
