<header class="premium-nav" id="premiumNav">
    <a href="/" class="logo-luxury">
        <img src="/logo-senabil-white.png" alt="<%= __('hero_title') %>" class="nav-logo nav-logo--light">
        <img src="/logo-senabil-dark.png" alt="<%= __('hero_title') %>" class="nav-logo nav-logo--dark">
        <span class="logo-text-stack">
            <strong><%= __('hero_title') %></strong>
            <small><%= __('brand_affiliation_short') %></small>
        </span>
    </a>

    <!-- Mobile Menu Toggle & Lang Switcher -->
    <div class="nav-mobile-tools">
        <div class="lang-dropdown-lux mobile-lang-wrapper">
            <button type="button" id="mobileLangToggleBtn" class="nav-icon-btn" aria-label="<%= __('navbar_change_language') %>">
                <i class="fas fa-globe"></i>
            </button>
            <div id="mobileLangMenu" class="nav-lang-menu">
                <a href="/lang/ar" class="<%= locals.currentLocale === 'ar' ? 'is-active' : '' %>">
                    العربية <i class="fas fa-check"></i>
                </a>
                <a href="/lang/en" class="<%= locals.currentLocale === 'en' ? 'is-active' : '' %>">
                    English <i class="fas fa-check"></i>
                </a>
            </div>
        </div>
        <button type="button" class="mobile-menu-toggle nav-icon-btn" id="mobileMenuBtn" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <nav class="nav-links-luxury" id="navLinks">
        <a href="/" class="nav-link-luxury"><%= __('home') %></a>
        <a href="/about" class="nav-link-luxury"><%= __('about_us') %></a>
        <a href="/cases" class="nav-link-luxury"><%= __('cases') %></a>
        <a href="/transparency" class="nav-link-luxury"><%= __('navbar_transparency') %></a>
        <a href="/contact" class="nav-link-luxury"><%= __('navbar_contact') %></a>
        <a href="/about#faq" class="nav-link-luxury"><%= __('navbar_faq') %></a>
        
        <div class="mobile-only-actions">
            <% if (user) { %>
                <a href="/dashboard" class="btn-lux btn-lux-primary"><%= __('dashboard') %></a>
                <a href="/auth/logout" class="btn-lux btn-lux-outline"><%= __('navbar_logout') %></a>
            <% } else { %>
                <a href="/auth/login" class="btn-lux btn-lux-primary nav-login-btn">
                    <i class="fas fa-right-to-bracket"></i> <%= __('navbar_login') %>
                </a>
                <a href="/auth/register" class="btn-lux btn-lux-outline"><%= __('navbar_register') %></a>
            <% } %>
        </div>
    </nav>

    <div class="nav-actions-luxury">
        <% if (user) { %>
            <div class="nav-user-chip">
                <span class="nav-user-name"><%= user.name %></span>
                <a href="/dashboard" class="btn-lux btn-lux-primary btn-sm nav-cta-btn">
                    <i class="fas fa-user-circle"></i> <%= __('dashboard') %>
                </a>
            </div>
            <a href="/auth/logout" class="nav-text-link" title="<%= __('navbar_logout') %>"><i class="fas fa-sign-out-alt"></i></a>
        <% } else { %>
            <a href="/auth/login" class="nav-login-btn">
                <i class="fas fa-right-to-bracket"></i>
                <span><%= __('navbar_login') %></span>
            </a>
            <a href="/auth/register" class="nav-register-btn">
                <%= __('navbar_register') %>
            </a>
        <% } %>

        <div class="lang-dropdown-lux nav-lang-desktop">
            <button type="button" id="langToggleBtn" class="nav-icon-btn" title="<%= __('navbar_change_language') %>">
                <i class="fas fa-globe"></i>
            </button>
            <div id="langMenu" class="nav-lang-menu">
                <a href="/lang/ar" class="<%= locals.currentLocale === 'ar' ? 'is-active' : '' %>">
                    العربية <i class="fas fa-check"></i>
                </a>
                <a href="/lang/en" class="<%= locals.currentLocale === 'en' ? 'is-active' : '' %>">
                    English <i class="fas fa-check"></i>
                </a>
            </div>
        </div>
    </div>
</header>

<script>
(function () {
    const nav = document.getElementById('premiumNav');
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const navLinks = document.getElementById('navLinks');

    function syncNavState() {
        if (!nav) return;
        const hasDarkHero = !!document.querySelector('.nm-about-hero');
        const scrolled = window.scrollY > 24;
        const menuOpen = navLinks?.classList.contains('active');
        // Transparent only over dark hero at top; otherwise solid white (Senabil-style)
        if (!hasDarkHero || scrolled || menuOpen) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    }

    window.addEventListener('scroll', syncNavState, { passive: true });
    window.addEventListener('resize', syncNavState);
    syncNavState();

    mobileMenuBtn?.addEventListener('click', function () {
        navLinks?.classList.toggle('active');
        this.querySelector('i')?.classList.toggle('fa-bars');
        this.querySelector('i')?.classList.toggle('fa-times');
        syncNavState();
    });

    function wireLang(btnId, menuId) {
        const btn = document.getElementById(btnId);
        const menu = document.getElementById(menuId);
        if (!btn || !menu) return;
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = menu.style.display === 'block';
            document.querySelectorAll('.nav-lang-menu').forEach((el) => { el.style.display = 'none'; });
            menu.style.display = open ? 'none' : 'block';
        });
        menu.addEventListener('click', (e) => e.stopPropagation());
    }
    wireLang('langToggleBtn', 'langMenu');
    wireLang('mobileLangToggleBtn', 'mobileLangMenu');
    document.addEventListener('click', () => {
        document.querySelectorAll('.nav-lang-menu').forEach((el) => { el.style.display = 'none'; });
    });
})();
</script>
